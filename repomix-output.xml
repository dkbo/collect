546:         <div className="relative flex items-center bg-white/90 dark:bg-slate-950/90 border border-slate-200 dark:border-slate-800 rounded-xl px-3 py-2 shadow-inner">
547:           <Compass className="h-5 w-5 text-indigo-500 mr-2.5 flex-shrink-0" />
548:           <input
549:             ref={originInputRef}
