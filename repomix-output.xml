 502:         break
 503:       case 'b':
 504:         store.setOpacity('B', store.opacityB === 0 ? 1 : 0)
 505:         break
 506:       case 'm':
 507:         store.setOpacity('M', store.opacityM === 0 ? 1 : 0)
 508:         break
 509:       case 'a':
 510:       case 'arrowleft':
 511:         e.preventDefault()
 512:         store.panMap(panSpeed, 0)
 513:         break
 514:       case 'd':
 515:       case 'arrowright':
 516:         e.preventDefault()
 517:         store.panMap(-panSpeed, 0)
 518:         break
 519:       case 'w':
 520:       case 'arrowup':
 521:         e.preventDefault()
 522:         store.panMap(0, panSpeed)
 523:         break
 524:       case 's':
 525:         if (e.altKey) {
 526:           e.preventDefault()
 527:           store.saveToLocalStorage()
 528:           alert('地圖已成功儲存至本地快取！')
 529:         } else {
 530:           e.preventDefault()
 531:           store.panMap(0, -panSpeed)
 532:         }
 533:         break
 534:       case 'arrowdown':
 535:         e.preventDefault()
 536:         store.panMap(0, -panSpeed)
 537:         break
 538:       case 'delete':
 539:         if (store.mapObjects !== null) {
 540:           store.deleteElement(store.mapObjects, store.objectNum)
 541:         }
