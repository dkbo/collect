 423:   // Handle Drag / Draw Collision
 424:   const handleMapMouseMove = (e: React.MouseEvent<HTMLCanvasElement>) => {
 425:     if (!isDrawingCollision.current) return
 426:     const canvas = selectCanvasRef.current
 427:     if (!canvas) return
 428:     const rect = canvas.getBoundingClientRect()
 429:     const clickX = e.clientX - rect.left
 430:     const clickY = e.clientY - rect.top
 431: 
 432:     const startX = collisionStartCoords.current.x
 433:     const startY = collisionStartCoords.current.y
 434: 
 435:     const drawX = Math.min(startX, clickX)
 436:     const drawY = Math.min(startY, clickY)
 437:     const drawW = Math.abs(clickX - startX)
 438:     const drawH = Math.abs(clickY - startY)
 439: 
 440:     // Render transparent guide block
 441:     const ctx = canvas.getContext('2d')
 442:     if (ctx) {
 443:       drawSelectOutline() // keep standard select outline
 444:       ctx.beginPath()
 445:       ctx.rect(drawX, drawY, drawW, drawH)
 446:       ctx.fillStyle = 'rgba(14, 165, 233, 0.4)'
 447:       ctx.fill()
 448:       ctx.strokeStyle = '#0ea5e9'
 449:       ctx.lineWidth = 1.5
 450:       ctx.stroke()
 451:     }
 452:   }
