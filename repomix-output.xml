 66:                 <Code2 className="h-5 w-5 text-white" />
 67:               </div>
 68:               <h1 className="text-lg font-bold bg-gradient-to-r from-slate-900 via-slate-700 to-slate-500 dark:from-white dark:via-slate-200 dark:to-slate-400 bg-clip-text text-transparent transition-all duration-300 m-0 leading-normal">
 69:                 DKBO&apos;s Collect
 70:               </h1>
 71:             </NavLink>
 72: 
 73:             {/* Desktop Navigation */}
