  4: import { useThemeStore } from '@/store/useThemeStore'
  5: 
  6: const GAME_WIDTH = 800
  7: const GAME_HEIGHT = 450
  8: 
  9: interface GameState {
 10:   x: number
 11:   y: number
 12:   w: number
 13:   h: number
 14:   sp: number
 15:   key: {
 16:     up: boolean
 17:     right: boolean
 18:     down: boolean
 19:     left: boolean
 20:   }
 21:   bow: Array<{ x: number; y: number }>
 22:   wall: Array<{ x: number; y: number; h: number; w: number }>
