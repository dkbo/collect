 293:   // Handle Palette Sprite Click
 294:   const handleSpriteMouseDown = (e: React.MouseEvent<HTMLCanvasElement>) => {
 295:     const canvas = spriteCanvasRef.current
 296:     if (!canvas) return
 297:     const rect = canvas.getBoundingClientRect()
 298:     const clickX = e.clientX - rect.left
 299:     const clickY = e.clientY - rect.top
 300: 
 301:     // Grid coordinates
 302:     const gridX = 32 * Math.floor(clickX / 32)
 303:     const gridY = 32 * Math.floor(clickY / 32)
 304: 
 305:     if (e.button === 0) {
 306:       // Left click: set start or range selection
 307:       if (store.sourceX === false || store.sourceY === false) {
 308:         store.setSpriteSelection(gridX, gridY, 32, 32)
 309:       } else {
 310:         const srcX = store.sourceX
 311:         const srcY = store.sourceY
 312:         let w = store.sourceW
 313:         let h = store.sourceH
 314:         let x = srcX
 315:         let y = srcY
 316: 
 317:         if (gridX >= srcX) {
 318:           w = gridX - srcX + 32
 319:         } else {
 320:           x = gridX
 321:           w = srcX - gridX + 32
 322:         }
 323: 
 324:         if (gridY >= srcY) {
 325:           h = gridY - srcY + 32
 326:         } else {
 327:           y = gridY
 328:           h = srcY - gridY + 32
 329:         }
 330: 
 331:         store.setSpriteSelection(x, y, w, h)
 332:       }
 333:     } else {
 334:       // Right click: reset selection
 335:       store.setSpriteSelection(false, false, 32, 32)
 336:     }
 337:   }
