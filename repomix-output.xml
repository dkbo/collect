 1: import { create } from 'zustand'
 2: import axios from 'axios'
 3: 
 4: export interface GithubRepo {
 5:   name: string
 6:   full_name: string
 7:   html_url: string
 8:   description: string
 9:   stargazers_count: number
10:   forks_count: number
11:   language: string
12: }
13: 
14: // Wikipedia OpenSearch format: [original_keyword, titles[], descriptions[], links[]]
15: export type WikiSearchResponse = [string, string[], string[], string[]]
16: 
17: interface SearchStore {
18:   // State
19:   wikiResults: WikiSearchResponse
20:   githubResults: GithubRepo[]
21:   isLoadingWiki: boolean
22:   isLoadingGithub: boolean
23:   errorWiki: string | null
24:   errorGithub: string | null
25: 
26:   // Actions
27:   searchWiki: (keyword: string) => Promise<void>
28:   searchGithub: (keyword: string) => Promise<void>
29:   clearResults: () => void
30: }
31: 
32: export const useSearchStore = create<SearchStore>((set) => ({
33:   // Initial State
34:   wikiResults: ['', [], [], []],
35:   githubResults: [],
36:   isLoadingWiki: false,
37:   isLoadingGithub: false,
38:   errorWiki: null,
39:   errorGithub: null,
40: 
41:   // Actions
42:   searchWiki: async (keyword: string) => {
43:     if (!keyword.trim()) return
44:     set({ isLoadingWiki: true, errorWiki: null })
45:     try {
46:       const response = await axios.get<WikiSearchResponse>(
47:         `https://zh.wikipedia.org/w/api.php?action=opensearch&limit=10&origin=*&search=${encodeURIComponent(keyword)}`
48:       )
49:       set({ wikiResults: response.data, isLoadingWiki: false })
50:     } catch (err) {
51:       console.error('Wikipedia search error:', err)
52:       set({ 
53:         errorWiki: err instanceof Error ? err.message : 'Wikipedia search failed', 
54:         isLoadingWiki: false 
55:       })
56:     }
57:   },
58: 
59:   searchGithub: async (keyword: string) => {
60:     if (!keyword.trim()) return
61:     set({ isLoadingGithub: true, errorGithub: null })
62:     try {
63:       const response = await axios.get<{ items: GithubRepo[] }>(
64:         `https://api.github.com/search/repositories?q=${encodeURIComponent(keyword)}&sort=stars&order=desc`
65:       )
66:       const topItems = (response.data.items || []).slice(0, 10)
67:       set({ githubResults: topItems, isLoadingGithub: false })
68:     } catch (err) {
69:       console.error('GitHub search error:', err)
70:       set({ 
71:         errorGithub: err instanceof Error ? err.message : 'GitHub search failed', 
72:         isLoadingGithub: false 
73:       })
74:     }
75:   },
76: 
77:   clearResults: () => set({
78:     wikiResults: ['', [], [], []],
79:     githubResults: [],
80:     errorWiki: null,
81:     errorGithub: null,
82:   }),
83: }))
84: 
85: export default useSearchStore
</file>

