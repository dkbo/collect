 221:     ctx.clearRect(0, 0, store.width, store.height)
 222: 
 223:     // Highlight selected item
 224:     if (store.mapObjects === 1) {
 225:       const tile = store.styles[store.objectNum]
 226:       if (tile) {
 227:         ctx.beginPath()
 228:         ctx.rect(tile.l, tile.t, tile.w, tile.h)
 229:         ctx.lineWidth = 2
 230:         ctx.strokeStyle = '#f59e0b' // yellow border for tile
 231:         ctx.setLineDash([4, 4])
 232:         ctx.stroke()
 233:         ctx.setLineDash([])
 234:       }
 235:     } else if (store.mapObjects === 2) {
 236:       const col = store.isMoveArr[store.objectNum]
 237:       if (col) {
 238:         ctx.beginPath()
 239:         ctx.rect(col.x, col.y, col.w, col.h)
 240:         ctx.lineWidth = 2
 241:         ctx.strokeStyle = '#ef4444' // red border for collision
 242:         ctx.setLineDash([4, 4])
 243:         ctx.stroke()
 244:         ctx.setLineDash([])
 245:       }
 246:     }
