<file path="src/pages/Todos/TodoItem.tsx">
  1: import React, { useEffect, useRef } from 'react'
  2: import { Edit, Trash2, CheckCircle2, Circle } from 'lucide-react'
  3: import type { TodoItem as TodoItemType } from '@/store/useTodoStore'
  4: 
  5: interface TodoItemProps {
  6:   object: TodoItemType
  7:   index: number
  8:   filter?: string
  9:   toggleCompleted: (timestamp: number) => void
 10:   toggleEdit: (timestamp: number) => void
 11:   updateTodo: (value: string, timestamp: number) => void
 12:   deleteTodoAsync: (timestamp: number) => void
 13: }
 14: 
 15: export function TodoItem({
 16:   object,
 17:   index,
 18:   filter,
 19:   toggleCompleted,
 20:   toggleEdit,
 21:   updateTodo,
 22:   deleteTodoAsync,
 23: }: TodoItemProps) {
 24:   const editRef = useRef<HTMLInputElement>(null)
 25: 
 26:   useEffect(() => {
 27:     if (object.isEdit && editRef.current) {
 28:       editRef.current.focus()
 29:       // Put cursor at the end of the text
 30:       const length = editRef.current.value.length
 31:       editRef.current.setSelectionRange(length, length)
 32:     }
 33:   }, [object.isEdit])
 34: 
 35:   // Determine if item should be hidden based on the filter
 36:   const isHidden = 
 37:     (filter === 'completed' && !object.completed) ||
 38:     (filter === 'active' && object.completed)
 39: 
 40:   if (isHidden) return null
 41: 
 42:   const handleCompleted = () => {
 43:     if (!object.isEdit) {
 44:       toggleCompleted(object.timestamp)
 45:     }
 46:   }
 47: 
 48:   const handleEditKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
 49:     if (e.key === 'Enter') {
 50:       updateTodo(e.currentTarget.value, object.timestamp)
 51:     } else if (e.key === 'Escape') {
 52:       toggleEdit(object.timestamp)
 53:     }
 54:   }
 55: 
 56:   const handleBlur = (e: React.FocusEvent<HTMLInputElement>) => {
 57:     updateTodo(e.target.value, object.timestamp)
 58:   }
 59: 
 60:   // Calculate classes
 61:   let itemClasses = 'todo-item'
 62:   if (object.completed) {
 63:     itemClasses += ' completed'
 64:   }
 65:   if (object.isLeave) {
 66:     itemClasses += ' leaved'
 67:   }
 68: 
 69:   return (
 70:     <li className={itemClasses} data-testid={`todo-item-${index}`}>
 71:       {/* Complete Checkbox & Text */}
 72:       <div 
 73:         className="flex items-center gap-3 flex-1 select-none py-1"
 74:         onMouseDown={handleCompleted}
 75:       >
 76:         <div className="flex-shrink-0 cursor-pointer text-slate-400 dark:text-slate-500 hover:text-purple-500 dark:hover:text-purple-400 transition-colors duration-200">
 77:           {object.completed ? (
 78:             <CheckCircle2 className="h-5 w-5 text-emerald-500 dark:text-emerald-400 fill-emerald-500/10" />
 79:           ) : (
 80:             <Circle className="h-5 w-5" />
 81:           )}
 82:         </div>
 83:         
 84:         <div className="flex-1 min-w-0 pr-4">
 85:           {object.isEdit ? (
 86:             <input
 87:               ref={editRef}
 88:               className="todo-item-edit-input"
 89:               type="text"
 90:               defaultValue={object.value}
 91:               onBlur={handleBlur}
 92:               onKeyDown={handleEditKeyDown}
 93:               onMouseDown={(e) => e.stopPropagation()}
 94:               data-testid={`todo-edit-input-${index}`}
 95:             />
 96:           ) : (
 97:             <span className={`text-slate-700 dark:text-slate-300 break-words block text-base font-medium transition-all duration-300 ${object.completed ? 'line-through opacity-60' : ''}`}>
 98:               {object.value}
 99:             </span>
100:           )}
101:         </div>
102:       </div>
103: 
104:       {/* Buttons */}
105:       <div className="flex items-center gap-1.5 flex-shrink-0" onMouseDown={(e) => e.stopPropagation()}>
106:         {!object.completed && (
107:           <button
108:             onClick={() => toggleEdit(object.timestamp)}
109:             className="p-2 text-slate-400 dark:text-slate-500 hover:text-purple-500 dark:hover:text-purple-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 rounded-lg transition-all duration-200 cursor-pointer"
110:             aria-label="Edit todo"
111:             data-testid={`todo-edit-btn-${index}`}
112:           >
113:             <Edit className="h-4.5 w-4.5" />
114:           </button>
115:         )}
116:         
117:         <button
118:           onClick={() => deleteTodoAsync(object.timestamp)}
119:           className="p-2 text-slate-400 dark:text-slate-500 hover:text-rose-500 dark:hover:text-rose-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 rounded-lg transition-all duration-200 cursor-pointer"
120:           aria-label="Delete todo"
121:           data-testid={`todo-delete-btn-${index}`}
122:         >
123:           <Trash2 className="h-4.5 w-4.5" />
124:         </button>
125:       </div>
126:     </li>
127:   )
128: }
129: 
130: export default TodoItem
</file>

