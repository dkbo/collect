 646:         <div className="flex items-center gap-3">
 647:           <div className="bg-gradient-to-tr from-purple-500 to-indigo-600 p-2.5 rounded-xl shadow-lg shadow-purple-500/20">
 648:             <Layers className="h-5 w-5 text-white" />
