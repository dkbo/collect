 151:     // Draw background objects (z !== 2)
 152:     store.styles.forEach((tile) => {
 153:       if (tile.z === 2) return
 154:       const sheet = new Image()
 155:       sheet.src = IMAGES[tile.b]
 156:       if (sheet.complete) {
 157:         ctx.drawImage(sheet, tile.x, tile.y, tile.w, tile.h, tile.l, tile.t, tile.w, tile.h)
 158:       } else {
 159:         sheet.onload = () => {
 160:           // Redraw on complete
 161:           drawBackgroundLayer()
 162:         }
 163:       }
 164:     })
