 454:   const handleMapMouseUp = (e: React.MouseEvent<HTMLCanvasElement>) => {
 455:     if (!isDrawingCollision.current) return
 456:     isDrawingCollision.current = false
 457:     const canvas = selectCanvasRef.current
 458:     if (!canvas) return
 459:     const rect = canvas.getBoundingClientRect()
 460:     const clickX = e.clientX - rect.left
 461:     const clickY = e.clientY - rect.top
 462: 
 463:     const startX = collisionStartCoords.current.x
 464:     const startY = collisionStartCoords.current.y
 465: 
 466:     const finalX = Math.min(startX, clickX)
 467:     const finalY = Math.min(startY, clickY)
 468:     const finalW = Math.abs(clickX - startX)
 469:     const finalH = Math.abs(clickY - startY)
 470: 
 471:     if (finalW > 4 && finalH > 4) {
 472:       store.addCollision({
 473:         n: store.objectName || 'Collision Area',
 474:         x: finalX,
 475:         y: finalY,
 476:         w: finalW,
 477:         h: finalH
 478:       })
 479:       setActiveTab('collision')
 480:     }
 481:     drawSelectOutline()
 482:   }
