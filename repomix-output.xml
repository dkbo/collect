 54:       <div className="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-purple-500/5 dark:bg-purple-500/10 blur-[120px] pointer-events-none transition-all duration-300" />
 55:       <div className="absolute bottom-[20%] right-[-10%] w-[40%] h-[40%] rounded-full bg-indigo-500/5 dark:bg-indigo-500/10 blur-[120px] pointer-events-none transition-all duration-300" />
 56: 
 57:       <div className="w-full relative z-10">
 58:         {/* Floating Header */}
