 28: export function MiniGame() {
 29:   const { theme } = useThemeStore()
 30:   const canvasEl = useRef<HTMLCanvasElement>(null)
 31:   const requestRef = useRef<number | null>(null)
 32:   
 33:   const [score, setScore] = useState(0)
 34:   const [hp, setHp] = useState(10)
 35:   const [highScore, setHighScore] = useState(() => {
 36:     const saved = localStorage.getItem('game_highscore')
 37:     return saved ? parseInt(saved, 10) : 0
 38:   })
 39: 
 40:   const canvasContainerRef = useRef<HTMLDivElement>(null)
 41:   const [isFullscreen, setIsFullscreen] = useState(false)
 42: 
 43:   useEffect(() => {
 44:     const handleFullscreenChange = () => {
 45:       setIsFullscreen(document.fullscreenElement === canvasContainerRef.current)
 46:     }
 47:     document.addEventListener('fullscreenchange', handleFullscreenChange)
 48:     return () => {
 49:       document.removeEventListener('fullscreenchange', handleFullscreenChange)
 50:     }
 51:   }, [])
 52: 
 53:   const toggleFullscreen = () => {
 54:     const container = canvasContainerRef.current
 55:     if (!container) return
 56:     if (!document.fullscreenElement) {
 57:       container.requestFullscreen().catch((err) => {
 58:         console.error('Error enabling fullscreen:', err)
 59:       })
 60:     } else {
 61:       document.exitFullscreen()
 62:     }
 63:   }
 64: 
 65:   // Encapsulate mutable state in a single Ref to avoid closures and multi-mount leaks
 66:   const stateRef = useRef<GameState>({
 67:     x: 50,
 68:     y: 200,
 69:     w: 15,
 70:     h: 20,
 71:     sp: 4,
 72:     key: { up: false, right: false, down: false, left: false },
 73:     bow: [],
 74:     wall: [],
 75:     hp: 10,
 76:     score: 0,
 77:     isActive: true
 78:   })
 79: 
 80:   const keydown = (e: KeyboardEvent) => {
 81:     // Prevent default scroll behavior for game control keys
 82:     if ([32, 37, 38, 39, 40].includes(e.keyCode)) {
 83:       e.preventDefault()
 84:     }
 85:     const s = stateRef.current
 86:     switch (e.keyCode) {
 87:       case 32: // Space
 88:         s.bow.push({ x: 15 + s.x, y: s.y + s.w / 2 })
 89:         break
 90:       case 37: // Left
 91:         s.key.left = true
 92:         break
 93:       case 38: // Up
 94:         s.key.up = true
 95:         break
 96:       case 39: // Right
 97:         s.key.right = true
 98:         break
 99:       case 40: // Down
100:         s.key.down = true
101:         break
102:     }
103:   }
104: 
105:   const keyup = (e: KeyboardEvent) => {
106:     if ([37, 38, 39, 40].includes(e.keyCode)) {
107:       e.preventDefault()
108:     }
109:     const s = stateRef.current
110:     switch (e.keyCode) {
111:       case 37:
112:         s.key.left = false
113:         break
114:       case 38:
115:         s.key.up = false
116:         break
117:       case 39:
118:         s.key.right = false
119:         break
120:       case 40:
121:         s.key.down = false
122:         break
123:     }
124:   }
125: 
126:   const random = (min: number, max: number) => 
127:     Math.floor(Math.random() * (max - min + 1)) + min
128: 
129:   const animation = () => {
130:     const canvas = canvasEl.current
131:     if (!canvas) return
132:     const ctx = canvas.getContext('2d')
133:     if (!ctx) return
134: 
135:     const s = stateRef.current
136:     // Stop the loop instantly if component is unmounted / page switched
137:     if (!s.isActive) return
138: 
139:     // Clear Canvas
140:     ctx.clearRect(0, 0, GAME_WIDTH, GAME_HEIGHT)
141: 
142:     // Draw grid background for space retro aesthetic
143:     ctx.strokeStyle = theme === 'dark' ? 'rgba(168, 85, 247, 0.05)' : 'rgba(168, 85, 247, 0.08)'
144:     ctx.lineWidth = 1
145:     const gridSize = 45
146:     for (let i = 0; i < GAME_WIDTH; i += gridSize) {
147:       ctx.beginPath()
148:       ctx.moveTo(i, 0)
149:       ctx.lineTo(i, GAME_HEIGHT)
150:       ctx.stroke()
151:     }
152:     for (let j = 0; j < GAME_HEIGHT; j += gridSize) {
153:       ctx.beginPath()
154:       ctx.moveTo(0, j)
155:       ctx.lineTo(GAME_WIDTH, j)
156:       ctx.stroke()
157:     }
158: 
159:     // Move player based on inputs
160:     if (s.key.up && s.y > 0) s.y = Math.max(0, s.y - s.sp)
161:     if (s.key.down && s.y + s.h < GAME_HEIGHT) s.y = Math.min(GAME_HEIGHT - s.h, s.y + s.sp)
162:     if (s.key.left && s.x > 0) s.x = Math.max(0, s.x - s.sp)
163:     if (s.key.right && s.x + s.w < GAME_WIDTH) s.x = Math.min(GAME_WIDTH - s.w, s.x + s.sp)
164: 
165:     // Draw glowing player spaceship (triangle pointing right)
166:     ctx.fillStyle = '#a855f7' // purple neon
167:     ctx.shadowColor = '#a855f7'
168:     ctx.shadowBlur = 10
169:     ctx.beginPath()
170:     ctx.moveTo(s.x, s.y)
171:     ctx.lineTo(s.x + s.h, s.y + s.w / 2)
172:     ctx.lineTo(s.x, s.y + s.w)
173:     ctx.closePath()
174:     ctx.fill()
175:     ctx.shadowBlur = 0 // reset shadow blur
176: 
177:     // Draw Lasers (Bows)
178:     if (s.bow.length > 0) {
179:       ctx.strokeStyle = '#38bdf8' // neon sky blue
180:       ctx.lineWidth = 3
181:       ctx.shadowColor = '#38bdf8'
182:       ctx.shadowBlur = 8
183: 
184:       for (let i = 0; i < s.bow.length; i++) {
185:         const b = s.bow[i]
186:         b.x += 6 // Laser horizontal speed
187: 
188:         // Offscreen boundary check
189:         if (b.x >= GAME_WIDTH) {
190:           s.bow.splice(i, 1)
191:           i--
192:           continue
193:         }
194: 
195:         // Collision check with enemy walls
196:         if (s.wall.length > 0) {
197:           let hit = false
198:           for (let j = 0; j < s.wall.length; j++) {
199:             const w = s.wall[j]
200:             const checkX = b.x + 12 > w.x
201:             const checkY = b.y >= w.y && b.y <= w.y + w.h
202: 
203:             if (checkX && checkY) {
204:               s.wall.splice(j, 1)
205:               hit = true
206:               break
207:             }
208:           }
209: 
210:           if (hit) {
211:             s.score += 100
212:             setScore(s.score)
213:             if (s.score > highScore) {
214:               setHighScore(s.score)
215:               localStorage.setItem('game_highscore', s.score.toString())
216:             }
217:             s.bow.splice(i, 1)
218:             i--
219:             continue
220:           }
221:         }
222: 
223:         // Render laser
224:         ctx.beginPath()
225:         ctx.moveTo(b.x, b.y)
226:         ctx.lineTo(b.x + 12, b.y)
227:         ctx.stroke()
228:       }
229:       ctx.shadowBlur = 0
230:     }
231: 
232:     // Move & Draw Enemy Obstacles (Walls)
233:     if (s.wall.length > 0) {
234:       ctx.shadowColor = '#f43f5e'
235:       ctx.shadowBlur = 6
236: 
237:       for (let i = 0; i < s.wall.length; i++) {
238:         const w = s.wall[i]
239:         w.x -= 2 // Obstacle movement speed
240: 
241:         // Damage trigger on reaching left boundary
242:         if (w.x < 0) {
243:           s.wall.splice(i, 1)
244:           s.hp -= 1
245:           setHp(s.hp)
246:           if (s.hp <= 0) {
247:             // Exit immediately, do not schedule next animation frame
248:             return
249:           }
250:           i--
251:           continue
252:         }
253: 
254:         // Render obstacle
255:         ctx.strokeStyle = '#f43f5e' // neon rose
256:         ctx.lineWidth = w.w
257:         ctx.beginPath()
258:         ctx.moveTo(w.x, w.y)
259:         ctx.lineTo(w.x, w.y + w.h)
260:         ctx.stroke()
261:       }
262:       ctx.shadowBlur = 0
263:     }
264: 
265:     // Spawn new obstacles randomly
266:     if (random(0, 30) === 0) {
267:       s.wall.push({
268:         x: GAME_WIDTH,
269:         y: random(0, GAME_HEIGHT - 35),
270:         h: random(15, 35),
271:         w: random(4, 8)
272:       })
273:     }
274: 
275:     requestRef.current = requestAnimationFrame(animation)
276:   }
277: 
278:   const startGame = () => {
