 174:     ctx.clearRect(0, 0, store.width, store.height)
 175:     ctx.globalAlpha = store.opacityF
 176: 
 177:     // Draw foreground objects (z === 2)
 178:     store.styles.forEach((tile) => {
 179:       if (tile.z !== 2) return
 180:       const sheet = new Image()
 181:       sheet.src = IMAGES[tile.b]
 182:       if (sheet.complete) {
 183:         ctx.drawImage(sheet, tile.x, tile.y, tile.w, tile.h, tile.l, tile.t, tile.w, tile.h)
 184:       } else {
 185:         sheet.onload = () => {
 186:           drawForegroundLayer()
 187:         }
 188:       }
 189:     })
 190:     ctx.globalAlpha = 1
 191:   }
 192: 
 193:   const drawCollisionLayer = () => {
 194:     const canvas = collisionCanvasRef.current
 195:     if (!canvas) return
 196:     const ctx = canvas.getContext('2d')
 197:     if (!ctx) return
