 1: import { create } from 'zustand'
 2: 
 3: type Theme = 'light' | 'dark'
 4: 
 5: interface ThemeStore {
 6:   theme: Theme
 7:   toggleTheme: () => void
 8:   setTheme: (theme: Theme) => void
 9:   initializeTheme: () => void
10: }
11: 
12: export const useThemeStore = create<ThemeStore>((set, get) => ({
13:   theme: 'dark', // default theme
14: 
15:   toggleTheme: () => {
16:     const nextTheme = get().theme === 'dark' ? 'light' : 'dark'
17:     get().setTheme(nextTheme)
18:   },
19: 
20:   setTheme: (theme: Theme) => {
21:     localStorage.setItem('theme', theme)
22:     
23:     const root = window.document.documentElement
24:     if (theme === 'dark') {
25:       root.classList.add('dark')
26:       root.style.colorScheme = 'dark'
27:     } else {
28:       root.classList.remove('dark')
29:       root.style.colorScheme = 'light'
30:     }
31:     
32:     set({ theme })
33:   },
34: 
35:   initializeTheme: () => {
36:     const savedTheme = localStorage.getItem('theme') as Theme | null
37:     if (savedTheme) {
38:       get().setTheme(savedTheme)
39:     } else {
40:       const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
41:       get().setTheme(prefersDark ? 'dark' : 'light')
42:     }
43:   }
44: }))
