140:     else set({ opacityM: val })
141:   },
142:   
143:   toggleGrid: (axis) => set((state) => {
144:     if (axis === 'X') return { gridX: !state.gridX }
145:     return { gridY: !state.gridY }
146:   }),
147:   
148:   selectSpriteSheet: (sprites) => set({ 
149:     sprites, 
