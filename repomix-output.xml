 14:   { to: '/directions', label: '地圖導覽', end: false, testId: 'nav-directions' },
 15:   { to: '/chat', label: '多人聊天', end: false, testId: 'nav-chat' },
 16:   { to: '/map-developer', label: '地圖開發', end: false, testId: 'nav-map-developer' },
 17: ] as const
 18: 
 19: export function Layout() {
 20:   const { theme, toggleTheme } = useThemeStore()
 21:   const [isScrolled, setIsScrolled] = useState(false)
 22:   const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false)
 23: 
 24:   const handleScroll = useCallback(() => {
 25:     setIsScrolled(window.scrollY > 20)
 26:   }, [])
 27: 
 28:   useEffect(() => {
 29:     window.addEventListener('scroll', handleScroll, { passive: true })
 30:     return () => window.removeEventListener('scroll', handleScroll)
 31:   }, [handleScroll])
 32: 
 33:   // Close mobile menu on route change by listening to clicks
 34:   const closeMobileMenu = useCallback(() => {
 35:     setIsMobileMenuOpen(false)
 36:   }, [])
 37: 
 38:   // Lock body scroll when mobile menu is open
 39:   useEffect(() => {
 40:     if (isMobileMenuOpen) {
 41:       document.body.style.overflow = 'hidden'
 42:     } else {
 43:       document.body.style.overflow = ''
 44:     }
 45:     return () => {
 46:       document.body.style.overflow = ''
 47:     }
 48:   }, [isMobileMenuOpen])
 49: 
