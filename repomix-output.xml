<file path="dkbo.github.io/src/react/components/disqus.jsx">
 1: import React, {Component} from 'react'
 2: 
 3: export default class Disqus extends Component {
 4:   constructor(props) {
 5:     super(props)
 6:   }
 7: 
 8: 	componentDidMount() {
 9:     const script = document.createElement('script')
10:     script.type = 'text/javascript'
11:     script.src = '//dkbo-rpg.disqus.com/embed.js'
12:     script.id = 'disqus'
13:     document.body.appendChild(script);
14:   }
15:   componentWillUnmount() {
16:     const dom = document.getElementById('disqus')
17:     dom.parentNode.removeChild(dom)
18:     const iframes = document.querySelectorAll('iframe');
19:     for (let i = 0; i < iframes.length; i++) {
20:         iframes[i].parentNode.removeChild(iframes[i]);
21:     }
22:   }
23:   render() {
24:     return(
25:       <div>
26:         <div id="disqus_thread"></div>
27:         <noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript" rel="nofollow">comments powered by Disqus.</a></noscript>
28:       </div>
29:     )
30:   }
31: }
</file>

