 249:   const drawGridLines = () => {
 250:     const canvas = gridCanvasRef.current
 251:     if (!canvas) return
 252:     const ctx = canvas.getContext('2d')
 253:     if (!ctx) return
 254: 
 255:     ctx.clearRect(0, 0, store.width, store.height)
 256:     ctx.strokeStyle = 'rgba(148, 163, 184, 0.15)' // slate border grid
 257:     ctx.lineWidth = 0.5
 258: 
 259:     const tileW = 32
 260:     const tileH = 32
 261: 
 262:     // Draw vertical lines
 263:     if (store.gridX) {
 264:       ctx.fillStyle = 'rgba(148, 163, 184, 0.4)'
 265:       ctx.font = '9px monospace'
 266:       ctx.textAlign = 'center'
 267:       for (let x = tileW; x < store.width; x += tileW) {
 268:         ctx.beginPath()
 269:         ctx.moveTo(x, 0)
 270:         ctx.lineTo(x, store.height)
 271:         ctx.stroke()
 272:         // Label x
 273:         ctx.fillText(x.toString(), x, 12)
 274:       }
 275:     }
 276: 
 277:     // Draw horizontal lines
 278:     if (store.gridY) {
 279:       ctx.fillStyle = 'rgba(148, 163, 184, 0.4)'
 280:       ctx.font = '9px monospace'
 281:       ctx.textAlign = 'left'
 282:       for (let y = tileH; y < store.height; y += tileH) {
 283:         ctx.beginPath()
 284:         ctx.moveTo(0, y)
 285:         ctx.lineTo(store.width, y)
 286:         ctx.stroke()
 287:         // Label y
 288:         ctx.fillText(y.toString(), 4, y - 2)
 289:       }
 290:     }
 291:   }
