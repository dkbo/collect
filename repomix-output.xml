 36:           message,
 37:           timestamp: Date.now(),
 38:           lat: latitude,
 39:           lng: longitude,
 40:         })
 41:       },
 42:       (error) => {
 43:         console.warn('Geolocation error:', error)
 44:       }
 45:     )
 46:   }
 47: }
