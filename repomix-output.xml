 547:             store.clearMap()
 548:           }
 549:         }
 550:         break
 551:       case 'l':
 552:         if (e.altKey) {
 553:           e.preventDefault()
 554:           store.loadFromLocalStorage()
 555:         }
 556:         break
 557:     }
 558:   }, [store, showJsonPanel, isFocused])
