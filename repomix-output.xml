<file path="src/lib/useScrollAnimation.ts">
 1: import { useEffect, useRef } from 'react'
 2: 
 3: /**
 4:  * Hook that observes elements with `.animate-on-scroll` class
 5:  * and adds `.is-visible` when they enter the viewport.
 6:  * Respects `prefers-reduced-motion` by making elements visible immediately.
 7:  */
 8: export function useScrollAnimation() {
 9:   const containerRef = useRef<HTMLDivElement>(null)
10: 
11:   useEffect(() => {
12:     const container = containerRef.current
13:     if (!container) return
14: 
15:     // Respect reduced motion preference
16:     const prefersReducedMotion = window.matchMedia(
17:       '(prefers-reduced-motion: reduce)'
18:     ).matches
19: 
20:     if (prefersReducedMotion) {
21:       container.querySelectorAll('.animate-on-scroll').forEach((el) => {
22:         el.classList.add('is-visible')
23:       })
24:       return
25:     }
26: 
27:     const observer = new IntersectionObserver(
28:       (entries) => {
29:         entries.forEach((entry) => {
30:           if (entry.isIntersecting) {
31:             entry.target.classList.add('is-visible')
32:             observer.unobserve(entry.target) // Only animate once
33:           }
34:         })
35:       },
36:       {
37:         threshold: 0.15,
38:         rootMargin: '0px 0px -40px 0px',
39:       }
40:     )
41: 
42:     const elements = container.querySelectorAll('.animate-on-scroll')
43:     elements.forEach((el) => observer.observe(el))
44: 
45:     return () => observer.disconnect()
46:   }, [])
47: 
48:   return containerRef
49: }
50: 
51: export default useScrollAnimation
</file>

