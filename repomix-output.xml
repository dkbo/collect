 1: import { useEffect, useState } from 'react'
 2: 
 3: interface ChartProps {
 4:   color: 'red' | 'blue' | 'green'
 5:   percent: number
 6:   text: string
 7: }
 8: 
 9: function Chart({ color, percent, text }: ChartProps) {
10:   const [animatedPercent, setAnimatedPercent] = useState(0)
11: 
12:   useEffect(() => {
13:     // Stagger animation slightly for a natural progressive load feel
14:     const timer = setTimeout(() => {
15:       setAnimatedPercent(percent)
16:     }, 300)
17:     return () => clearTimeout(timer)
18:   }, [percent])
19: 
20:   const radius = 50
21:   const circumference = 2 * Math.PI * radius
22:   const strokeDashoffset = circumference - (animatedPercent / 100) * circumference
23: 
24:   // Dynamic stroke colors for the three progress categories
25:   const strokeColors = {
26:     red: 'stroke-rose-500 dark:stroke-rose-400',
27:     blue: 'stroke-sky-500 dark:stroke-sky-400',
28:     green: 'stroke-emerald-500 dark:stroke-emerald-400',
29:   }
30: 
31:   const baseColors = {
32:     red: 'bg-rose-500/10 text-rose-600 dark:text-rose-400',
33:     blue: 'bg-sky-500/10 text-sky-600 dark:text-sky-400',
34:     green: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
35:   }
36: 
37:   return (
38:     <div className="flex flex-col items-center p-2 group" role="img" aria-label={`${text} 熟練度 ${percent}%`}>
39:       <div className="relative size-24 sm:size-28 md:size-32 transition-transform duration-300 group-hover:scale-105">
40:         <svg className="size-full -rotate-90" viewBox="0 0 120 120">
41:           {/* Background circle */}
42:           <circle
43:             cx="60"
44:             cy="60"
45:             r={radius}
46:             className="stroke-slate-100 dark:stroke-slate-800/80 fill-none"
47:             strokeWidth="10"
48:           />
49:           {/* Progress circle with smooth transition */}
50:           <circle
51:             cx="60"
52:             cy="60"
53:             r={radius}
54:             className={`fill-none ${strokeColors[color]} transition-[stroke-dashoffset] duration-1000 ease-out`}
55:             strokeWidth="8"
56:             strokeDasharray={circumference}
57:             strokeDashoffset={strokeDashoffset}
58:             strokeLinecap="round"
59:           />
60:         </svg>
61:         {/* Central progress label */}
62:         <div className="absolute inset-0 flex flex-col items-center justify-center">
63:           <span className="text-base sm:text-lg md:text-xl font-extrabold text-slate-800 dark:text-slate-100">
64:             {animatedPercent}%
65:           </span>
66:           <span className={`text-[9px] md:text-[10px] font-bold px-1.5 py-0.5 rounded-full mt-1 border border-current/25 ${baseColors[color]}`}>
67:             {text}
68:           </span>
69:         </div>
70:       </div>
71:     </div>
72:   )
73: }
74: 
75: export function StateSection() {
76:   return (
77:     <section className="resume-card" data-testid="resume-state">
78:       <h2 className="resume-card-header">狀態</h2>
79:       <div className="p-6 md:p-8">
80:         <div className="grid grid-cols-3 gap-2 sm:gap-4 justify-items-center">
81:           <Chart color="red" percent={80} text="HTML" />
82:           <Chart color="blue" percent={60} text="CSS" />
83:           <Chart color="green" percent={90} text="Javascript" />
84:         </div>
85:       </div>
86:     </section>
87:   )
88: }
89: 
90: export default StateSection
</file>

