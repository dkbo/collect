290: /* ═══════════════════════════════════════════════════════
291:    SCROLL-TRIGGERED ANIMATIONS (Motion-Driven Design)
292:    ═══════════════════════════════════════════════════════ */
293: 
294: @keyframes fadeInUp {
295:   from {
296:     opacity: 0;
297:     transform: translateY(32px);
298:   }
299:   to {
300:     opacity: 1;
301:     transform: translateY(0);
302:   }
303: }
304: 
305: @keyframes slideInLeft {
306:   from {
307:     opacity: 0;
308:     transform: translateX(-40px);
309:   }
310:   to {
311:     opacity: 1;
312:     transform: translateX(0);
313:   }
314: }
315: 
316: @keyframes slideInRight {
317:   from {
318:     opacity: 0;
319:     transform: translateX(40px);
320:   }
321:   to {
322:     opacity: 1;
323:     transform: translateX(0);
324:   }
325: }
326: 
327: @keyframes scaleIn {
328:   from {
329:     opacity: 0;
330:     transform: scale(0.92);
331:   }
332:   to {
333:     opacity: 1;
334:     transform: scale(1);
335:   }
336: }
337: 
338: @keyframes shimmer {
339:   0% { background-position: -200% 0; }
340:   100% { background-position: 200% 0; }
341: }
342: 
343: @keyframes floatSlow {
344:   0%, 100% { transform: translateY(0); }
345:   50% { transform: translateY(-12px); }
346: }
347: 
348: @keyframes pulse-glow {
349:   0%, 100% { box-shadow: 0 0 20px rgba(139, 92, 246, 0.15); }
350:   50% { box-shadow: 0 0 40px rgba(139, 92, 246, 0.3); }
351: }
352: 
353: /* Scroll-triggered animation base */
354: .animate-on-scroll {
355:   opacity: 0;
356:   will-change: transform, opacity;
357: }
358: 
359: .animate-on-scroll.is-visible {
360:   animation-fill-mode: both;
361:   animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
362: }
363: 
364: .animate-fade-in-up.is-visible {
365:   animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
366: }
367: 
368: .animate-slide-in-left.is-visible {
369:   animation: slideInLeft 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
370: }
371: 
372: .animate-slide-in-right.is-visible {
373:   animation: slideInRight 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
374: }
375: 
376: .animate-scale-in.is-visible {
377:   animation: scaleIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
378: }
379: 
380: /* Stagger delays */
381: .animate-stagger-1 { animation-delay: 0.1s !important; }
382: .animate-stagger-2 { animation-delay: 0.2s !important; }
383: .animate-stagger-3 { animation-delay: 0.3s !important; }
384: .animate-stagger-4 { animation-delay: 0.4s !important; }
385: .animate-stagger-5 { animation-delay: 0.5s !important; }
386: 
387: /* Respect reduced motion */
388: @media (prefers-reduced-motion: reduce) {
389:   .animate-on-scroll {
390:     opacity: 1;
391:     transform: none;
392:     animation: none !important;
393:     transition: none !important;
394:   }
395: 
396:   .animate-on-scroll.is-visible {
397:     animation: none !important;
398:   }
399: 
400:   *,
401:   *::before,
402:   *::after {
403:     animation-duration: 0.01ms !important;
404:     animation-iteration-count: 1 !important;
405:     transition-duration: 0.01ms !important;
406:   }
407: }
