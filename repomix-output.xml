  1: import React, { useEffect, useRef } from 'react'
  2: import { Edit, Trash2, CheckCircle2, Circle } from 'lucide-react'
  3: import type { TodoItem as TodoItemType } from '@/store/useTodoStore'
  4: 
  5: interface TodoItemProps {
  6:   object: TodoItemType
  7:   index: number
  8:   filter?: string
  9:   toggleCompleted: (timestamp: number) => void
 10:   toggleEdit: (timestamp: number) => void
 11:   updateTodo: (value: string, timestamp: number) => void
 12:   deleteTodoAsync: (timestamp: number) => void
 13: }
 14: 
 15: export function TodoItem({
 16:   object,
 17:   index,
 18:   filter,
 19:   toggleCompleted,
 20:   toggleEdit,
 21:   updateTodo,
 22:   deleteTodoAsync,
 23: }: TodoItemProps) {
 24:   const editRef = useRef<HTMLInputElement>(null)
 25: 
 26:   useEffect(() => {
 27:     if (object.isEdit && editRef.current) {
 28:       editRef.current.focus()
 29:       // Put cursor at the end of the text
 30:       const length = editRef.current.value.length
 31:       editRef.current.setSelectionRange(length, length)
 32:     }
 33:   }, [object.isEdit])
 34: 
 35:   // Determine if item should be hidden based on the filter
 36:   const isHidden = 
 37:     (filter === 'completed' && !object.completed) ||
 38:     (filter === 'active' && object.completed)
 39: 
 40:   if (isHidden) return null
 41: 
 42:   const handleCompleted = () => {
 43:     if (!object.isEdit) {
 44:       toggleCompleted(object.timestamp)
 45:     }
 46:   }
 47: 
 48:   const handleKeyDown = (e: React.KeyboardEvent) => {
 49:     if (e.key === 'Enter' || e.key === ' ') {
 50:       e.preventDefault()
 51:       handleCompleted()
 52:     }
 53:   }
 54: 
 55:   const handleEditKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
 56:     if (e.key === 'Enter') {
 57:       updateTodo(e.currentTarget.value, object.timestamp)
 58:     } else if (e.key === 'Escape') {
 59:       toggleEdit(object.timestamp)
 60:     }
 61:   }
 62: 
 63:   const handleBlur = (e: React.FocusEvent<HTMLInputElement>) => {
 64:     updateTodo(e.target.value, object.timestamp)
 65:   }
 66: 
 67:   // Calculate classes
 68:   let itemClasses = 'todo-item'
 69:   if (object.completed) {
 70:     itemClasses += ' completed'
 71:   }
 72:   if (object.isLeave) {
 73:     itemClasses += ' leaved'
 74:   }
 75: 
 76:   return (
 77:     <li className={itemClasses} data-testid={`todo-item-${index}`}>
 78:       {/* Complete Checkbox & Text */}
 79:       <div 
 80:         className="flex items-center gap-3 flex-1 select-none py-1 focus-visible:ring-2 focus-visible:ring-purple-500 rounded-md outline-none"
 81:         onMouseDown={handleCompleted}
 82:         onKeyDown={handleKeyDown}
 83:         tabIndex={0}
 84:         role="button"
 85:         aria-label={object.completed ? `標記 "${object.value}" 為未完成` : `標記 "${object.value}" 為已完成`}
 86:       >
 87:         <div className="flex-shrink-0 cursor-pointer text-slate-400 dark:text-slate-500 hover:text-purple-500 dark:hover:text-purple-400 transition-colors duration-200">
 88:           {object.completed ? (
 89:             <CheckCircle2 className="h-5 w-5 text-emerald-500 dark:text-emerald-400 fill-emerald-500/10" aria-hidden="true" />
 90:           ) : (
 91:             <Circle className="h-5 w-5" aria-hidden="true" />
 92:           )}
 93:         </div>
 94:         
 95:         <div className="flex-1 min-w-0 pr-4">
 96:           {object.isEdit ? (
 97:             <input
 98:               ref={editRef}
 99:               className="todo-item-edit-input"
100:               type="text"
101:               defaultValue={object.value}
102:               onBlur={handleBlur}
103:               onKeyDown={handleEditKeyDown}
104:               onMouseDown={(e) => e.stopPropagation()}
105:               data-testid={`todo-edit-input-${index}`}
106:               aria-label="編輯待辦事項內容"
107:             />
108:           ) : (
109:             <span 
110:               className={`text-slate-700 dark:text-slate-300 break-words block text-base font-medium transition-all duration-300 cursor-text ${object.completed ? 'line-through opacity-60' : ''}`}
111:               title={object.completed ? undefined : "雙擊以編輯"}
112:               onDoubleClick={(e) => {
113:                 e.stopPropagation()
114:                 if (!object.completed) {
115:                   toggleEdit(object.timestamp)
116:                 }
117:               }}
118:               onMouseDown={(e) => {
119:                 // If double click target is active, we don't want it to toggle completion on single click
120:                 e.stopPropagation()
121:               }}
122:             >
123:               {object.value}
124:             </span>
125:           )}
126:         </div>
127:       </div>
128: 
129:       {/* Buttons */}
130:       <div className="flex items-center gap-1.5 flex-shrink-0" onMouseDown={(e) => e.stopPropagation()}>
131:         {!object.completed && (
132:           <button
133:             onClick={() => toggleEdit(object.timestamp)}
134:             className="p-2 text-slate-400 dark:text-slate-500 hover:text-purple-500 dark:hover:text-purple-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 rounded-lg transition-all duration-200 cursor-pointer focus-visible:ring-2 focus-visible:ring-purple-500 outline-none"
135:             aria-label="編輯待辦事項"
136:             data-testid={`todo-edit-btn-${index}`}
137:           >
138:             <Edit className="h-4.5 w-4.5" aria-hidden="true" />
139:           </button>
140:         )}
141:         
142:         <button
143:           onClick={() => deleteTodoAsync(object.timestamp)}
144:           className="p-2 text-slate-400 dark:text-slate-500 hover:text-rose-500 dark:hover:text-rose-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 rounded-lg transition-all duration-200 cursor-pointer focus-visible:ring-2 focus-visible:ring-purple-500 outline-none"
145:           aria-label="刪除待辦事項"
146:           data-testid={`todo-delete-btn-${index}`}
147:         >
148:           <Trash2 className="h-4.5 w-4.5" aria-hidden="true" />
149:         </button>
150:       </div>
151:     </li>
152:   )
153: }
154: 
155: export default TodoItem
</file>

