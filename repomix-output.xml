317:   // Dialogue check
318:   const handleInteract = () => {
319:     const p = playerRef.current
320:     const id = mapIdRef.current
321:     const nX = 32
322:     const nY = 48
323:     const speed = p.s
324: 
325:     // Detect tile coordinates directly facing the player
326:     let checkOffset = { x: 0, y: 0 }
327:     switch (p.sy) {
328:       case 0: // down
329:         checkOffset = { x: 0, y: speed }
330:         break
331:       case 48: // left
332:         checkOffset = { x: -speed, y: 0 }
333:         break
334:       case 96: // right
335:         checkOffset = { x: speed, y: 0 }
336:         break
337:       case 144: // up
338:         checkOffset = { x: 0, y: -speed }
339:         break
340:     }
341: 
342:     const { x, y } = checkOffset
343:     let npcFound = false
344: 
345:     isMoveObject[id].isMove.forEach((json) => {
346:       const a = p.px + nX + x >= json.x
347:       const b = p.px + x <= json.x + json.w
348:       const c = p.py + nY + y >= json.y
349:       const d = p.py + y <= json.y + json.h
350: 
351:       if (a && b && c && d) {
352:         if (json.e !== undefined && json.e >= 0) {
353:           npcFound = true
354:           const npcJson = messageObject[id][json.e]
355:           if (npcJson && npcJson.text) {
356:             const currentCount = useRpgStore.getState().messageCount
357:             const nextCount = currentCount + 1
358: 
359:             if (nextCount <= npcJson.text.length) {
360:               setNpcChat({
361:                 isChat: true,
362:                 npcName: npcJson.name,
363:                 npcMessage: npcJson.text[nextCount - 1],
364:                 messageCount: nextCount,
365:               })
366:             } else {
367:               closeChat()
368:             }
369:           }
370:         }
371:       }
372:     })
373: 
374:     if (!npcFound) {
375:       if (useRpgStore.getState().isChat) {
376:         closeChat()
377:       }
378:     }
379:   }
380: 
381:   // Game loop tick
382:   const loop = () => {
383:     if (!canvasContainerRef.current) return
384:     if (isTransSenceRef.current) {
385:       // Keep scheduling drawing frames during loading fades
386:       drawGame()
387:       requestRef.current = requestAnimationFrame(loop)
388:       return
389:     }
390: 
391:     const p = playerRef.current
392:     const id = mapIdRef.current
393:     const speed = p.s
394: 
395:     let dx = 0
396:     let dy = 0
397:     let isMovingX = false
398:     let isMovingY = false
399: 
400:     const nX = 32
401:     const nY = 48
402: 
403:     if (p.left && !p.right) {
404:       dx = -speed
405:       p.sy = nY
406:       isMovingX = true
407:     } else if (p.right && !p.left) {
408:       dx = speed
409:       p.sy = nY * 2
410:       isMovingX = true
411:     }
412: 
413:     if (p.up && !p.down) {
414:       dy = -speed
415:       p.sy = nY * 3
416:       isMovingY = true
417:     } else if (p.down && !p.up) {
418:       dy = speed
419:       p.sy = 0
420:       isMovingY = true
421:     }
422: 
423:     if (isMovingX || isMovingY) {
424:       const nextPx = p.px + dx
425:       const nextPy = p.py + dy
426: 
427:       const canMove = (chkX: number, chkY: number) => {
428:         let possible = true
429:         isMoveObject[id].isMove.forEach((json) => {
430:           const a = chkX + nX >= json.x
431:           const b = chkX <= json.x + json.w
432:           const c = chkY + nY >= json.y
433:           const d = chkY <= json.y + json.h
434:           if (a && b && c && d) {
435:             possible = false
436:           }
437:         })
438:         return possible
439:       }
440: 
441:       const checkTransition = (chkX: number, chkY: number) => {
442:         let transitioned = false
443:         isMoveObject[id].isMove.forEach((json) => {
444:           const a = chkX + nX >= json.x
445:           const b = chkX <= json.x + json.w
446:           const c = chkY + nY >= json.y
447:           const d = chkY <= json.y + json.h
448:           if (a && b && c && d) {
449:             if (json.cm !== undefined && json.cm >= 0 && json.cmm !== undefined && json.cmm >= 0) {
450:               transitioned = true
451:               triggerSceneTransition(json.cm, json.cmm)
452:             }
453:           }
454:         })
455:         return transitioned
456:       }
457: 
458:       if (!checkTransition(nextPx, nextPy)) {
459:         if (canMove(nextPx, nextPy)) {
460:           p.px = nextPx
461:           p.py = nextPy
462:         } else if (isMovingX && isMovingY && canMove(nextPx, p.py)) {
463:           p.px = nextPx
464:         } else if (isMovingX && isMovingY && canMove(p.px, nextPy)) {
465:           p.py = nextPy
466:         }
467: 
468:         // Walk frame slices cycle
469:         animationFrameRef.current = (animationFrameRef.current + 1) % nX
470:         p.sx = Math.floor(animationFrameRef.current / (nX / 4)) * nX
471:       }
472: 
473:       if (useRpgStore.getState().isChat) {
474:         closeChat()
475:       }
476:     }
477: 
478:     drawGame()
479:     requestRef.current = requestAnimationFrame(loop)
480:   }
