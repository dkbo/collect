<file path="dkbo.github.io/src/react/components/sence.jsx">
  1: import React, { Component, PropTypes } from 'react'
  2: import { isMoveObject } from '../constants/ismove/'
  3: 
  4: export default class Sence extends Component {
  5: 	constructor(props) {
  6: 		super(props)
  7: 		this.handleResize = ::this.handleResize
  8: 		this.handleTouchStart = ::this.handleTouchStart
  9: 		this.handleTouchMove = ::this.handleTouchMove
 10: 		this.handleTouchEnd = ::this.handleTouchEnd
 11: 	}
 12: 
 13: 	drawSence(props = this.props) {
 14: 		const { width, height } = isMoveObject[props.sence.get('mapId')]['map']
 15: 		const msx = props.sence.get('msx')
 16: 		const msy = props.sence.get('msy')
 17: 		this.sence.clearRect(0, 0, window.innerWidth, window.innerHeight)
 18: 		this.sence.drawImage(this.img, msx, msy, width, height, this.mpx, this.mpy, width, height)
 19: 	}
 20: 	senceChange(props = this.props) {
 21: 		const { width, height } = isMoveObject[props.sence.get('mapId')]['map']
 22: 		this.img.onload = () => {
 23: 			this.mpx = width >= window.innerWidth ? 0 : (window.innerWidth - width) / 2
 24: 			this.mpy = height >= window.innerHeight ? 0 : (window.innerHeight - height) / 2
 25: 			this.drawSence()
 26: 			props.sence.get('isTransSence') ? setTimeout(()=> props.sen({isTransSence: false}), 1000) : null
 27: 		}
 28: 		this.img.src = isMoveObject[props.sence.get('mapId')]['map'][props.senceImg]
 29: 	}
 30: 	handleResize() {
 31: 		this.senceChange()
 32: 	}
 33: 	handleTouchStart(e){
 34: 			e.preventDefault()
 35: 			this.startTouch = this.getTouchPos(e);
 36: 	}
 37: 	//返回觸碰移動時 XY 座標
 38: 	handleTouchMove(e){
 39: 		e.preventDefault();
 40: 			const pos = this.getTouchPos(e);
 41: 			pos.x - this.startTouch.x < -30 ? this.isKeyDown("left") : this.isKeyUp("left")
 42: 			pos.x - this.startTouch.x > 30 ? this.isKeyDown("right") : this.isKeyUp("right")
 43: 			pos.y - this.startTouch.y < -30 ? this.isKeyDown("up") : this.isKeyUp("up")
 44: 			pos.y - this.startTouch.y > 50 ? this.isKeyDown("down") : this.isKeyUp("down")
 45: 	}
 46: 	//處理觸碰結束時事件
 47: 	handleTouchEnd(e){
 48: 		e.preventDefault()
 49: 		this.isKeyUp("left")
 50: 		this.isKeyUp("right")
 51: 		this.isKeyUp("up")
 52: 		this.isKeyUp("down")
 53: 	}
 54: 	isKeyUp(way) {
 55: 			this.props.player[way] ? this.props.way(way, false) : null
 56: 	}
 57: 	isKeyDown(way) {
 58: 			this.props.player[way] ? null : this.props.way(way, true)
 59: 	}
 60: 	getTouchPos(e){
 61: 		return {
 62: 			x: e.changedTouches[0].pageX,
 63: 			y: e.changedTouches[0].pageY,
 64: 		}
 65: 	}
 66: 	shouldComponentUpdate(nextProps) {
 67: 		if(this.props.sence.get('mapId') !== nextProps.sence.get('mapId')) {
 68: 			this.senceChange(nextProps)
 69: 		}
 70: 		return this.props.sence !== nextProps.sence
 71: 	}
 72: 	componentWillMount() {
 73: 		window.addEventListener('resize', this.handleResize)
 74: 	}
 75: 	componentDidUpdate() {
 76: 		this.drawSence()
 77: 	}
 78: 	componentDidMount() {
 79: 		this.canvas = this.refs.sence
 80: 		this.sence = this.canvas.getContext('2d')
 81: 		this.img = new Image()
 82: 		this.senceChange()
 83: 	}
 84: 	componentWillUnmount() {
 85: 		window.removeEventListener('resize', this.handleResize)
 86: 	}
 87: 	render() {
 88: 	    return (
 89: 	      <div>
 90: 	      	<canvas
 91: 						onTouchStart={this.handleTouchStart}
 92: 						onTouchMove={this.handleTouchMove}
 93: 						onTouchEnd={this.handleTouchEnd}
 94: 						className={this.props.sence.get('isTransSence') ? 'x-hide' : null}
 95: 						ref="sence" width={window.innerWidth}
 96: 						height={window.innerHeight} />
 97: 	      </div>
 98: 	    )
 99: 	}
100: }
101: Sence.propTypes = {
102: 	senceImg: PropTypes.string.isRequired,
103: 	sence: PropTypes.object.isRequired,
104: 	sen: PropTypes.func,
105: 	way: PropTypes.func,
106: 	player: PropTypes.object,
107: }
</file>

