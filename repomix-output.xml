  1: import { create } from 'zustand'
  2: 
  3: export interface MapTile {
  4:   n: string   // name
  5:   l: number   // map left X
  6:   t: number   // map top Y
  7:   w: number   // width
  8:   h: number   // height
  9:   b: number   // sprite sheet index (0: NPC, 1: 拼圖一, 2: 拼圖二)
 10:   x: number   // sprite source X
 11:   y: number   // sprite source Y
 12:   z?: number  // layer (2: foreground/front, 0 or undefined: background/back)
 13: }
 14: 
 15: export interface MapCollision {
 16:   n: string    // collision name
 17:   x: number    // map X
 18:   y: number    // map Y
 19:   w: number    // width
 20:   h: number    // height
 21:   e?: number   // event ID
 22:   cm?: number  // teleport map ID
 23:   cmm?: number // teleport map point ID
 24: }
 25: 
 26: interface MapEditorState {
 27:   // Map dimensions
 28:   width: number
 29:   height: number
 30:   
 31:   // Workarea translations
 32:   mapLeft: number
 33:   mapTop: number
 34:   
 35:   // Layer visibility & settings
 36:   opacityF: number // front layer (0 to 1)
 37:   opacityB: number // back layer (0 to 1)
 38:   opacityM: number // collision/move layer (0 to 1)
 39:   gridX: boolean
 40:   gridY: boolean
 41:   
 42:   // Sprite selection source properties
 43:   sprites: number // selected sprite sheet index
 44:   sourceX: number | false
 45:   sourceY: number | false
 46:   sourceW: number
 47:   sourceH: number
 48:   
 49:   // Sprite list scroll position
 50:   spriteScrollTop: number
 51:   
 52:   // Active document data
 53:   styles: MapTile[]
 54:   isMoveArr: MapCollision[]
 55:   npcArr: any[]
 56:   
 57:   // Active editor modes & selections
 58:   mapObjects: 1 | 2 | null // 1 = styles (tiles), 2 = isMove (collision), null = none
 59:   objectNum: number        // index of the selected item in the active array
 60:   objectName: string       // active object name to place
 61:   immediate: boolean       // immediate update drawing flag
 62:   
 63:   // Actions
 64:   setMapSize: (w: number, h: number) => void
 65:   setMapOffset: (left: number, top: number) => void
 66:   panMap: (dx: number, dy: number) => void
 67:   setOpacity: (layer: 'F' | 'B' | 'M', val: number) => void
 68:   toggleGrid: (axis: 'X' | 'Y') => void
 69:   
 70:   selectSpriteSheet: (sheet: number) => void
 71:   setSpriteSelection: (x: number | false, y: number | false, w?: number, h?: number) => void
 72:   setSpriteScrollTop: (top: number) => void
 73:   
 74:   // Element drawing
 75:   addTile: (tile: MapTile) => void
 76:   addCollision: (collision: MapCollision) => void
 77:   deleteElement: (type: 1 | 2, index: number) => void
 78:   selectElement: (type: 1 | 2 | null, index: number) => void
 79:   updateElementProps: (type: 1 | 2, index: number, props: Partial<MapTile> & Partial<MapCollision>) => void
 80:   setObjectName: (name: string) => void
 81:   setImmediate: (val: boolean) => void
 82:   
 83:   // Load / Save JSON
 84:   loadMapJson: (json: any) => boolean
 85:   clearMap: () => void
 86:   saveToLocalStorage: () => void
 87:   loadFromLocalStorage: () => void
 88: }
 89: 
 90: export const useMapEditorStore = create<MapEditorState>((set, get) => ({
 91:   // Map dimensions
 92:   width: 1920,
 93:   height: 1280,
 94:   
 95:   // Workarea translations
 96:   mapLeft: 0,
 97:   mapTop: 0,
 98:   
 99:   // Layer visibility & settings
100:   opacityF: 1,
101:   opacityB: 1,
102:   opacityM: 1,
103:   gridX: false,
104:   gridY: false,
105:   
106:   // Sprite selection source properties
107:   sprites: 1, // Default sprite sheet 1
108:   sourceX: false,
109:   sourceY: false,
110:   sourceW: 32,
111:   sourceH: 32,
112:   
113:   // Sprite list scroll position
114:   spriteScrollTop: 0,
115:   
116:   // Active document data
117:   styles: [],
118:   isMoveArr: [],
119:   npcArr: [],
120:   
121:   // Active editor modes & selections
122:   mapObjects: null,
123:   objectNum: 0,
124:   objectName: '',
125:   immediate: false,
126: 
127:   // Actions
128:   setMapSize: (width, height) => set({ width, height }),
129:   
130:   setMapOffset: (mapLeft, mapTop) => set({ mapLeft, mapTop }),
131:   
132:   panMap: (dx, dy) => set((state) => ({
133:     mapLeft: state.mapLeft + dx,
134:     mapTop: state.mapTop + dy
135:   })),
136:   
137:   setOpacity: (layer, val) => {
138:     if (layer === 'F') set({ opacityF: val })
139:     else if (layer === 'B') set({ opacityB: val })
140:     else set({ opacityM: val })
141:   },
142:   
143:   toggleGrid: (axis) => set((state) => {
144:     if (axis === 'X') return { gridX: !state.gridX }
145:     return { gridY: !state.gridY }
146:   }),
147:   
148:   selectSpriteSheet: (sprites) => set({ 
149:     sprites, 
150:     sourceX: false, 
151:     sourceY: false, 
152:     sourceW: 32, 
153:     sourceH: 32 
154:   }),
155:   
156:   setSpriteSelection: (x, y, w = 32, h = 32) => set({
157:     sourceX: x,
158:     sourceY: y,
159:     sourceW: w,
160:     sourceH: h
161:   }),
162:   
163:   setSpriteScrollTop: (spriteScrollTop) => set({ spriteScrollTop }),
164:   
165:   addTile: (tile) => set((state) => {
166:     const updatedStyles = [...state.styles, tile]
167:     return {
168:       styles: updatedStyles,
169:       mapObjects: 1,
170:       objectNum: updatedStyles.length - 1
171:     }
172:   }),
173:   
174:   addCollision: (collision) => set((state) => {
175:     const updatedCollision = [...state.isMoveArr, collision]
176:     return {
177:       isMoveArr: updatedCollision,
178:       mapObjects: 2,
179:       objectNum: updatedCollision.length - 1
180:     }
181:   }),
182:   
183:   deleteElement: (type, index) => set((state) => {
184:     if (type === 1) {
185:       const copy = [...state.styles]
186:       copy.splice(index, 1)
187:       return {
188:         styles: copy,
189:         mapObjects: null,
190:         objectNum: 0
191:       }
192:     } else {
193:       const copy = [...state.isMoveArr]
194:       copy.splice(index, 1)
195:       return {
196:         isMoveArr: copy,
197:         mapObjects: null,
198:         objectNum: 0
199:       }
200:     }
201:   }),
202:   
203:   selectElement: (type, index) => set({
204:     mapObjects: type,
205:     objectNum: index
206:   }),
207:   
208:   updateElementProps: (type, index, props) => set((state) => {
209:     if (type === 1) {
210:       const copy = [...state.styles]
211:       if (copy[index]) {
212:         copy[index] = { ...copy[index], ...props }
213:       }
214:       return { styles: copy }
215:     } else {
216:       const copy = [...state.isMoveArr]
217:       if (copy[index]) {
218:         copy[index] = { ...copy[index], ...props as any }
219:       }
220:       return { isMoveArr: copy }
221:     }
222:   }),
223:   
224:   setObjectName: (objectName) => set({ objectName }),
225:   
226:   setImmediate: (immediate) => set({ immediate }),
227:   
228:   loadMapJson: (json) => {
229:     if (!json) return false
230:     try {
231:       const mapWidth = json.map?.width || get().width
232:       const mapHeight = json.map?.height || get().height
233:       const styles = Array.isArray(json.styles) ? json.styles : []
234:       const isMoveArr = Array.isArray(json.isMove) ? json.isMove : []
235:       const npcArr = Array.isArray(json.npc) ? json.npc : []
236:       
237:       set({
238:         width: mapWidth,
239:         height: mapHeight,
240:         styles,
241:         isMoveArr,
242:         npcArr,
243:         mapObjects: null,
244:         objectNum: 0
245:       })
246:       return true
247:     } catch (e) {
248:       console.error('Failed to parse loadMapJson', e)
249:       return false
250:     }
251:   },
252:   
253:   clearMap: () => set({
254:     styles: [],
255:     isMoveArr: [],
256:     npcArr: [],
257:     mapObjects: null,
258:     objectNum: 0
259:   }),
260:   
261:   saveToLocalStorage: () => {
262:     const state = get()
263:     const map = {
264:       width: state.width,
265:       height: state.height
266:     }
267:     const json = {
268:       map,
269:       styles: state.styles,
270:       isMove: state.isMoveArr,
271:       npc: state.npcArr
272:     }
273:     localStorage.setItem('dkbo', JSON.stringify(json))
274:     localStorage.setItem('dkbomap', JSON.stringify(map))
275:   },
276:   
277:   loadFromLocalStorage: () => {
278:     try {
279:       const dkbomapStr = localStorage.getItem('dkbomap')
280:       const dkboStr = localStorage.getItem('dkbo')
281:       if (dkbomapStr && dkboStr) {
282:         const map = JSON.parse(dkbomapStr)
283:         const json = JSON.parse(dkboStr)
284:         set({
285:           width: map.width || 1920,
286:           height: map.height || 1280
287:         })
288:         get().loadMapJson(json)
289:       }
290:     } catch (e) {
291:       console.error('Failed to load map from local storage', e)
292:     }
293:   }
294: }))
295: 
296: export default useMapEditorStore
</file>

