<file path="src/store/useAuthStore.ts">
  1: import { create } from 'zustand'
  2: import {
  3:   onAuthStateChanged,
  4:   signInWithPopup,
  5:   signOut,
  6:   GoogleAuthProvider,
  7:   GithubAuthProvider,
  8:   type User,
  9: } from 'firebase/auth'
 10: import { ref, set, onDisconnect } from 'firebase/database'
 11: import { auth, db } from '@/lib/firebase'
 12: 
 13: export interface AuthUser {
 14:   uid: string
 15:   email: string | null
 16:   displayName: string | null
 17:   photoURL: string | null
 18: }
 19: 
 20: interface AuthState {
 21:   /** 目前是否已登入 */
 22:   isLogin: boolean
 23:   /** 登入的使用者資訊 */
 24:   user: AuthUser | null
 25:   /** 初始化載入狀態 */
 26:   loading: boolean
 27:   /** 錯誤訊息 */
 28:   error: string | null
 29: 
 30:   /** 訂閱 Firebase Auth 狀態變化，回傳取消訂閱函數 */
 31:   subscribe: () => () => void
 32:   /** Google 登入 */
 33:   loginWithGoogle: () => Promise<void>
 34:   /** GitHub 登入 */
 35:   loginWithGithub: () => Promise<void>
 36:   /** 登出 */
 37:   logout: () => Promise<void>
 38: }
 39: 
 40: /**
 41:  * 將 Firebase User 序列化為可存放在 store 中的純物件
 42:  */
 43: function serializeUser(user: User): AuthUser {
 44:   return {
 45:     uid: user.uid,
 46:     email: user.email,
 47:     displayName: user.displayName,
 48:     photoURL: user.photoURL,
 49:   }
 50: }
 51: 
 52: /**
 53:  * 將使用者標記為線上，並設定斷線時自動切回離線
 54:  */
 55: function setOnlinePresence(user: AuthUser) {
 56:   const memberRef = ref(db, `members/${user.uid}`)
 57:   const onlineRef = ref(db, `members/${user.uid}/onlineState`)
 58:   set(memberRef, {
 59:     displayName: user.displayName,
 60:     photoURL: user.photoURL,
 61:     onlineState: true,
 62:   })
 63:   onDisconnect(onlineRef).set(false)
 64: }
 65: 
 66: export const useAuthStore = create<AuthState>((set) => ({
 67:   isLogin: false,
 68:   user: null,
 69:   loading: true,
 70:   error: null,
 71: 
 72:   subscribe: () => {
 73:     const unsubscribe = onAuthStateChanged(auth, (firebaseUser) => {
 74:       if (firebaseUser) {
 75:         const user = serializeUser(firebaseUser)
 76:         set({ isLogin: true, user, loading: false, error: null })
 77:         setOnlinePresence(user)
 78:       } else {
 79:         set({ isLogin: false, user: null, loading: false, error: null })
 80:       }
 81:     })
 82:     return unsubscribe
 83:   },
 84: 
 85:   loginWithGoogle: async () => {
 86:     set({ error: null })
 87:     try {
 88:       const provider = new GoogleAuthProvider()
 89:       provider.addScope('profile')
 90:       const result = await signInWithPopup(auth, provider)
 91:       const user = serializeUser(result.user)
 92:       setOnlinePresence(user)
 93:     } catch (err) {
 94:       const message = err instanceof Error ? err.message : '登入失敗'
 95:       set({ error: message })
 96:     }
 97:   },
 98: 
 99:   loginWithGithub: async () => {
100:     set({ error: null })
101:     try {
102:       const provider = new GithubAuthProvider()
103:       const result = await signInWithPopup(auth, provider)
104:       const user = serializeUser(result.user)
105:       setOnlinePresence(user)
106:     } catch (err) {
107:       const message = err instanceof Error ? err.message : '登入失敗'
108:       set({ error: message })
109:     }
110:   },
111: 
112:   logout: async () => {
113:     try {
114:       await signOut(auth)
115:       set({ isLogin: false, user: null })
116:     } catch (err) {
117:       const message = err instanceof Error ? err.message : '登出失敗'
118:       set({ error: message })
119:     }
120:   },
121: }))
122: 
123: export default useAuthStore
</file>

<file path="src/store/useChatStore.ts">
  1: import { create } from 'zustand'
  2: import {
  3:   ref,
  4:   push,
  5:   onValue,
  6:   off,
  7:   serverTimestamp,
  8:   query,
  9:   limitToLast,
 10:   remove,
 11: } from 'firebase/database'
 12: import { db } from '@/lib/firebase'
 13: 
 14: export interface ChatMessage {
 15:   id: string
 16:   uid: string
 17:   displayName: string
 18:   photoURL: string
 19:   message: string
 20:   timestamp: number
 21:   type?: 'youtube' | string
 22: }
 23: 
 24: interface ChatState {
 25:   /** 訊息列表 */
 26:   messages: ChatMessage[]
 27:   /** 是否載入中 */
 28:   loading: boolean
 29:   /** 線上人數 */
 30:   onlineCount: number
 31: 
 32:   /** 訂閱 Firebase messages，回傳取消訂閱函數 */
 33:   subscribe: () => () => void
 34:   /** 發送文字訊息 */
 35:   sendMessage: (text: string, user: { uid: string; displayName: string | null; photoURL: string | null }) => void
 36:   /** 清除全部訊息 */
 37:   clearMessages: () => void
 38: }
 39: 
 40: const YOUTUBE_REGEX = /(?:[?&]v=|\/embed\/|\/1\/|\/v\/|https:\/\/(?:www\.)?youtu\.be\/)([^&\n?#]+)/
 41: const messagesRef = ref(db, 'messages')
 42: const messagesQuery = query(messagesRef, limitToLast(100))
 43: const membersRef = ref(db, 'members')
 44: 
 45: export const useChatStore = create<ChatState>((set) => ({
 46:   messages: [],
 47:   loading: true,
 48:   onlineCount: 0,
 49: 
 50:   subscribe: () => {
 51:     // 訂閱聊天訊息
 52:     const messagesListener = onValue(messagesQuery, (snapshot) => {
 53:       const data = snapshot.val()
 54:       const list: ChatMessage[] = data
 55:         ? Object.entries(data)
 56:             .map(([id, val]) => {
 57:               const v = val as Record<string, unknown>
 58:               return {
 59:                 id,
 60:                 uid: (v.uid as string) || '',
 61:                 displayName: (v.displayName as string) || '匿名',
 62:                 photoURL: (v.photoURL as string) || '',
 63:                 message: (v.message as string) || '',
 64:                 timestamp: (v.timestamp as number) || 0,
 65:                 type: v.type as string | undefined,
 66:               }
 67:             })
 68:             .sort((a, b) => a.timestamp - b.timestamp)
 69:         : []
 70:       set({ messages: list, loading: false })
 71:     })
 72: 
 73:     // 訂閱線上人數
 74:     const membersListener = onValue(membersRef, (snapshot) => {
 75:       const data = snapshot.val()
 76:       if (!data) {
 77:         set({ onlineCount: 0 })
 78:         return
 79:       }
 80:       const count = Object.values(data).filter(
 81:         (m) => (m as Record<string, unknown>).onlineState === true
 82:       ).length
 83:       set({ onlineCount: count })
 84:     })
 85: 
 86:     return () => {
 87:       off(messagesQuery, 'value', messagesListener)
 88:       off(membersRef, 'value', membersListener)
 89:     }
 90:   },
 91: 
 92:   sendMessage: (text, user) => {
 93:     if (!text.trim()) return
 94: 
 95:     const youtubeMatch = text.match(YOUTUBE_REGEX)
 96: 
 97:     const payload: Record<string, unknown> = youtubeMatch
 98:       ? {
 99:           uid: user.uid,
100:           displayName: user.displayName || '匿名',
101:           photoURL: user.photoURL || '',
102:           message: youtubeMatch[1],
103:           type: 'youtube',
104:           timestamp: serverTimestamp(),
105:         }
106:       : {
107:           uid: user.uid,
108:           displayName: user.displayName || '匿名',
109:           photoURL: user.photoURL || '',
110:           message: text.trim(),
111:           timestamp: serverTimestamp(),
112:         }
113: 
114:     push(messagesRef, payload)
115:   },
116: 
117:   clearMessages: () => {
118:     remove(messagesRef)
119:   },
120: }))
121: 
122: export default useChatStore
</file>

<file path="src/store/useDirectionsStore.ts">
 1: import { create } from 'zustand'
 2: 
 3: export interface LatLng {
 4:   lat: number
 5:   lng: number
 6: }
 7: 
 8: interface DirectionsStore {
 9:   origin: string
10:   destination: string
11:   latLng: LatLng | null
12:   
13:   // Actions
14:   setDirections: (origin: string, destination: string, latLng?: LatLng | null) => void
15:   setLatLng: (latLng: LatLng) => void
16:   loadSavedMap: () => void
17: }
18: 
19: const loadInitialState = () => {
20:   const state = {
21:     origin: '',
22:     destination: '',
23:     latLng: null as LatLng | null,
24:   }
25:   
26:   try {
27:     const saved = localStorage.getItem('map')
28:     if (saved) {
29:       const parsed = JSON.parse(saved)
30:       state.destination = parsed.destination || ''
31:     }
32:   } catch (e) {
33:     console.error('Failed to load map state from localStorage', e)
34:   }
35:   
36:   return state
37: }
38: 
39: export const useDirectionsStore = create<DirectionsStore>((set, get) => ({
40:   ...loadInitialState(),
41: 
42:   setDirections: (origin, destination, latLng = null) => {
43:     try {
44:       localStorage.setItem('map', JSON.stringify({ origin, destination }))
45:     } catch (e) {
46:       console.error('Failed to save map state to localStorage', e)
47:     }
48:     set({ origin, destination, latLng: latLng || get().latLng })
49:   },
50: 
51:   setLatLng: (latLng) => set({ latLng }),
52: 
53:   loadSavedMap: () => {
54:     const state = loadInitialState()
55:     set(state)
56:   },
57: }))
58: 
59: export default useDirectionsStore
</file>

<file path="src/store/useMiniChatStore.ts">
 1: import { create } from 'zustand'
 2: import { useChatStore } from './useChatStore'
 3: 
 4: interface MiniChatStore {
 5:   /** 聊天窗口是否展開 */
 6:   isShow: boolean
 7:   /** 未讀訊息數 */
 8:   count: number
 9:   
10:   /** 切換聊天窗口狀態 */
11:   toggleMinichat: () => void
12:   /** 重設計數 */
13:   resetCount: () => void
14:   /** 增加計數 */
15:   incrementCount: () => void
16: }
17: 
18: export const useMiniChatStore = create<MiniChatStore>((set, get) => {
19:   // 記錄上一次的訊息長度，用以計算未讀數
20:   let prevMessagesLength = 0
21: 
22:   // 訂閱 useChatStore 訊息列表的變化
23:   useChatStore.subscribe((state) => {
24:     const currentLength = state.messages.length
25:     
26:     // 如果窗口關閉，且有新的訊息進來，則增加未讀計數
27:     if (!get().isShow && currentLength > prevMessagesLength && prevMessagesLength > 0) {
28:       set({ count: get().count + (currentLength - prevMessagesLength) })
29:     }
30:     
31:     prevMessagesLength = currentLength
32:   })
33: 
34:   return {
35:     isShow: false,
36:     count: 0,
37: 
38:     toggleMinichat: () => {
39:       const nextIsShow = !get().isShow
40:       set({
41:         isShow: nextIsShow,
42:         count: nextIsShow ? 0 : get().count,
43:       })
44:     },
45: 
46:     resetCount: () => set({ count: 0 }),
47:     incrementCount: () => set((state) => ({ count: state.count + 1 })),
48:   }
49: })
50: 
51: export default useMiniChatStore
</file>

