 99:                 data-testid="theme-toggle"
100:               >
101:                 {theme === 'dark' ? (
102:                   <Sun className="h-4 w-4 text-amber-400 fill-amber-400 transition-transform duration-300 hover:rotate-12" />
103:                 ) : (
104:                   <Moon className="h-4 w-4 text-indigo-600 fill-indigo-600 transition-transform duration-300 hover:-rotate-12" />
105:                 )}
106:               </Button>
107:             </div>
108: 
109:             {/* Mobile Controls */}
110:             <div className="flex lg:hidden items-center gap-2">
111:               <Button
112:                 variant="outline"
113:                 size="icon"
114:                 onClick={toggleTheme}
115:                 className="w-9 h-9 rounded-xl border-border bg-background hover:bg-muted text-foreground transition-all duration-200 cursor-pointer shadow-sm flex items-center justify-center"
116:                 aria-label={theme === 'dark' ? '切換至亮色模式' : '切換至暗色模式'}
