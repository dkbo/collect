<file path="src/store/useTodoStore.ts">
  1: import { create } from 'zustand'
  2: 
  3: export interface TodoItem {
  4:   value: string
  5:   isEdit: boolean
  6:   completed: boolean
  7:   isLeave: boolean
  8:   timestamp: number
  9: }
 10: 
 11: interface TodoStore {
 12:   todos: TodoItem[]
 13:   
 14:   // Actions
 15:   addTodo: (value: string) => void
 16:   updateTodo: (value: string, timestamp: number) => void
 17:   toggleEdit: (timestamp: number) => void
 18:   toggleCompleted: (timestamp: number) => void
 19:   
 20:   // Async Deletions (with leave animations)
 21:   deleteTodoAsync: (timestamp: number) => void
 22:   clearCompletedAsync: () => void
 23:   clearAllAsync: () => void
 24: }
 25: 
 26: const loadInitialTodos = (): TodoItem[] => {
 27:   try {
 28:     const saved = localStorage.getItem('todos')
 29:     if (saved) {
 30:       return JSON.parse(saved)
 31:     }
 32:   } catch (e) {
 33:     console.error('Failed to load todos from localStorage', e)
 34:   }
 35:   return [
 36:     {
 37:       value: '大家好我是 dkbo',
 38:       isEdit: false,
 39:       completed: false,
 40:       isLeave: false,
 41:       timestamp: 1487470763624,
 42:     },
 43:   ]
 44: }
 45: 
 46: const saveTodos = (todos: TodoItem[]) => {
 47:   localStorage.setItem('todos', JSON.stringify(todos))
 48: }
 49: 
 50: export const useTodoStore = create<TodoStore>((set, get) => ({
 51:   todos: loadInitialTodos(),
 52: 
 53:   addTodo: (value: string) => {
 54:     const newTodo: TodoItem = {
 55:       value,
 56:       isEdit: false,
 57:       completed: false,
 58:       isLeave: false,
 59:       timestamp: Date.now(),
 60:     }
 61:     const updated = [newTodo, ...get().todos]
 62:     saveTodos(updated)
 63:     set({ todos: updated })
 64:   },
 65: 
 66:   updateTodo: (value: string, timestamp: number) => {
 67:     const updated = get().todos.map((todo) =>
 68:       todo.timestamp === timestamp ? { ...todo, value, isEdit: false } : todo
 69:     )
 70:     saveTodos(updated)
 71:     set({ todos: updated })
 72:   },
 73: 
 74:   toggleEdit: (timestamp: number) => {
 75:     const updated = get().todos.map((todo) =>
 76:       todo.timestamp === timestamp ? { ...todo, isEdit: !todo.isEdit } : todo
 77:     )
 78:     saveTodos(updated)
 79:     set({ todos: updated })
 80:   },
 81: 
 82:   toggleCompleted: (timestamp: number) => {
 83:     const updated = get().todos.map((todo) =>
 84:       todo.timestamp === timestamp ? { ...todo, completed: !todo.completed } : todo
 85:     )
 86:     saveTodos(updated)
 87:     set({ todos: updated })
 88:   },
 89: 
 90:   deleteTodoAsync: (timestamp: number) => {
 91:     // 1. Mark item as leaving
 92:     const updatedLeave = get().todos.map((todo) =>
 93:       todo.timestamp === timestamp ? { ...todo, isLeave: true } : todo
 94:     )
 95:     saveTodos(updatedLeave)
 96:     set({ todos: updatedLeave })
 97: 
 98:     // 2. Actually delete after 500ms animation
 99:     setTimeout(() => {
100:       const updatedDelete = get().todos.filter((todo) => todo.timestamp !== timestamp)
101:       saveTodos(updatedDelete)
102:       set({ todos: updatedDelete })
103:     }, 500)
104:   },
105: 
106:   clearCompletedAsync: () => {
107:     // 1. Mark completed items as leaving
108:     const updatedLeave = get().todos.map((todo) =>
109:       todo.completed ? { ...todo, isLeave: true } : todo
110:     )
111:     saveTodos(updatedLeave)
112:     set({ todos: updatedLeave })
113: 
114:     // 2. Delete completed items after 500ms
115:     setTimeout(() => {
116:       const updatedDelete = get().todos.filter((todo) => !todo.completed)
117:       saveTodos(updatedDelete)
118:       set({ todos: updatedDelete })
119:     }, 500)
120:   },
121: 
122:   clearAllAsync: () => {
123:     // 1. Mark all items as leaving
124:     const updatedLeave = get().todos.map((todo) => ({ ...todo, isLeave: true }))
125:     saveTodos(updatedLeave)
126:     set({ todos: updatedLeave })
127: 
128:     // 2. Delete all items after 500ms
129:     setTimeout(() => {
130:       saveTodos([])
131:       set({ todos: [] })
132:     }, 500)
133:   },
134: }))
135: 
136: export default useTodoStore
</file>

