105:       if (this.div) {
106:         const imgWrapper = this.div.querySelector('.geoImg')
107:         if (imgWrapper) {
108:           imgWrapper.removeEventListener('click', this.toggleDialog)
109:         }
110:         if (this.div.parentNode) {
111:           this.div.parentNode.removeChild(this.div)
112:         }
113:         this.div = null
114:       }
115:     }
