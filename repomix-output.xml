 20: 
 21: interface PlayerRefState {
 22:   px: number
 23:   py: number
 24:   sx: number
 25:   sy: number
 26:   s: number
 27:   left: boolean
 28:   right: boolean
 29:   up: boolean
 30:   down: boolean
 31: }
 32: 
 33: export function RpgRoom() {
 34:   const {
 35:     mapId,
 36:     isTransSence,
 37:     isChat,
 38:     npcName,
 39:     npcMessage,
 40:     setTransSence,
 41:     setMap,
 42:     setNpcChat,
 43:     closeChat,
 44:     resetRpg,
 45:   } = useRpgStore()
 46: 
 47:   const [showInstructions, setShowInstructions] = useState(false)
 48:   const [imagesLoaded, setImagesLoaded] = useState(false)
 49: 
 50:   // Canvas refs
 51:   const canvasContainerRef = useRef<HTMLDivElement>(null)
 52:   const bgCanvasRef = useRef<HTMLCanvasElement>(null)
 53:   const playerCanvasRef = useRef<HTMLCanvasElement>(null)
 54:   const fgCanvasRef = useRef<HTMLCanvasElement>(null)
 55: 
 56:   const [isFullscreen, setIsFullscreen] = useState(false)
 57: 
 58:   // Animation and state refs
 59:   const requestRef = useRef<number | null>(null)
 60:   const animationFrameRef = useRef<number>(0)
 61:   const isTransSenceRef = useRef<boolean>(true)
 62:   const mapIdRef = useRef<number>(0)
 63: 
 64:   // Assets refs
 65:   const playerImageRef = useRef<HTMLImageElement | null>(null)
 66:   const bgImageRef = useRef<HTMLImageElement | null>(null)
 67:   const fgImageRef = useRef<HTMLImageElement | null>(null)
 68: 
 69:   // Player position and keys
 70:   const playerRef = useRef<PlayerRefState>({
 71:     px: 1000,
 72:     py: 600,
 73:     sx: 0,
 74:     sy: 0,
 75:     s: 4,
 76:     left: false,
 77:     right: false,
 78:     up: false,
 79:     down: false,
 80:   })
 81: 
 82:   // Camera follow logic
 83:   const updateCamera = (
 84:     px: number,
 85:     py: number,
 86:     id: number,
 87:     w: number,
 88:     h: number
 89:   ) => {
 90:     const mapConfig = isMoveObject[id].map
 91:     const senceWidth = mapConfig.width
 92:     const senceHeight = mapConfig.height
 93: 
 94:     const nX = 32
 95:     const nY = 48
 96: 
 97:     // Camera bounding padding (middle 50% of the viewport)
 98:     const mh = h / 4
 99:     const mw = w / 4
100:     const mDw = Math.floor((h / 2) + (mh - nY)) - (Math.floor((h / 2) + (mh - nY)) % 4)
101:     const mRf = Math.floor((w / 2) + (mw - nX)) - (Math.floor((w / 2) + (mw - nX)) % 4)
102: 
103:     let msx: number
104:     if (w > senceWidth || px <= mRf) {
105:       msx = 0
106:     } else if (px >= senceWidth - nX || (px - mRf) > (senceWidth - w)) {
107:       msx = senceWidth - w
108:     } else {
109:       msx = px - mRf
110:     }
111: 
112:     let msy: number
113:     if (h > senceHeight || py <= mDw) {
114:       msy = 0
115:     } else if (py >= senceHeight - nY || (py - mDw) > (senceHeight - h)) {
116:       msy = senceHeight - h
117:     } else {
118:       msy = py - mDw
119:     }
120: 
121:     let spx: number
122:     if (w > senceWidth) {
123:       spx = px + ((w - senceWidth) / 2)
124:     } else if (px <= mRf) {
125:       spx = px
126:     } else if (px >= senceWidth - nX || (px - mRf) > (senceWidth - w)) {
127:       spx = px - msx
128:     } else {
129:       spx = mRf
130:     }
131: 
132:     let spy: number
133:     if (h > senceHeight) {
134:       spy = py + ((h - senceHeight) / 2)
135:     } else if (py <= mDw) {
136:       spy = py
137:     } else if (py >= senceHeight - nY || (py - mDw) > (senceHeight - h)) {
138:       spy = py - msy
139:     } else {
140:       spy = mDw
141:     }
142: 
143:     return { msx, msy, spx, spy }
144:   }
145: 
146: 
147:   // Preloading map graphics
148:   const loadMapImages = (id: number): Promise<void> => {
149:     return new Promise((resolve) => {
150:       let loadedCount = 0
151:       const checkResolve = () => {
152:         loadedCount++
153:         if (loadedCount === 2) {
154:           resolve()
155:         }
156:       }
157: 
158:       const bgImg = new Image()
159:       bgImg.onload = checkResolve
160:       bgImg.onerror = checkResolve
161:       bgImg.src = isMoveObject[id].map.second
162:       bgImageRef.current = bgImg
163: 
164:       const fgImg = new Image()
165:       fgImg.onload = checkResolve
166:       fgImg.onerror = checkResolve
167:       fgImg.src = isMoveObject[id].map.first
168:       fgImageRef.current = fgImg
169:     })
170:   }
171: 
172:   // Draw cycle
173:   const drawGame = useCallback(() => {
174:     const container = canvasContainerRef.current
175:     if (!container) return
176: 
177:     const bgCanvas = bgCanvasRef.current
178:     const playerCanvas = playerCanvasRef.current
179:     const fgCanvas = fgCanvasRef.current
180: 
181:     if (!bgCanvas || !playerCanvas || !fgCanvas) return
182: 
183:     const bgCtx = bgCanvas.getContext('2d')
184:     const playerCtx = playerCanvas.getContext('2d')
185:     const fgCtx = fgCanvas.getContext('2d')
186: 
187:     if (!bgCtx || !playerCtx || !fgCtx) return
188: 
189:     const w = container.clientWidth
190:     const h = container.clientHeight
191: 
192:     // Keep resolutions matched to layout client pixels
193:     if (bgCanvas.width !== w || bgCanvas.height !== h) {
194:       bgCanvas.width = w
195:       bgCanvas.height = h
196:       playerCanvas.width = w
197:       playerCanvas.height = h
198:       fgCanvas.width = w
199:       fgCanvas.height = h
200:     }
201: 
202:     const p = playerRef.current
203:     const id = mapIdRef.current
204:     const mapConfig = isMoveObject[id].map
205: 
206:     const { msx, msy, spx, spy } = updateCamera(p.px, p.py, id, w, h)
207: 
208:     // Clear frames
209:     bgCtx.clearRect(0, 0, w, h)
210:     playerCtx.clearRect(0, 0, w, h)
211:     fgCtx.clearRect(0, 0, w, h)
212: 
213:     // Render background map layer
214:     if (bgImageRef.current && bgImageRef.current.complete) {
215:       const sWidth = Math.min(w, mapConfig.width)
216:       const sHeight = Math.min(h, mapConfig.height)
217:       const dx = w > mapConfig.width ? (w - mapConfig.width) / 2 : 0
218:       const dy = h > mapConfig.height ? (h - mapConfig.height) / 2 : 0
219: 
220:       bgCtx.drawImage(
221:         bgImageRef.current,
222:         msx,
223:         msy,
224:         sWidth,
225:         sHeight,
226:         dx,
227:         dy,
228:         sWidth,
229:         sHeight
230:       )
231:     }
232: 
233:     // Render player
234:     if (playerImageRef.current && playerImageRef.current.complete) {
235:       const nX = 32
236:       const nY = 48
237:       playerCtx.drawImage(
238:         playerImageRef.current,
239:         p.sx,
240:         p.sy,
241:         nX,
242:         nY,
243:         spx,
244:         spy,
245:         nX,
246:         nY
247:       )
248:     }
249: 
250:     // Render foreground overlay layer
251:     if (fgImageRef.current && fgImageRef.current.complete) {
252:       const sWidth = Math.min(w, mapConfig.width)
253:       const sHeight = Math.min(h, mapConfig.height)
254:       const dx = w > mapConfig.width ? (w - mapConfig.width) / 2 : 0
