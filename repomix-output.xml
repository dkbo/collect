 339:   // Handle Workspace Map Click
 340:   const handleMapMouseDown = (e: React.MouseEvent<HTMLCanvasElement>) => {
 341:     const canvas = selectCanvasRef.current
 342:     if (!canvas) return
 343:     const rect = canvas.getBoundingClientRect()
 344:     const clickX = e.clientX - rect.left
 345:     const clickY = e.clientY - rect.top
 346: 
 347:     // Aligned to 32px
 348:     const gridX = 32 * Math.floor(clickX / 32)
 349:     const gridY = 32 * Math.floor(clickY / 32)
 350: 
 351:     if (store.sourceX !== false && store.sourceY !== false) {
 352:       // We have active tile selection: DRAW on grid!
 353:       const isForeground = e.button === 2 // Right click draws foreground
 354:       store.addTile({
 355:         n: store.objectName || 'Unamed Tile',
 356:         l: gridX,
 357:         t: gridY,
 358:         w: store.sourceW,
 359:         h: store.sourceH,
 360:         b: store.sprites,
 361:         x: store.sourceX,
 362:         y: store.sourceY,
 363:         z: isForeground ? 2 : undefined
 364:       })
 365:     } else {
 366:       // No active tile selected: select or start collision box
 367:       const isAltPressed = e.altKey
 368:       
 369:       if (isAltPressed) {
 370:         // Start drawing collision box
 371:         if (e.button === 0) {
 372:           isDrawingCollision.current = true
 373:           collisionStartCoords.current = { x: clickX, y: clickY }
 374:           
 375:           // Selection context
 376:           const ctx = canvas.getContext('2d')
 377:           if (ctx) {
 378:             ctx.clearRect(0, 0, store.width, store.height)
 379:           }
 380:         }
 381:       } else {
 382:         // Selection detection
 383:         let clickedIdx = -1
 384:         
 385:         if (e.button === 0) {
 386:           // Left click selects styles
 387:           store.styles.forEach((tile, index) => {
 388:             if (
 389:               clickX >= tile.l && clickX <= tile.l + tile.w &&
 390:               clickY >= tile.t && clickY <= tile.t + tile.h
 391:             ) {
 392:               clickedIdx = index
 393:             }
 394:           })
 395:           if (clickedIdx !== -1) {
 396:             store.selectElement(1, clickedIdx)
 397:             setActiveTab('tile')
 398:           } else {
 399:             store.selectElement(null, 0)
 400:           }
 401:         } else if (e.button === 2) {
 402:           // Right click selects collisions
 403:           e.preventDefault()
 404:           store.isMoveArr.forEach((col, index) => {
 405:             if (
 406:               clickX >= col.x && clickX <= col.x + col.w &&
 407:               clickY >= col.y && clickY <= col.y + col.h
 408:             ) {
 409:               clickedIdx = index
 410:             }
 411:           })
 412:           if (clickedIdx !== -1) {
 413:             store.selectElement(2, clickedIdx)
 414:             setActiveTab('collision')
 415:           } else {
 416:             store.selectElement(null, 0)
 417:           }
 418:         }
 419:       }
 420:     }
 421:   }
