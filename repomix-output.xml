454:     if (isMovingX || isMovingY) {
455:       const nextPx = p.px + dx
456:       const nextPy = p.py + dy
457: 
458:       const canMove = (chkX: number, chkY: number) => {
459:         let possible = true
460:         isMoveObject[id].isMove.forEach((json) => {
461:           const a = chkX + nX >= json.x
462:           const b = chkX <= json.x + json.w
463:           const c = chkY + nY >= json.y
464:           const d = chkY <= json.y + json.h
