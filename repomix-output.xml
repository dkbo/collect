 127:   const drawBackgroundLayer = () => {
 128:     const canvas = backCanvasRef.current
 129:     if (!canvas) return
 130:     const ctx = canvas.getContext('2d')
 131:     if (!ctx) return
 132: 
 133:     ctx.clearRect(0, 0, store.width, store.height)
 134:     ctx.globalAlpha = store.opacityB
 135: 
 136:     // Draw grid grass repeating tiles
 137:     const bgTile = new Image()
 138:     bgTile.src = bgImg
 139:     if (bgTile.complete) {
 140:       const tileW = 32
 141:       const tileH = 32
 142:       const cols = Math.ceil(store.width / tileW)
 143:       const rows = Math.ceil(store.height / tileH)
 144:       for (let c = 0; c < cols; c++) {
 145:         for (let r = 0; r < rows; r++) {
 146:           ctx.drawImage(bgTile, 0, 0, 32, 32, c * tileW, r * tileH, tileW, tileH)
 147:         }
 148:       }
 149:     }
