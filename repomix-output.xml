 183:         ctx.drawImage(sheet, tile.x, tile.y, tile.w, tile.h, tile.l, tile.t, tile.w, tile.h)
 184:       } else {
 185:         sheet.onload = () => {
 186:           drawForegroundLayer()
 187:         }
 188:       }
 189:     })
 190:     ctx.globalAlpha = 1
 191:   }
