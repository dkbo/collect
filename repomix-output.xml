 249:   const drawGridLines = () => {
 250:     const canvas = gridCanvasRef.current
 251:     if (!canvas) return
 252:     const ctx = canvas.getContext('2d')
 253:     if (!ctx) return
 254: 
 255:     ctx.clearRect(0, 0, store.width, store.height)
 256:     ctx.strokeStyle = 'rgba(148, 163, 184, 0.15)' // slate border grid
