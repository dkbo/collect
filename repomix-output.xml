280: 
281:   // Load Google Maps Script
282:   useEffect(() => {
283:     loadGoogleMapsScript(() => {
284:       setIsMapLoaded(true)
285:     })
286:   }, [])
287: 
288:   // Dynamic Theme Synchronization for Google Maps
289:   useEffect(() => {
290:     if (googleMapInstanceRef.current && isMapLoaded) {
291:       googleMapInstanceRef.current.setOptions({
292:         styles: theme === 'dark' ? darkMapStyles : lightMapStyles,
293:       })
294:     }
295:   }, [theme, isMapLoaded])
296: 
297:   // Geocoding and default location logic (getCurrentPosition)
298:   const resolveCurrentLocation = (google: any): Promise<{ address: string; pos: LatLng }> => {
299:     return new Promise((resolve) => {
300:       const geocoder = new google.maps.Geocoder()
301:       
302:       const successCallback = (position: GeolocationPosition) => {
303:         const lat = position.coords.latitude
304:         const lng = position.coords.longitude
305:         const pos = { lat, lng }
306:         
307:         geocoder.geocode({ location: pos }, (results: any, status: string) => {
308:           if (status === 'OK' && results[0]) {
309:             resolve({ address: results[0].formatted_address, pos })
310:           } else {
311:             resolve({ address: `${lat.toFixed(4)}, ${lng.toFixed(4)}`, pos })
312:           }
313:         })
314:       }
315: 
316:       const errorCallback = () => {
317:         // Fallback to Taoyuan default coordinate
318:         const pos = { lat: 24.962, lng: 121.218 }
319:         geocoder.geocode({ location: pos }, (results: any, status: string) => {
320:           if (status === 'OK' && results[0]) {
321:             resolve({ address: results[0].formatted_address, pos })
322:           } else {
323:             resolve({ address: '桃園中壢', pos })
324:           }
325:         })
326:       }
327: 
328:       if (navigator.geolocation) {
329:         navigator.geolocation.getCurrentPosition(successCallback, errorCallback, {
330:           timeout: 5000,
331:         })
332:       } else {
333:         errorCallback()
334:       }
335:     })
336:   }
337: 
338:   // Initialize Map
339:   useEffect(() => {
340:     if (!isMapLoaded || !mapRef.current) return
341:     const google = (window as any).google
342: 
343:     const mapOptions = {
344:       zoom: 15,
345:       mapTypeId: google.maps.MapTypeId.ROADMAP,
346:       styles: theme === 'dark' ? darkMapStyles : lightMapStyles,
347:     }
348: 
349:     const map = new google.maps.Map(mapRef.current, mapOptions)
350:     googleMapInstanceRef.current = map
351: 
352:     const directionsService = new google.maps.DirectionsService()
353:     const directionsDisplay = new google.maps.DirectionsRenderer()
354:     directionsDisplay.setMap(map)
355:     if (panelRef.current) {
356:       directionsDisplay.setPanel(panelRef.current)
357:     }
358: 
359:     directionsServiceRef.current = directionsService
360:     directionsDisplayRef.current = directionsDisplay
361: 
362:     // Auto-resolve initial location if origin is blank
363:     if (!origin) {
364:       resolveCurrentLocation(google).then(({ address, pos }) => {
365:         setLatLng(pos)
366:         setDirections(address, destination, pos)
367:       })
368:     } else {
369:       // If we already have coordinates from store
370:       if (latLng) {
371:         map.setCenter(latLng)
372:       }
373:     }
374: 
375:     // Set search box auto-completes
376:     if (originInputRef.current && destInputRef.current) {
377:       const originBox = new google.maps.places.SearchBox(originInputRef.current)
378:       const destBox = new google.maps.places.SearchBox(destInputRef.current)
379: 
380:       originBox.addListener('places_changed', () => {
381:         const places = originBox.getPlaces()
382:         if (places && places[0]) {
383:           const address = places[0].formatted_address || places[0].name || ''
384:           const location = places[0].geometry.location
385:           const pos = { lat: location.lat(), lng: location.lng() }
386:           setDirections(address, destination, pos)
387:         }
388:       })
389: 
390:       destBox.addListener('places_changed', () => {
391:         const places = destBox.getPlaces()
392:         if (places && places[0]) {
393:           const address = places[0].formatted_address || places[0].name || ''
394:           setDirections(origin, address)
395:         }
396:       })
397:     }
398:     // eslint-disable-next-line react-hooks/exhaustive-deps
399:   }, [isMapLoaded])
400: 
401:   // Calculate Routes and markers
402:   const calculateRoute = useCallback(() => {
403:     if (!isMapLoaded || !googleMapInstanceRef.current) return
404:     const google = (window as any).google
405:     const map = googleMapInstanceRef.current
406: 
407:     // Clear old markers
408:     markersRef.current.forEach((marker) => marker.setMap(null))
409:     markersRef.current = []
410: 
411:     // Clear old custom overlays
412:     Object.keys(overlayMarkersRef.current).forEach((key) => {
413:       overlayMarkersRef.current[key].setMap(null)
414:     })
415:     overlayMarkersRef.current = {}
416: 
417:     if (origin && destination) {
418:       // Route Planning Mode
419:       const request = {
420:         origin,
421:         destination,
422:         travelMode: google.maps.TravelMode.DRIVING,
423:       }
424: 
425:       directionsServiceRef.current.route(request, (response: any, status: string) => {
426:         if (status === google.maps.DirectionsStatus.OK) {
427:           directionsDisplayRef.current.setDirections(response)
428:           setShowPanel(true)
429:           setErrorMessage(null)
430:         } else {
431:           setErrorMessage('無法規劃此路線，請確認地址是否正確。')
432:           setShowPanel(false)
433:         }
434:       })
435:     } else if (latLng) {
436:       // Single Point Marker Mode (Centering on initial location or custom origin)
437:       setTimeout(() => {
438:         setShowPanel(false)
439:         setErrorMessage(null)
440:       }, 0)
441:       directionsDisplayRef.current.set('directions', null)
442:       
443:       const googleLatLng = new google.maps.LatLng(latLng.lat, latLng.lng)
444:       map.setCenter(googleLatLng)
445:       map.setZoom(16)
446: 
447:       const marker = new google.maps.Marker({
448:         map,
449:         position: googleLatLng,
450:         animation: google.maps.Animation.DROP,
451:         title: origin || '您在此處',
452:       })
453:       markersRef.current.push(marker)
454: 
455:       const infoWindow = new google.maps.InfoWindow({
456:         content: `<div class="p-2 font-medium text-slate-800 text-xs">${origin || '我的位置'}</div>`,
457:       })
458:       infoWindow.open(map, marker)
459: 
460:       // Render Simulated player overlays near this location
461:       const CustomOverlay = getCustomOverlayClass(google)
462:       simulatedPlayers.forEach((player) => {
463:         const playerLatLng = new google.maps.LatLng(
464:           latLng.lat + player.latOffset,
465:           latLng.lng + player.lngOffset
466:         )
467:         const bounds = new google.maps.LatLngBounds(playerLatLng)
468:         
469:         const overlay = new CustomOverlay(
470:           bounds,
471:           player.photoURL,
472:           player.message,
473:           map
474:         )
475:         overlayMarkersRef.current[player.uid] = overlay
476:       })
477:     }
478:   }, [origin, destination, latLng, isMapLoaded])
479: 
480:   // Recalculate whenever inputs or coordinates update
481:   useEffect(() => {
482:     if (isMapLoaded) {
483:       calculateRoute()
484:     }
485:   }, [calculateRoute, isMapLoaded])
486: 
487:   // Trigger search on inputs change with debounce
488:   const [localOrigin, setLocalOrigin] = useState(origin)
489:   const [localDest, setLocalDest] = useState(destination)
490: 
491:   useEffect(() => {
492:     const timer = setTimeout(() => {
493:       setLocalOrigin(origin)
494:     }, 0)
495:     return () => clearTimeout(timer)
496:   }, [origin])
497: 
498:   useEffect(() => {
499:     const timer = setTimeout(() => {
500:       setLocalDest(destination)
501:     }, 0)
502:     return () => clearTimeout(timer)
503:   }, [destination])
504: 
505:   // Handle enter key searches
506:   const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>, isOrigin: boolean) => {
507:     if (e.key === 'Enter') {
508:       const google = (window as any).google
509:       if (!google) return
510: 
511:       const geocoder = new google.maps.Geocoder()
512:       const val = isOrigin ? localOrigin : localDest
513:       
514:       if (!val.trim()) return
515: 
516:       geocoder.geocode({ address: val }, (results: any, status: string) => {
517:         if (status === 'OK' && results[0]) {
518:           const pos = {
519:             lat: results[0].geometry.location.lat(),
520:             lng: results[0].geometry.location.lng(),
521:           }
522:           if (isOrigin) {
523:             setLatLng(pos)
