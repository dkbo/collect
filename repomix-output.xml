 60:           <img src="${this.image}" class="w-full h-full rounded-full object-cover" alt="User" />
 61:         </div>
 62:       `
 63:       const div = document.createElement('div')
 64:       div.className = 'absolute z-40'
 65:       div.innerHTML = innerHTML
 66: 
 67:       this.div = div
 68:       this.dialog = div.querySelector('.geoDialog')
 69:       this.img = div.querySelector('.geoImg img')
 70: 
 71:       const imgWrapper = div.querySelector('.geoImg')
 72:       if (imgWrapper) {
 73:         imgWrapper.addEventListener('click', this.toggleDialog, false)
 74:       }
 75: 
 76:       const panes = this.getPanes()
 77:       panes.overlayImage.appendChild(div)
 78:     }
 79: 
 80:     toggleDialog = (e: Event) => {
 81:       e.stopPropagation()
 82:       if (this.dialog) {
 83:         const isShown = this.dialog.classList.contains('opacity-100')
 84:         if (isShown) {
 85:           this.dialog.classList.remove('opacity-100', 'pointer-events-auto')
 86:           this.dialog.classList.add('opacity-0', 'pointer-events-none')
 87:         } else {
 88:           this.dialog.classList.remove('opacity-0', 'pointer-events-none')
 89:           this.dialog.classList.add('opacity-100', 'pointer-events-auto')
 90:         }
 91:       }
