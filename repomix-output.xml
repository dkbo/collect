 193:   const drawCollisionLayer = () => {
 194:     const canvas = collisionCanvasRef.current
 195:     if (!canvas) return
 196:     const ctx = canvas.getContext('2d')
 197:     if (!ctx) return
 198: 
 199:     ctx.clearRect(0, 0, store.width, store.height)
 200:     ctx.globalAlpha = store.opacityM
 201: 
 202:     // Draw collisions
 203:     store.isMoveArr.forEach((c) => {
 204:       ctx.beginPath()
 205:       ctx.rect(c.x, c.y, c.w, c.h)
 206:       ctx.fillStyle = 'rgba(14, 165, 233, 0.5)' // semi-transparent cyan
 207:       ctx.fill()
 208:       ctx.lineWidth = 1
 209:       ctx.strokeStyle = '#0ea5e9'
 210:       ctx.stroke()
 211:     })
 212:     ctx.globalAlpha = 1
 213:   }
