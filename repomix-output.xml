  6: 
  7: const NAV_ITEMS = [
  8:   { to: '/', label: '首頁', end: true, testId: 'nav-home' },
  9:   { to: '/resume', label: 'E-履歷', end: false, testId: 'nav-resume' },
 10:   { to: '/miniGame', label: '小遊戲', end: false, testId: 'nav-minigame' },
 11:   { to: '/rpgroom', label: '遊戲室', end: false, testId: 'nav-rpgroom' },
 12:   { to: '/search', label: '外部查詢', end: false, testId: 'nav-search' },
