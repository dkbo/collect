 96:       const overlayProjection = this.getProjection()
 97:       const sw = overlayProjection.fromLatLngToDivPixel(this.bounds.getSouthWest())
 98:       const ne = overlayProjection.fromLatLngToDivPixel(this.bounds.getNorthEast())
