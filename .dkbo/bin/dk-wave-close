#!/usr/bin/env bash
# dk-wave-close [--force] [-m "<commit msg>"] | dk-wave-close --agent <agent>
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"; . "$DK_ROOT/lib/ownership.sh"; . "$DK_ROOT/lib/layout.sh"; . "$DK_ROOT/lib/herdr.sh"
. "$DK_ROOT/lib/frontmatter.sh"; . "$DK_ROOT/lib/brief.sh"
dk_require_herdr
dir=$(dk_task_dir); DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env; dk_settings
if [ "${1:-}" = --agent ]; then   # close one employee (e.g. a timed-out reviewer) and re-balance its tab
  a="${2:-}"; [ -n "$a" ] || dk_die "usage: dk-wave-close --agent <agent>"
  line=$(awk -v a="$a" '$1==a' "$dir/.panes" | tail -1); [ -n "$line" ] || dk_die "no live pane for $a"
  read -r _ pane _ _ tab _ <<< "$line"
  herdr pane close "$pane" >/dev/null 2>&1 </dev/null || true
  grep -v "^$a " "$dir/.panes" > "$dir/.panes.tmp" || true; mv "$dir/.panes.tmp" "$dir/.panes"
  # 聚合標記要重置：這位多半是撞額度被關掉、等著換 kind 重派的。標記若停在 delivered，
  # 補上的那位做完也不會再有人通知領導，整波就這樣啞掉。
  # latch 也要收：這位的交付隨著 pane 一起作廢，否則補上的那位什麼都還沒寫，聚合就先喊全員完成
  rm -f "$dir/.blocked/wave-${DK_WAVE:-0}.devdone" "$dir/.blocked/wave-${DK_WAVE:-0}.${a#"$DK_SHORT"-}.done"
  dk_process "pane-close $a"
  if [ "${tab:-0}" -ge 1 ] 2>/dev/null; then dk_layout_even "$tab" || true; fi
  echo "closed $a"; exit 0
fi
force=0; cmsg=""
while [ $# -gt 0 ]; do case "$1" in
  --force) force=1; shift;;
  -m) cmsg="${2:-}"; [ -n "$cmsg" ] || dk_die "-m needs a commit message"; shift 2;;
  *) dk_die "unknown flag $1";; esac; done
[ -s "$dir/.panes" ] || dk_die "no live panes recorded in $dir/.panes"
legacy=0
if ! grep -q '^DK_WAVE=' "$dir/.task.env" || awk 'NF<6{bad=1} END{exit !bad}' "$dir/.panes"; then
  legacy=1; echo "dk-wave-close: legacy task or two-column .panes; review/report/test gates skipped" >&2
fi
n="${DK_WAVE:-}"; problems=""
# repo 維度的共用資料：gate c、gate d 與逐 repo commit 三處都要。沒有 .repos 的是 0.9.2 之前
# 建立的任務 —— 退回單列（名字 main、路徑 DK_WORKTREE），三處才只有一條路。
repo_rows=$(dk_repos_rows "$dir" 2>/dev/null || true)
[ -n "$repo_rows" ] || repo_rows="main $DK_PROJECT_ROOT ${DK_WORKTREE:-} -"
mainrepo=$(printf '%s\n' "$repo_rows" | awk 'NR==1{print $1}')
multi=0; dk_repos_multi && multi=1
changed=""; dgate=0   # dgate=1 ⟺ gate d 真的比到了 diff（gate c 的「本波有變更」靠它）
while read -r agent _pane _; do   # gate 0: everyone done
  sname="${agent#"$DK_SHORT"-}"; sf="$dir/state/$sname.md"
  if [ ! -f "$sf" ] || ! grep -q '^status: done' "$sf"; then problems="$problems\n  not done: $agent"; fi
done < "$dir/.panes"
if [ "$legacy" = 0 ]; then
  if [ -z "$n" ]; then problems="$problems\n  no wave open (DK_WAVE empty); dk-wave-open N first"
  elif ! grep -Eq "^[^ ]+ review $n (verdict|skipped:)" "$dir/process.md"; then   # gate a
    problems="$problems\n  no 'review $n verdict …' or 'review $n skipped: <理由>' line in process.md (dk-review, then dk-process)"
  else
    # gate a2: 裁定要交代每一位真的派出去的 reviewer。少一位就靜默放行，等於第二意見白花。
    vline=$(grep -E "^[^ ]+ review $n verdict" "$dir/process.md" | tail -1 || true)
    if [ -n "$vline" ]; then
      for al in $(grep -E "^[^ ]+ review $n spawned " "$dir/process.md" | tail -1 | grep -oE 'reviewer-[a-z]' | sed 's/reviewer-//' | sort -u); do
        case "$vline" in *"$al:"*) ;; *) problems="$problems\n  review $n verdict does not account for reviewer $al (record its result, or '$al: skipped (<理由>)')";; esac
      done
    fi
  fi
  while read -r agent _pane _epoch group _; do   # gate b: dev reports carry a filled ## 測試
    [ "$group" = dev ] || continue
    sname="${agent#"$DK_SHORT"-}"; rf="$dir/state/$sname.report.md"
    if [ ! -f "$rf" ]; then problems="$problems\n  no report $rf (dk-msg $agent \"[TASK] 補 report 測試段\")"
    elif ! awk '
      /^## 測試/{t=1; next}
      t && /^## /{exit}
      t && /^### 紅/{s="r"; next}
      t && /^### 綠/{s="g"; next}
      t && s!="" && /^[^[:space:]（]/{
        n[s]++
        if (n[s]==1 && $0 ~ /^不適用[:：]/) ok[s]=1   # 沒有測試的波：首行就是豁免宣告（半形／全形冒號都算）
        if (n[s]>=2) ok[s]=1                      # 指令列＋輸出，至少兩行
      }
      END{exit !(ok["r"] && ok["g"])}' "$rf"; then
      problems="$problems\n  report $rf 的 '## 測試' 缺證據：'### 紅' 與 '### 綠' 各要指令列與輸出兩行以上（沒有測試的波首行寫「不適用: <理由>」）"
    fi
  done < "$dir/.panes"
  members=$(dk_brief_wave_members "$dir/brief.md" "${n:-0}" | sed 's/(.*//')   # state names, no (tier)
  base=$(dk_wave_base "$dir" "${n:-}")   # gate d: the real diff, not the employees' self-reported touched
  # 不見了的 worktree 要當場擋下。dk_changed_repo_files 會跳過不存在的目錄（它服務的是
  # 「這個 repo 這一波沒被實體化」），閘門這一側若照單全收就變成靜默放行。
  missing=""
  while read -r rname _rroot rwt _rbase; do
    [ -n "$rname" ] || continue
    [ -d "${rwt:-}" ] || missing="${missing:+$missing }${rwt:-（空路徑）}"
  done <<< "$repo_rows"
  if [ -z "$base" ]; then
    echo "dk-wave-close: no recorded base for wave ${n:-?} in process.md; ownership diff gate skipped" >&2
  elif [ -n "$missing" ]; then
    problems="$problems\n  cannot read the worktree diff ($missing since ${base:0:7})"
  elif ! changed=$(dk_changed_repo_files "$dir" "${n:-}"); then
    problems="$problems\n  cannot read the worktree diff (${DK_WORKTREE:-} since ${base:0:7})"
  else
    dgate=1
    reported=$(for m in $members; do [ -f "$dir/state/$m.md" ] || continue; dk_touched "$dir/state/$m.md"; done)
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      owner=""
      for m in $members; do if dk_owned "$dir/brief.md" "$m" "$p"; then owner="$m"; break; fi; done
      if [ -z "$owner" ]; then
        problems="$problems\n  unowned change: $p (no wave ${n:-?} member may change it)"
        dk_process "violation unowned: $p"
      elif ! printf '%s\n' "$reported" | grep -qxF "$p"; then
        echo "dk-wave-close: unreported change: $p (owner $owner); $owner's state left it out of touched"
        dk_process "unreported $p (owner $owner)"
      fi
    done <<< "$changed"
  fi
fi
if [ -n "$problems" ] && [ "$force" = 0 ]; then printf 'dk-wave-close: refused (use --force to close anyway):%b\n' "$problems"; exit 1; fi
tests="skipped (no DK_TEST_CMD)"
if [ "$legacy" = 0 ]; then   # gate c
  mkdir -p "$dir/waves"
  # 測試指令拿到的是一個不含任何 DK_* 的環境。領導這一側的 DK_ROOT／DK_PROJECT_ROOT／DK_WORKTREE
  # 整包傳下去的話，測試裡任何 source lib/common.sh 的東西都會照 `${DK_X:-預設}` 吃到繼承值而打到
  # 真 repo —— 2026-09-19 領導在自己 session 跑 gate c，就這樣在源碼倉建了 7 個 worktree 與 8 個
  # 分支（BACKLOG）。PATH、HOME 等非 DK_* 照舊，測試指令本身還是要找得到工具。
  # env 的第一個元素讓陣列永不為空：bash 3.2 對空陣列展開在 set -u 下會死。
  clean=(env)
  # shellcheck disable=SC2086  # ${!DK_@} 要斷詞，一個變數名一個元素
  for v in ${!DK_@}; do clean+=(-u "$v"); done
  if [ "$multi" = 0 ]; then   # 單 repo：0.9.2 的行為一字不動（本波有沒有變更都跑）
    if [ -n "${DK_TEST_CMD:-}" ]; then
      log="$dir/waves/${n:-forced}.test.log"
      if (cd "$DK_WORKTREE" && "${clean[@]}" bash -c "$DK_TEST_CMD") > "$log" 2>&1; then tests="ok ($DK_TEST_CMD)"
      else
        echo "dk-wave-close: tests failed ($DK_TEST_CMD); last 20 lines of $log:"; tail -n 20 "$log"
        if [ "$force" = 0 ]; then dk_process "wave-close ${n:-?} tests failed ($DK_TEST_CMD)"; exit 1; fi
        tests="failed ($DK_TEST_CMD, forced)"
      fi
    fi
  else
    # 多 repo：只對本波真的有變更的 repo 跑它自己的指令（決策⑨）。沒比到 diff（gate d 被
    # 跳過）時退回「全部都跑」—— 不知道誰動過的時候，少跑比多跑危險。
    if [ "$dgate" = 1 ]; then
      changed_repos=" $(printf '%s\n' "$changed" | sed -n 's/^\([a-z][a-z0-9_]*\):.*/\1/p' | sort -u | tr '\n' ' ')"
    else
      changed_repos=" $(printf '%s\n' "$repo_rows" | awk '{print $1}' | tr '\n' ' ')"
    fi
    parts=""
    while read -r rname _rroot rwt _rbase; do
      [ -n "$rname" ] && [ -n "${rwt:-}" ] && [ -d "$rwt" ] || continue
      case "$changed_repos" in
        *" $rname "*) ;;
        *) parts="$parts $rname skipped (no change)"; continue;;
      esac
      if [ "$rname" = "$mainrepo" ]; then key=DK_TEST_CMD; else key="DK_TEST_CMD_$rname"; fi
      cmd="${!key:-}"
      if [ -z "$cmd" ]; then
        parts="$parts $rname skipped (no $key)"
        echo "dk-wave-close: repo $rname 這一波有變更但沒有 $key，測試沒跑" >&2
        continue
      fi
      log="$dir/waves/${n:-forced}.$rname.test.log"
      # </dev/null：這一段在 while read <<< "$repo_rows" 的迴圈裡，測試指令若讀一次 stdin
      # 沒有這行的話會吃掉迴圈的 herestring，後面的 repo 靜默不跑（一道閘靜默失效）。
      if (cd "$rwt" && "${clean[@]}" bash -c "$cmd") < /dev/null > "$log" 2>&1; then parts="$parts $rname ok ($cmd)"
      else
        echo "dk-wave-close: tests failed ($rname: $cmd); last 20 lines of $log:"; tail -n 20 "$log"
        if [ "$force" = 0 ]; then dk_process "wave-close ${n:-?} tests failed ($rname: $cmd)"; exit 1; fi
        parts="$parts $rname failed ($cmd, forced)"
      fi
    done <<< "$repo_rows"
    tests="${parts# }"
  fi
fi
closed=0; tabs=""
while read -r agent pane _epoch _group tab _; do
  sname="${agent#"$DK_SHORT"-}"; sf="$dir/state/$sname.md"
  if [ -f "$sf" ]; then   # ownership is checked against the real diff above (gate d), not this file
    [ "$(wc -l < "$sf")" -le 20 ] || echo "dk-wave-close: state too long: $sf"
  fi
  herdr pane close "$pane" >/dev/null </dev/null && closed=$((closed+1))
  if [ -n "${tab:-}" ] && [[ " $tabs " != *" $tab "* ]]; then tabs="$tabs $tab"; fi
done < "$dir/.panes"
: > "$dir/.panes"
if [ "$legacy" = 1 ]; then dk_process "wave-close: $closed agents closed"
else
  dk_env_set DK_WAVE ""; dk_env_set DK_WAVE_STARTED ""
  rm -f "$dir/.blocked/wave-${n:-0}.timeout" "$dir/.blocked/wave-${n:-0}.devdone"
  for m in ${members:-}; do rm -f "$dir/.blocked/wave-${n:-0}.$m.done"; done   # 逐成員的交付 latch
  dk_process "wave-close ${n:-?} tests $tests $closed agents closed"
  # 本波耗時。dk-resume 給的是「還在跑多久」，這一行留下「跑了多久」，dk-timeline 再從
  # process.md 的既有 token 把整張表算出來 —— 三支共用 lib/common.sh 的同一份換算。
  w_open=$(dk_ts_pick "$dir/process.md" wave-open "${n:-}")
  w_dev=$(dk_ts_pick "$dir/process.md" dev-done wave "${n:-}")
  r_spawn=$(dk_ts_pick "$dir/process.md" review "${n:-}" spawned)
  r_verdict=$(dk_ts_pick "$dir/process.md" review "${n:-}" verdict)
  r_skip=$(dk_ts_pick "$dir/process.md" review "${n:-}" "skipped:")
  if [ -z "$r_verdict" ] && [ -n "$r_skip" ]; then r_span="skip"; else r_span=$(dk_span "$r_spawn" "$r_verdict"); fi
  span="wave ${n:-?} 耗時 $(dk_span "$w_open" "$(dk_now)")（dev $(dk_span "$w_open" "$w_dev")、審查 $r_span）"
  echo "$span"; dk_process "$span"
  for t in $tabs; do if [ "$t" -ge 1 ]; then dk_layout_even "$t" || true; fi; done
fi
echo "closed $closed"
if [ "$legacy" = 0 ]; then   # the wave boundary is a commit boundary; the leader no longer commits by hand
  peers=$(printf '%s' "${members:-}" | tr '\n' ' ' | sed 's/ *$//')
  msg="${cmsg:-wave ${n:-?}${peers:+: $peers}}"
  committed=0
  while read -r rname _rroot rwt _rbase; do   # 每個有變更的 repo 各 commit 一次，訊息相同（決策⑪）
    [ -n "$rname" ] && [ -n "${rwt:-}" ] && [ -d "$rwt" ] || continue
    [ -n "$(git -C "$rwt" status --porcelain 2>/dev/null)" ] || continue
    suffix=""; [ "$multi" = 0 ] || suffix=" repo $rname"
    # 同一個迴圈、同一類曝險，雖然 -m 下 git commit 不讀 stdin，一併加固。
    if git -C "$rwt" add -A && git -C "$rwt" commit -q -m "$msg" < /dev/null; then
      committed=1; sha=$(git -C "$rwt" rev-parse --short=7 HEAD)
      echo "wave ${n:-?}$suffix committed $sha"; dk_process "commit $sha wave ${n:-?}$suffix"
    else
      echo "dk-wave-close: commit failed in $rwt$suffix; commit by hand before dk-task-close" >&2
      dk_process "commit failed wave ${n:-?}$suffix"; exit 1
    fi
  done <<< "$repo_rows"
  [ "$committed" = 1 ] || echo "wave ${n:-?}: nothing to commit"
fi
