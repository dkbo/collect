#!/usr/bin/env bash
# dk-msg <target|leader> "[TYPE] body"   |   dk-msg --ack
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
dk_require_herdr

# AC10：dev 的 [DONE] 必須 status: done（既有檢查）之外，再驗 state 的形狀。只驗 dev，
# 不驗 reviewer、qa 與雜務。回一行錯誤描述（不含 "dk-msg: state 格式錯：" 前綴）；合法就不印任何東西。
dk_state_touched_shape_error() { # STATE_FILE → 共用契約「state 的 touched 文法」
  local f="$1" line n=0 in_t=0 rest path
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n+1))
    if [[ "$line" =~ ^[A-Za-z_]+: ]]; then
      in_t=0
      case "$line" in
        touched:*)
          rest="${line#touched:}"
          # 去掉冒號後全部空白（不只一格），空字串與 [] 都合法。
          while [ "${rest# }" != "$rest" ]; do rest="${rest# }"; done
          if [ -n "$rest" ] && [ "$rest" != "[]" ]; then
            echo "第 $n 行：touched: 後面只能是空白或 []，多筆改寫成下面每行 '  - path'"; return
          fi
          in_t=1
          ;;
      esac
      continue
    fi
    [ "$in_t" = 1 ] || continue
    [ -n "$line" ] || continue
    case "$line" in
      '  - '*) ;;
      *) echo "第 $n 行：touched 底下每個非空行都要以兩個空白加 '- ' 開頭"; return;;
    esac
    path="${line#  - }"
    case "$path" in
      *[{}*?]*) echo "第 $n 行：touched 路徑不可含 { } * ？：$path"; return;;
    esac
  done < "$f"
}
dk_state_format_error() { # STATE_FILE TASK_DIR → 錯誤描述，合法回空字串
  local sf="$1" td="$2" err rp
  grep -q '^status:' "$sf" || { echo "缺 status 鍵，正確寫法：status: working"; return; }
  grep -q '^touched:' "$sf" || { echo "缺 touched 鍵，正確寫法：touched: 或 touched: []"; return; }
  grep -q '^report:' "$sf" || { echo "缺 report 鍵，正確寫法：report: state/<你的 state 名>.report.md"; return; }
  err=$(dk_state_touched_shape_error "$sf"); [ -z "$err" ] || { echo "$err"; return; }
  rp=$(sed -n 's/^report: *//p' "$sf" | head -1)
  while [ "${rp% }" != "$rp" ]; do rp="${rp% }"; done
  [ -n "$rp" ] || { echo "report: 沒填路徑"; return; }
  [ -s "$td/$rp" ] || { echo "report: $rp 不存在或是空的"; return; }
}
# AC9：領導最後一筆 [ACK] 之後，log 裡有多少則寄給領導的訊息還沒讀。沒有任何 [ACK] 就從頭算。
dk_msg_unacked() { # LOG LEADER → "N|TS|SENDER"（最新一則），沒有未讀就印空字串
  [ -f "$1" ] || return 0
  awk -v leader="$2" '
    $0 ~ ("^[^ ]+ " leader " \\[ACK\\]$") { start = NR }
    { line[NR] = $0 }
    END {
      n = 0
      for (i = start + 1; i <= NR; i++) {
        if (line[i] ~ (" -> " leader " \\[")) {
          n++; split(line[i], p, " "); ts = p[1]; frm = p[2]
        }
      }
      if (n > 0) print n "|" ts "|" frm
    }' "$1"
}
if [ -n "${DK_CHORE_FILE:-}" ]; then   # chore worker: no task binding; the leader is whoever ran dk-chore
  chore=1; leader="${DK_LEADER:?dk-msg: DK_LEADER unset}"; sender="${DK_AGENT:?dk-msg: DK_AGENT unset}"
  log="$DK_ROOT/tasks/_chores/messages.log"; mkdir -p "$(dirname "$log")"
else
  chore=0; dir=$(dk_task_dir); DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env
  leader=$(dk_leader_name); sender="${DK_AGENT:-$leader}"; log="$dir/messages.log"
fi

# 守望曾經無聲死掉整波沒人發現：事故那一波唯一還在跑的是員工的 dk-msg。所以綁著任務時，每一個
# 寫 messages.log 的出口（含背景送的前景那一半）之後都 --ensure 一次，死了就地叫回來、process 記 watch died。
# 雜務的守望由 dk-chore 負責；--ensure 自己有鎖，四人波接連送 [DONE] 不會起兩隻。
# .panes 不在＝任務已結案（dk-task-close 刪它）：還在背景送的那一份不能對已 commit 的任務目錄
# 記 watch died、改 .task.env、起一對第一輪就自己退出的守望（rest 波 1 審查 M1）。
wake_watch() {
  [ "$chore" = 0 ] && [ -z "${DK_NO_WATCH:-}" ] && [ -f "$dir/.panes" ] || return 0
  "$DK_ROOT/bin/dk-watch" --ensure </dev/null >/dev/null 2>&1 || true
}

if [ "${1:-}" = "--ack" ]; then echo "$(dk_now) $sender [ACK]" >> "$log"; wake_watch; exit 0; fi
target="${1:-}"; text="${2:-}"
[ -n "$target" ] && [ -n "$text" ] || dk_die "usage: dk-msg <target> \"[TYPE] body\""
[ "$target" = leader ] && target="$leader"

if [[ ! "$text" =~ ^\[(TASK|DONE|BUG|FIXED|QUESTION|ANSWER|ESCALATE|DECISION|STOP|BLOCKED)\]\ (.+)$ ]]; then
  echo "dk-msg: text must be '[TYPE] body' with a known type" >&2; exit 2; fi
type="${BASH_REMATCH[1]}"; body="${BASH_REMATCH[2]}"
if [ "${#body}" -gt 200 ]; then echo "dk-msg: body >200 chars; put details in your state file" >&2; exit 2; fi
if [ "$chore" = 1 ] && [ "$target" != "$leader" ]; then
  echo "dk-msg: chore workers may only message leader" >&2; exit 2; fi
if [ "${DK_ISOLATED:-0}" = 1 ] && [ "$target" != "$leader" ]; then
  echo "dk-msg: you are isolated; only leader may be messaged" >&2; exit 2; fi

# AC8：切片過期提示。寄件者是領導、對象是員工、類型是指派型訊息時，brief.md 比對方讀的那份
# 切片新就代表他手上的是舊切片——不擋（訊息照送），只是先提醒領導自己去想清楚要不要重產。
if [ "$chore" = 0 ] && [ "$sender" = "$leader" ] && [ "$target" != "$leader" ] \
   && [[ "$type" =~ ^(TASK|DECISION|BUG)$ ]]; then
  sname="${target#"$DK_SHORT"-}"
  slice="$dir/briefs/$sname.md"
  if [ -f "$dir/brief.md" ] && [ -f "$slice" ] && [ "$dir/brief.md" -nt "$slice" ]; then
    echo "dk-msg: brief.md 比 briefs/$sname.md 新，員工讀的是舊切片；改了會影響他的段落就先 dk-wave-open ${DK_WAVE:-N} --refresh" >&2
  fi
fi

# AC9：未讀提示。領導送 [TASK]／[DECISION] 時，若上次 [ACK] 之後還有寄給他的訊息沒讀
# （dev 只落盤、不叫醒領導的 [DONE] 也算），先提醒再照送。
if [ "$chore" = 0 ] && [ "$sender" = "$leader" ] && [[ "$type" =~ ^(TASK|DECISION)$ ]]; then
  info=$(dk_msg_unacked "$log" "$leader")
  if [ -n "$info" ]; then
    cnt="${info%%|*}"; rest="${info#*|}"; ts="${rest%%|*}"; frm="${rest#*|}"
    echo "dk-msg: 你有 $cnt 則未 ack 的訊息（最新一則 $ts 來自 $frm），先讀再送" >&2
  fi
fi

# dev 的 [DONE] 只落盤，不吵領導：領導改由 dk-watch 在本波 dev 全員完成時收到一則聚合訊息。
# 四人波原本是四次全量喚醒（每次都要把領導整個 context 重跑一輪），聚合後剩一次。
# 送出前 state 必須已是 done —— 否則這則 DONE 沉進 log，而 dk-watch 也因為 state 沒 done
# 不會推聚合，整波會靜悄悄卡到整波逾時才有人吭聲。擋在這裡，錯誤當場回到犯錯的人手上。
if [ "$chore" = 0 ] && [ "$type" = DONE ] && [ "$target" = "$leader" ] \
   && [ "$(awk -v n="$sender" '$1==n{print $4; exit}' "$dir/.panes" 2>/dev/null)" = dev ]; then
  sf="$dir/state/${sender#"$DK_SHORT"-}.md"
  grep -q '^status: done' "$sf" 2>/dev/null \
    || { echo "dk-msg: 先把 $sf 寫成 'status: done'（report 也要寫好）再送 [DONE]" >&2; exit 2; }
  err=$(dk_state_format_error "$sf" "$dir")
  [ -z "$err" ] || { echo "dk-msg: state 格式錯：$err" >&2; exit 2; }
  echo "$(dk_now) $sender -> $target [$type] $body" >> "$log"
  wake_watch; exit 0
fi

line="[$type] from $sender: $body"

# 收件者解析。herdr 認的是註冊名，PROTOCOL 教人寫的是短名，兩者對不上時 herdr 回 agent_not_found，
# wait 與 prompt 雙雙非零 —— 看起來就跟「對方忙到送不進」一模一樣。panova2/sportswitch 實跑 13 筆
# 訊息 12 筆 UNDELIVERED，兩個方向各壞一邊：員工的 dk-msg leader 打到從未註冊的 leader-<short>，
# 領導的 [TASK] 打到沒有任務前綴的 reviewer-a。pane id 是唯一不靠 rename 的把手，留作退路。
fallback=""
if [ "$chore" = 0 ]; then
  panes="$dir/.panes"
  in_panes() { [ -f "$panes" ] && awk -v n="$1" '$1==n{f=1} END{exit !f}' "$panes"; }
  # 領導在哪是 DK_LEADER_PANE（交棒後＝任務根 tab 的根 pane）；DK_ROOT_PANE 是版面錨點，
  # 只在沒有 DK_LEADER_PANE 的舊任務裡才是同一格。
  if [ "$target" = "$leader" ]; then fallback="${DK_LEADER_PANE:-${DK_ROOT_PANE:-}}"
  else
    if ! in_panes "$target" && in_panes "${DK_SHORT:-}-$target"; then target="${DK_SHORT}-$target"; fi
    [ -f "$panes" ] && fallback=$(awk -v n="$target" '$1==n{print $2; exit}' "$panes")
  fi
fi
[ "$fallback" = "$target" ] && fallback=""

group_of() { awk -v n="$1" '$1==n{print $4; exit}' "$dir/.panes" 2>/dev/null; }

# AC6：重派已交付的 dev 時提醒他這一輪也要改寫 state —— 不改寫的話 dk-watch 的聚合永遠等不到他。
# 「送達當下」才判：背景那一份可能等了半小時，這期間他可能已經自己把 state 改回 working。
delivered_note() { # → 尾註或空字串；只對 TASK／BUG 的 group=dev 收件者
  [ "$chore" = 0 ] && { [ "$type" = TASK ] || [ "$type" = BUG ]; } || return 0
  [ "$(group_of "$target")" = dev ] || return 0
  grep -q '^status: done' "$dir/state/${target#"$DK_SHORT"-}.md" 2>/dev/null || return 0
  printf '%s' '（你已交付過：做完先改寫 state 再回 [FIXED]）'
}

deliver() { # TARGET — 等它閒下來再送；兩步任一步失敗都算沒送到
  herdr agent wait "$1" --until idle --until "done" --timeout "${DK_MSG_WAIT_MS:-300000}" >/dev/null 2>&1 \
    && herdr agent prompt "$1" "$line$(delivered_note)" >/dev/null 2>&1
}

# [TASK]／[BUG] 開啟新的一輪。`.panes` 的 epoch 從此是「最後一次指派」而不是「spawn 以來」—— 不重設的話，
# 第二輪的 reviewer 一被派就已經超過 DK_REVIEW_TIMEOUT_MIN，逾時量的是錯的對象（BACKLOG 2026-09-14）。
# 只在送達後重設：送不到的指派沒有開始任何一輪，先重設只會把卡住的人藏起來。
# 同時存下 state 此刻的 cksum —— dk-watch 靠「內容有沒有變過」分辨這一輪交的 done 與上一輪留下的 done。
# 用 cksum 不用 mtime：`date -r` 在 GNU 與 BSD 語義不同（同 dk-chore-tidy 的理由）。
redispatch() { # AGENT — 只動 .panes 裡真的有的列；雜務與已收工的對象不憑空生列
  local a="$1" p sf
  p="$dir/.panes"; sf="$dir/state/${a#"$DK_SHORT"-}.md"
  [ -f "$p" ] || return 0
  awk -v n="$a" '$1==n{f=1} END{exit !f}' "$p" || return 0
  # AC5 之後這一步在背景、送達那一刻才跑：多位收件者的背景那一份會同時改寫 .panes，用 flock 互斥。
  # 改寫 .panes 的人（dk-spawn、dk-wave-close）都拿同一把 .blocked/panes.lock；鎖檔放 .blocked/ 而不是任務目錄根，
  # 結案時跟著 .blocked 一起刪，不會被 commit 進記憶。拿鎖逾時仍照做，所以 mv 前再比一次內容，
  # 變了就重讀重寫，不蓋掉別人剛 append 的列（review Minor 7）。
  mkdir -p "$dir/.blocked"
  ( flock -w 5 9 || true
    local before n=0
    while :; do
      before=$(cksum < "$p")
      awk -v n="$a" -v t="$(date +%s)" 'NF>=3 && $1==n {$3=t} {print}' "$p" > "$p.tmp"
      if [ "$(cksum < "$p")" = "$before" ] || [ "$n" -ge 5 ]; then mv "$p.tmp" "$p"; break; fi
      n=$((n+1))
    done ) 9>"$dir/.blocked/panes.lock"
  rm -f "$dir/.blocked/$a.timeout"   # 上一輪的逾時已結案；留著的 delivered 會讓這一輪永遠不再報
  if [ -f "$sf" ]; then cksum < "$sf"; else printf ''; fi > "$dir/.blocked/$a.redispatch"
  # AC6：重派 dev 就是開新的一輪交付。上一輪的 latch 與本波聚合標記不刪，dk-watch 會拿舊的 done
  # 當場再推一次聚合（或因 devdone 已 delivered 而永不再推）；快照改成此刻內容，他改寫 state 才算交。
  if [ -n "${DK_WAVE:-}" ] && [ "$(group_of "$a")" = dev ]; then
    rm -f "$dir/.blocked/wave-$DK_WAVE.${a#"$DK_SHORT"-}.done" "$dir/.blocked/wave-$DK_WAVE.devdone"
    if [ -f "$sf" ]; then cksum < "$sf"; else printf ''; fi > "$dir/.blocked/$a.spawn"
  fi
}

# dev → qa 的 [DONE] 改背景送：qa 多半正在寫探測腳本，前景等它閒下來會把 dev 的 pane 卡住
# 12–30 分（panova autofold 22／13 分、gamemore 30 分），而 qa 本來就會自己看 dev 的 state 開工。
# 仍然會送到：qa 若已停下來等，這一則就是叫醒它的訊號。送達或送不到照常由背景那一份記 log。
if [ "$chore" = 0 ] && [ "$type" = DONE ] && [ -z "${DK_MSG_BG:-}" ] && [ -f "$dir/.panes" ] \
   && [ "$(awk -v n="$sender" '$1==n{print $4; exit}' "$dir/.panes")" = dev ] \
   && [ "$(awk -v n="$target" '$1==n{print $4; exit}' "$dir/.panes")" = review ]; then
  DK_MSG_BG=1 nohup "$0" "$target" "$text" </dev/null >/dev/null 2>&1 3>&- &
  echo "dk-msg: 改在背景等 $target 閒下來再送（結果記在 messages.log），你直接往下做"
  wake_watch; exit 0
fi

# AC5（#14）：領導送給員工的指派型訊息也改背景送。領導前景等員工閒下來，一則就能卡掉五分鐘，
# 等不到還整則放棄（UNDELIVERED）——而領導卡住的那段時間整隊都在等他。背景那一份等得比較久
# （預設 6 次 × 5 分＝30 分），送達才 redispatch，最終送不到另記 process，dk-resume 翻得到。
# 對象限 .panes 裡的員工：雜務與已收工的人不在 .panes，照舊前景送。
if [ "$chore" = 0 ] && [ "$sender" = "$leader" ] && [ "$target" != "$leader" ] && [ -z "${DK_MSG_BG:-}" ] \
   && [[ "$type" =~ ^(TASK|BUG|DECISION|STOP)$ ]] && in_panes "$target"; then
  q="$dir/.blocked/msgq-$target"; mkdir -p "$dir/.blocked"
  DK_MSG_BG=1 DK_MSG_QUEUED=1 DK_MSG_TRIES="${DK_MSG_TRIES:-6}" nohup "$0" "$target" "$text" </dev/null >/dev/null 2>&1 3>&- &
  # 排隊號碼在前景就落下：連送兩則時第二則一定排在第一則後面，不看背景那一份誰先醒。
  ( flock -w 5 9 || true; echo "$!" >> "$q" ) 9>"$q.lock"
  echo "dk-msg: 改在背景等 $target 閒下來再送（結果記在 messages.log），你直接往下做"
  wake_watch; exit 0
fi

# 背景那一份：同一收件者一次只送一則、照送出順序（FIFO）。輪到自己＝佇列頭是自己的 pid；
# 佇列頭的行程已經不在（被殺、機器重開）就剔掉它，免得後面整排永遠等下去。
queue_wait() { # QUEUE — 回傳時自己已是佇列頭（最多等 DK_MSG_QUEUE_SEC 秒，預設一小時，過了就不排了）
  local q="$1" head waited=0
  while :; do
    head=$( (flock -w 5 9 || true
      while :; do
        h=$(head -n 1 "$q" 2>/dev/null) || h=""
        if [ -n "$h" ] && [ "$h" != "$$" ] && ! kill -0 "$h" 2>/dev/null; then
          sed '1d' "$q" > "$q.tmp" && mv "$q.tmp" "$q"; continue
        fi
        echo "$h"; break
      done) 9>"$q.lock")
    # 前景還沒來得及寫下這一份的 pid（空佇列）也算還沒輪到；佇列檔整個不見（任務被收掉）就不排了
    [ "$head" = "$$" ] && return 0
    [ -f "$q" ] || return 0
    [ "$waited" -ge $(( ${DK_MSG_QUEUE_SEC:-3600} * 5 )) ] && return 0
    sleep 0.2; waited=$((waited+1))
  done
}
# shellcheck disable=SC2317  # 只經 trap EXIT 呼叫
queue_leave() { # QUEUE
  # 只剩自己時 grep -vx 沒輸出、回 1：set -e 下不吞掉它，subshell 會在 mv 之前退出、把自己的 pid 留在佇列頭
  ( flock -w 5 9 || true; { grep -vx "$$" "$1" 2>/dev/null || true; } > "$1.tmp"; mv "$1.tmp" "$1" ) 9>"$1.lock"
}
# 只有前景真的替它排了隊（DK_MSG_QUEUED）才進佇列。只看佇列檔在不在的話，檔一建就永遠在，
# dev→qa 的背景 [DONE] 與測試裡的 DK_MSG_BG=1 都會空等到 DK_MSG_QUEUE_SEC 才送（review I1）。
bgq=""
if [ -n "${DK_MSG_QUEUED:-}" ] && [ "$chore" = 0 ]; then
  bgq="$dir/.blocked/msgq-$target"; queue_wait "$bgq"; trap 'queue_leave "$bgq"' EXIT
fi

# 重試而不是一次定生死：實跑中 reviewer 的 [DONE] 曾在一分鐘內就被判失敗、整筆遺失，
# 而它的報告好端端躺在磁碟上 —— 領導從不知道它交過。
tries="${DK_MSG_TRIES:-3}"; i=1
while [ "$i" -le "$tries" ]; do
  # log 一律記解析後的名字，不記 pane id：那是人與 dk-wave-close 讀的那一欄。
  if deliver "$target" || { [ -n "$fallback" ] && deliver "$fallback"; }; then
    if [ "$chore" = 0 ] && { [ "$type" = TASK ] || [ "$type" = BUG ]; }; then redispatch "$target"; fi
    echo "$(dk_now) $sender -> $target [$type] $body" >> "$log"; wake_watch; exit 0
  fi
  [ "$i" -lt "$tries" ] && sleep "${DK_MSG_RETRY_SEC:-5}"
  i=$((i+1))
done
echo "$(dk_now) $sender -> $target [UNDELIVERED] [$type] $body" >> "$log"
[ "$chore" = 1 ] || [ "$sender" != "$leader" ] || dk_process "undelivered $target [$type]"
echo "dk-msg: undelivered to $target (logged); note it in your state blocked_by and continue" >&2
wake_watch; exit 1
