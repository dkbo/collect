#!/usr/bin/env bash
# dk-chore <role> "<instruction>" [--kind K] [--tier S|M|L] [--code] [--cwd PATH]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
. "$DK_ROOT/lib/frontmatter.sh"; . "$DK_ROOT/lib/kinds.sh"
dk_require_herdr
role="${1:-}"; instr="${2:-}"; shift 2 || true
[ -n "$role" ] && [ -n "$instr" ] || dk_die "usage: dk-chore <role> \"<instruction>\" [--kind K] [--tier T] [--code] [--cwd PATH]"
kind=""; tier=M; code=0; cwd="$DK_PROJECT_ROOT"
while [ $# -gt 0 ]; do case "$1" in
  --kind) kind="$2"; shift 2;; --tier) tier="$2"; shift 2;; --code) code=1; shift;; --cwd) cwd="$2"; shift 2;;
  *) dk_die "unknown flag $1";; esac; done
rf="$DK_ROOT/roles/$role.md"; [ -f "$rf" ] || dk_die "no role file $rf (use add-role skill first)"
[ -n "$kind" ] || kind=$(dk_fm "$rf" kind)
spec=$(dk_fm_tier "$rf" "$tier"); [ -n "$spec" ] || dk_die "role $role has no tier $tier"
if [ "$kind" != "$(dk_fm "$rf" kind)" ]; then dk_kind_load "$kind"; spec=$(echo "$KIND_DEFAULT_TIERS" | tr ' ' '\n' | awk -F= -v t="$tier" '$1==t{print $2}'); fi
args=$(dk_kind_args "$kind" "$spec")
# 編號只需要保證「同時在跑的不撞」，而 .sessions/chores/<agent> 存在 ⟺ 它還在跑，那才是該問的
# 地方。從 _chores 檔案數來的全域遞增只增不減，而且人整理過那個目錄就會重算 —— 0.5.1 修的撞號
# 正是那樣來的。改成回收最小可用號之後，編號與檔案佈局徹底脫鉤，號碼永遠停在同時在跑的件數。
n=1; while compgen -G "$DK_ROOT/.sessions/chores/chore-*-$n" >/dev/null 2>&1; do n=$((n+1)); done
agent="chore-$role-$n"; slug=$(dk_slug "${instr:0:24}"); slug="${slug:-chore$n}"
dk_kind_load "$kind"; sess=$(kind_session_args "$agent"); [ -z "$sess" ] || args="$args $sess"   # pane 上看得出是哪位雜務員工（同 dk-spawn）
[[ "$agent" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || dk_die "agent name '$agent' must match [a-z][a-z0-9_-]{0,31} (shorten the role)"
# 日期在資料夾上而不在檔名裡：展開 _chores/ 看到的是幾個日期，不是幾百個檔。
cdir="$DK_ROOT/tasks/_chores/$(dk_today)"; mkdir -p "$cdir"
# 防撞後綴不能再用 $n —— 它現在會回收，同一天同 slug 的第三件會撞回第二件的檔名（而舊寫法
# 只試一次就放棄，第三件會靜靜覆蓋掉第二件的雜務檔）。遞增找到第一個空位為止。
cf="$cdir/$slug.md"; i=2
while [ -e "$cf" ]; do cf="$cdir/$slug-$i.md"; i=$((i+1)); done
branch="-"; ws="-"; split_from=(--current)   # ws stays "-": code chores use a plain git worktree, same as tasks (see dk-task-new)
if [ "$code" = 1 ]; then
  branch="chore/$slug"; cwd="${DK_WORKTREE_DIR:-$DK_PROJECT_ROOT/.worktrees}/chore-$slug"
  if [ -e "$cwd" ] || git -C "$DK_PROJECT_ROOT" rev-parse --verify -q "$branch" >/dev/null; then
    dk_die "chore branch $branch or worktree $cwd already exists (an unclosed chore? run dk-chore-close, or: git worktree remove $cwd; git branch -D $branch)"
  fi
  mkdir -p "$(dirname "$cwd")"
  git -C "$DK_PROJECT_ROOT" worktree add -q -b "$branch" "$cwd" HEAD >/dev/null 2>&1 || dk_die "git worktree add failed for $branch"
  rollback() { # any later step dying must not leave the worktree, branch, chore file or record behind
    git -C "$DK_PROJECT_ROOT" worktree remove --force "$cwd" >/dev/null 2>&1 || true
    git -C "$DK_PROJECT_ROOT" branch -D "$branch" >/dev/null 2>&1 || true
    rm -f "$cf" 2>/dev/null || true              # $cf 這時還沒有人讀過它
    [ -z "${crec:-}" ] || rm -f "$crec" "$crec.tmp" 2>/dev/null || true   # crec 在 trap 掛上之後才賦值
  }
  trap rollback EXIT
fi
crec="$DK_ROOT/.sessions/chores/$agent"
# 撞號：員工刪過自己的雜務檔後 n 可能重算回同一個數字。record 檔還在就代表那個 agent 還活著。
[ ! -e "$crec" ] || dk_die "$agent 的執行記錄 $crec 已存在（它還在跑？先 dk-chore-close $agent）"
direction=$(dk_fm "$rf" split); direction="${direction:-right}"
leader=$(herdr agent get "${HERDR_PANE_ID:?}" 2>/dev/null | dk_json '.result.agent.name // empty' || true); leader="${leader:-$HERDR_PANE_ID}"
pane=$(herdr pane split "${split_from[@]}" --direction "$direction" --cwd "$cwd" --no-focus \
  --env "DK_ROOT=$DK_ROOT" --env "DK_ROLE=$role" --env "DK_AGENT=$agent" --env "DK_CHORE_FILE=$cf" \
  --env "DK_LEADER=$leader" --env "DK_CHORE_CODE=$code" --env "HERDR_ENV=1" | dk_json '.result.pane.pane_id')
[ -n "$pane" ] || dk_die "pane split returned no pane_id"
dk_render "$DK_ROOT/templates/chore.md" "SOURCE=$instr" "AGENT=$agent" "KIND=$kind" "TIER=$tier" > "$cf"
# 執行狀態：機器的。.sessions 是 gitignored，這些欄位是 runtime handle，用完即丟。
# 放在這裡（agent start 之前）是為了讓失敗路徑能和 $cf 一起清掉。
mkdir -p "$(dirname "$crec")"
# 完成訊號要綁這件雜務的生命期：messages.log 是 append-only 且永遠增長，而 _chores/*.md 是人會去
# 整理的那一個 —— 整理過後 n 會重算，同名雜務就會撿到上一輪留下的 [DONE]。記下起點，關閉時只看之後的行。
clog="$DK_ROOT/tasks/_chores/messages.log"; nlog=0
[ -f "$clog" ] && nlog=$(wc -l < "$clog" | tr -d ' ')
{ printf 'file=%s\n'      "$cf"
  printf 'instr=%s\n'     "${instr%%$'\n'*}"   # 首行；全文留在雜務檔給人看
  printf 'branch=%s\n'    "$branch"
  printf 'workspace=%s\n' "$ws"
  printf 'pane=%s\n'      "$pane"
  printf 'leader=%s\n'    "$leader"
  printf 'logline=%s\n'   "$nlog"
} > "$crec.tmp"
mv "$crec.tmp" "$crec"   # atomic：record 是後面破壞性操作的唯一輸入，不容許半寫的檔案
# shellcheck disable=SC2086
if ! herdr agent start "$agent" --kind "$kind" --pane "$pane" -- $args >/dev/null; then
  herdr pane close "$pane" >/dev/null 2>&1 </dev/null || true
  rm -f "$cf" "$crec"
  dk_die "agent start failed for $agent (pane $pane closed)"
fi
# 員工從這一刻起活在 worktree 裡，rollback 的契約（「沒人進去過就清乾淨」）到此為止。
# 再往後任何一步失敗都不准動 worktree：那裡有一個正在跑的 agent 和它還沒 commit 的改動。
trap - EXIT
# 「執行環境是共用的」這句必須在提示裡，不能只放在 PROTOCOL：實跑中一件唯讀探測雜務跑去
# kill 主樹的 dev server 並重啟（classifier 擋下了）。worktree 隔離檔案，不隔離 port、db、
# docker、dev server —— 而雜務沒有 brief，那張「獨佔資源」表它根本看不到。
prompt="你是 $agent，角色 $role，這是一件雜務。先讀 $DK_ROOT/roles/$role.md、$DK_ROOT/PROTOCOL.md、$DK_ROOT/PROJECT.md。交代：$instr。$cf 是你的筆記，格式隨你寫。禁止使用 subagent。執行環境（dev server、port、db、docker）是全隊共用的，worktree 只隔離檔案不隔離它們：不要 kill 進程、不要重啟或佔用服務，需要動就 dk-msg leader \"[ESCALATE] ...\" 讓領導決定。"
[ "$code" = 1 ] && prompt="$prompt 你在分支 $branch 的 worktree 中，完成後自己跑測試並 commit。範圍比想的大就停下回報。" || prompt="$prompt 不得修改程式碼。"
prompt="$prompt 完成後執行：$DK_ROOT/bin/dk-msg leader \"[DONE] <一句結果>\"（它會等領導閒置再送）。"
"$DK_ROOT/bin/dk-watch" --chores --ensure >/dev/null 2>&1 || true   # a chore pane just appeared
dk_index_add "$(dk_today)" "${instr%%$'\n'*}" chore working "$cf"   # first line only; dk-chore-close matches the same
# --until working：確認提示被接受且員工開始跑。預設的 --wait 是等「這一輪結束」
# （herdr: matches idle, done or blocked），雜務第一輪超過逾時就會被誤判成提示沒送到。
if ! herdr agent prompt "$agent" "$prompt" --wait --until working --timeout 15000 >/dev/null; then
  echo "dk-chore: first prompt to $agent failed or timed out; pane $pane 與 worktree $cwd 都留著 —— herdr agent read $agent 看它卡在哪，再重送提示，或 dk-chore-close $agent --abandon" >&2
  echo "$agent $pane $cf"; exit 1
fi
echo "$agent $pane $cf"
