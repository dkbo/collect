#!/usr/bin/env bash
# dk-task-close [--abandon "<reason>"]
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"
dk_require_herdr
dir=$(dk_task_dir); DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env
# AC9：結案把時間表填進 report.md 的「## 時間」段。放在 dk_process "task-close …" 之後、
# dk_commit_memory 之前 —— 早一步算不到結案那一刻，晚一步就沒進任務記憶的 commit。
fill_timeline() {
  local tl f="$dir/report.md"
  [ -f "$f" ] || return 0
  tl=$("$DK_ROOT/bin/dk-timeline" "$(basename "$dir")" 2>&1) || {
    echo "dk-task-close: dk-timeline 失敗，report.md 的「## 時間」沒填：$tl" >&2; return 0; }
  if grep -q '^## 時間$' "$f"; then   # 範本已有這一段：整段換成算出來的表，指引行不留
    awk -v tl="$tl" '/^## 時間$/{print; print tl; s=1; next} s && /^## /{s=0} s{next} {print}' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  else printf '## 時間\n%s\n' "$tl" >> "$f"; fi
}
abandon=0; reason=""
[ "${1:-}" = --abandon ] && { abandon=1; reason="${2:-（未填原因）}"; }
if [ "$abandon" = 0 ]; then [ -f "$dir/report.md" ] || { echo "dk-task-close: write $dir/report.md first (gate 3)"; exit 1; }; fi
# 軟警告，不擋:一條風格意見不該卡住結案（同 dk-wave-close 的 unreported change）。
if [ "$abandon" = 0 ] && [ -n "$(dk_minor_lines "$dir/process.md")" ]; then
  mn=$(dk_minor_count "$dir/process.md")
  # 範本自己的指引行（templates/report.md 的「未完成 / 遺留」段）本身就含「Minor」三個
  # 字，逐字比對會被它自己消掉；忽略 `（` 開頭的指引行再比對。
  grep -v '^（' "$dir/report.md" 2>/dev/null | grep -qi 'minor' \
    || echo "dk-task-close: process.md 有 $mn 條 minor，但 report.md 沒提到 —— 整枝評議 triage 過的話，把沒修的寫進「未完成 / 遺留」段" >&2
fi
[ ! -s "$dir/.panes" ] || { echo "dk-task-close: live panes remain; run dk-wave-close first"; exit 1; }

legacy=0; if dk_legacy_task; then legacy=1; echo "dk-task-close: legacy task (no DK_BASE); removing the worktree via herdr" >&2; fi
cleanup() {
  [ -n "${DK_WATCH_PID:-}" ] && kill "$DK_WATCH_PID" 2>/dev/null || true
  [ -n "${DK_EVENTS_PID:-}" ] && kill "$DK_EVENTS_PID" 2>/dev/null || true
  if [ "$DK_WORKTREE" != "$DK_PROJECT_ROOT" ]; then
    if [ "$legacy" = 1 ]; then [ -n "${DK_WORKSPACE:-}" ] && herdr worktree remove --workspace "$DK_WORKSPACE" --force >/dev/null 2>&1 || true
    else git -C "$DK_PROJECT_ROOT" worktree remove --force "$DK_WORKTREE" >/dev/null 2>&1 || true; fi
  fi
  for t in ${DK_TABS:-}; do herdr tab close "${t#*=}" >/dev/null 2>&1 </dev/null || true; done
  rm -rf "$dir/.panes" "$dir/.blocked" "$DK_ROOT/.sessions/${HERDR_PANE_ID:?}"
  herdr agent rename "$HERDR_PANE_ID" --clear >/dev/null 2>&1 || true
}
if [ "$abandon" = 1 ]; then
  printf '# %s 結案\n結果：abandoned   分支：%s\n## 原因\n%s\n' "$DK_DISPLAY" "$DK_BRANCH" "$reason" > "$dir/report.md"
  cleanup; git -C "$DK_PROJECT_ROOT" branch -D "$DK_BRANCH" >/dev/null 2>&1 || true
  dk_index_set "$DK_DISPLAY" abandoned "$reason" || echo "dk-task-close: INDEX 沒有名稱為「$DK_DISPLAY」的列；狀態沒更新，請自己改 $DK_ROOT/tasks/INDEX.md" >&2
  dk_process "task-close abandoned: $reason"
  dk_commit_memory "dkbo memory: task $DK_SHORT — $DK_DISPLAY" "$dir" "$DK_ROOT/tasks/INDEX.md" "$DK_ROOT/decisions.md" || echo "dk-task-close: 任務記憶沒 commit 成功，請自己 git add \"$dir\" 並 commit" >&2
  echo abandoned; exit 0
fi
if [ "$DK_WORKTREE" != "$DK_PROJECT_ROOT" ] && [ -d "$DK_WORKTREE" ] && [ -n "$(git -C "$DK_WORKTREE" status --porcelain 2>/dev/null)" ]; then
  echo "dk-task-close: $DK_WORKTREE has uncommitted changes; commit them in the worktree first (or --abandon to discard)"; exit 1
fi
if [ "$DK_WORKTREE" = "$DK_PROJECT_ROOT" ]; then   # --no-worktree task: work already on the current branch, nothing to merge
  sha=$(git -C "$DK_PROJECT_ROOT" rev-parse --short HEAD); cleanup
  dk_index_set "$DK_DISPLAY" "done" "in-tree $sha" || echo "dk-task-close: INDEX 沒有名稱為「$DK_DISPLAY」的列；狀態沒更新，請自己改 $DK_ROOT/tasks/INDEX.md" >&2
  dk_process "task-close in-tree $sha"
  fill_timeline
  dk_commit_memory "dkbo memory: task $DK_SHORT — $DK_DISPLAY" "$dir" "$DK_ROOT/tasks/INDEX.md" "$DK_ROOT/decisions.md" || echo "dk-task-close: 任務記憶沒 commit 成功，請自己 git add \"$dir\" 並 commit" >&2
  echo "closed $sha"; exit 0
fi
if ! git -C "$DK_PROJECT_ROOT" merge --no-ff "$DK_BRANCH" -m "task $DK_SHORT: $DK_DISPLAY" >/dev/null 2>&1; then
  git -C "$DK_PROJECT_ROOT" merge --abort 2>/dev/null || true
  dk_process "merge-conflict $DK_BRANCH"; echo "dk-task-close: merge conflict on $DK_BRANCH; ask the human or run an it repair wave"; exit 3
fi
sha=$(git -C "$DK_PROJECT_ROOT" rev-parse --short HEAD)
cleanup; git -C "$DK_PROJECT_ROOT" branch -d "$DK_BRANCH" >/dev/null 2>&1 || true   # merged above, so -d is safe
dk_index_set "$DK_DISPLAY" "done" "merged $sha" || echo "dk-task-close: INDEX 沒有名稱為「$DK_DISPLAY」的列；狀態沒更新，請自己改 $DK_ROOT/tasks/INDEX.md" >&2
dk_process "task-close merged $sha"
fill_timeline
dk_commit_memory "dkbo memory: task $DK_SHORT — $DK_DISPLAY" "$dir" "$DK_ROOT/tasks/INDEX.md" "$DK_ROOT/decisions.md" || echo "dk-task-close: 任務記憶沒 commit 成功，請自己 git add \"$dir\" 並 commit" >&2
echo "merged $sha"
