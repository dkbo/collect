#!/usr/bin/env bash
# dk-task-new <short> "<display>" [--from <plan>] [--no-worktree]
# dk-task-new <short> --gate1
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"; . "$DK_ROOT/lib/repos.sh"
dk_require_herdr
short="${1:-}"; shift || true
[[ "$short" =~ ^[a-z][a-z0-9-]{0,11}$ ]] || dk_die "short name must be ascii lowercase, ≤12 chars: '$short'"
display=""; from="人的口頭需求"; worktree=1; gate1=0
while [ $# -gt 0 ]; do case "$1" in
  --from) from="$2"; shift 2;; --no-worktree) worktree=0; shift;; --gate1) gate1=1; shift;;
  --*) dk_die "unknown flag $1";; *) display="$1"; shift;; esac; done

if [ "$gate1" = 1 ]; then
  existing=$(compgen -G "$DK_ROOT/tasks/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$short" | tail -1 || true); [ -n "$existing" ] || dk_die "no task $short"
  DK_TASK_DIR="$existing"; export DK_TASK_DIR; dk_task_env
  # 關卡①的三道閘。計畫審查與 dk-brief-check 同一層，但只有這一道是機械擋得住的 ——
  # 「改完 brief 有沒有重跑 dk-brief-check」到了這裡已經分辨不出來，那條只寫在 SKILL 裡。
  p="$existing/process.md"
  grep -Eq '^[^ ]+ brief-review (verdict|skipped:)' "$p" \
    || dk_die "關卡①：process.md 沒有計畫審查的結果。跑 dk-brief-review 並在收齊後記 dk-process \"brief-review verdict p1: … / p2: …\"；真的不審就記 dk-process \"brief-review skipped: <理由>\""
  # process.md 是 append-only：verdict 之後可能又補了一行 skipped（例如派完才熔斷），
  # 這時最新的決定是「跳過」而不是那份陳舊的 verdict，逐別名檢查要看最後一行決定，
  # 不能看最後一行 verdict——否則閘 1 放行、閘 2 卻拿舊 verdict 去挑錯，兩道閘互相矛盾。
  last=$(grep -E '^[^ ]+ brief-review (verdict|skipped:)' "$p" | tail -1)
  # 判斷「最後一行決定是不是 verdict」要重新錨定去比對 $last 本身，不能用
  # `case ... *" brief-review verdict"*)` 這種子字串比對——skipped 行的自由文字
  # 只要剛好提到這幾個字（例如理由寫「忘記寫 brief-review verdict」）就會誤判成
  # verdict，逐別名檢查對 skipped 的自由文字當然找不到 token，等於把兩道閘互相
  # 矛盾的死結用另一種觸發條件裝回去。
  if printf '%s\n' "$last" | grep -Eq '^[^ ]+ brief-review verdict'; then   # 派了三個 kind 卻只讀一個的意見，等於第二意見白花（同 dk-wave-close 的 gate a2）
    for al in $(grep -E '^[^ ]+ brief-review spawned ' "$p" | tail -1 | grep -oE 'reviewer-p[0-9]+' | sed 's/reviewer-//' | sort -u); do
      case "$last" in *"$al:"*) ;;
        *) dk_die "brief-review verdict 沒有交代 reviewer $al（寫它的結果，或 '$al: skipped (<理由>)'）";; esac
    done
  fi
  live=$(grep -oE "^$DK_SHORT-reviewer-p[0-9]+" "$existing/.panes" 2>/dev/null | sort -u | tr '\n' ' ' || true)
  [ -z "${live// /}" ] || dk_die "計畫審查的 pane 還開著：${live% } —— 先 dk-wave-close --agent <agent> 逐個關掉。留著它們會佔版面格子、被守望當活人算逾時，而且第一波的 dk-wave-close 會因為它們沒 done 而永遠關不掉。"
  dk_process "gate1 approved"
  dk_index_set "$DK_DISPLAY" running "—" || echo "dk-task-new: INDEX 沒有名稱為「$DK_DISPLAY」的列；狀態沒更新，請自己改 $DK_ROOT/tasks/INDEX.md" >&2
  exit 0
fi
[ -n "$display" ] || dk_die "display name required"
[[ "$display" != *[\"\$\`\\]* ]] || dk_die "display name must not contain \" \$ \` or backslash"
# DK_REPOS 的便宜三項：名字合法且唯一、第一個是主 repo、每個路徑是 git 根。三項都只看設定與
# 磁碟佈局，不看工作樹狀態，所以在建任何東西之前就驗（早失敗）。「工作樹乾淨」是 --no-clean
# 跳掉的那一項 —— 計畫可能拖幾天，乾不乾淨要以 dk-leader --run 真的要從 HEAD 切 worktree
# 的那一刻為準，不是現在。
dk_settings
dk_repos_check --no-clean
date=$(dk_today); name="$date-$short"; dir="$DK_ROOT/tasks/$name"
[ ! -e "$dir" ] || dk_die "task exists: $dir"
ls -d "$DK_ROOT/tasks/"[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-"$short" >/dev/null 2>&1 && dk_die "short name '$short' already used"

# 0.10.0：這裡只建任務資料夾。worktree、分支、herdr tab 與依賴鉤子全都延到
# `/dkbo-run` 的 `dk-leader <short> --run`（plan.md 決策①③）—— 計畫完可能不做，不先付成本；
# base sha 也以交棒當下的 HEAD 為準，計畫拖幾天才開工時那才是對的起點。
branch="dk/$short"
ws="${HERDR_WORKSPACE_ID:-}"; root_pane="${HERDR_PANE_ID:-}"   # 人的 workspace 與 pane；計畫階段的 reviewer 填在這裡的右側
rollback() { # 後面任一步死掉都不該留下半寫的任務資料夾或綁定
  rm -rf "$dir"; [ -z "${HERDR_PANE_ID:-}" ] || rm -f "$DK_ROOT/.sessions/$HERDR_PANE_ID"
}
trap rollback EXIT

mkdir -p "$dir/state"; : > "$dir/.panes"   # dk-watch exits when this file disappears (dk-task-close removes it)
no_wt=""; [ "$worktree" = 1 ] || no_wt=1   # --run 讀它：不切 worktree，DK_WORKTREE 指主樹（多 repo 模式下拒絕）
vars=("DISPLAY=$display" "SHORT=$short" "BRANCH=$branch" "WORKTREE=" "SOURCE=$from" "DATE=$(dk_now)" \
      "WORKSPACE=$ws" "TASK_TAB=" "ROOT_PANE=$root_pane" "LEADER_PANE=$root_pane" "BASE=" "NO_WORKTREE=$no_wt")
# brief 的標頭是給人看的，寫成一句話而不是空白 —— 空白會讀成「忘了填」
dk_render "$DK_ROOT/templates/brief.md"   "WORKTREE=（/dkbo-run 交棒時建立）" "${vars[@]}" > "$dir/brief.md"
dk_render "$DK_ROOT/templates/process.md" "${vars[@]}" > "$dir/process.md"
dk_render "$DK_ROOT/templates/task.env"   "${vars[@]}" > "$dir/.task.env"
if [ -f "$from" ]; then cp "$from" "$dir/request.md"      # --from 指向真的檔案：逐字複製，不是塞路徑
else dk_render "$DK_ROOT/templates/request.md" "${vars[@]}" > "$dir/request.md"; fi
: > "$dir/messages.log"
mkdir -p "$DK_ROOT/.sessions"; echo "$name" > "$DK_ROOT/.sessions/${HERDR_PANE_ID:?}"

pane_agent_name() { herdr agent get "$1" 2>/dev/null | dk_json '.result.agent.name // empty' || true; }
current=$(pane_agent_name "$HERDR_PANE_ID")
# 條件是「還不叫 leader-<short>」而不是「完全沒名字」：pane 只要曾被命名過就跳過 rename 的話，
# dk_leader_name 算出的目標根本不存在，員工的 dk-msg leader 與 dk-watch 推送會靜默全滅。
if [ "$current" != "leader-$short" ]; then
  if ! herdr agent rename "$HERDR_PANE_ID" "leader-$short" >/dev/null; then
    echo "dk-task-new: agent rename failed (pane without agent?)" >&2
    dk_process "rename failed (pane without agent?)"
  elif [ "$(pane_agent_name "$HERDR_PANE_ID")" != "leader-$short" ]; then
    # rc=0 不等於生效：panova2/sportswitch 的領導 pane 是人手開的 claude，這行回了成功、
    # process.md 一片乾淨，而整場 12 筆訊息全打在一個不存在的 leader-<short> 上。
    # dk-msg 的 pane id 退路接得住，但領導得知道自己是靠退路在跑。
    echo "dk-task-new: agent rename reported success but the pane is still not leader-$short; dk-msg will fall back to $HERDR_PANE_ID" >&2
    dk_process "rename 沒生效（herdr 回成功但名字沒變）；訊息改走 pane id $HERDR_PANE_ID"
  fi
fi
dk_index_add "$date" "$display" task planning "—"
trap - EXIT   # task fully recorded

if [ -x "$DK_ROOT/bin/dk-watch" ] && [ -z "${DK_NO_WATCH:-}" ]; then
  # 第一對守望（輪詢＋訂閱）也走 --ensure：setsid、watch.log、鎖跟之後每次叫回同一條路，兩個 pid
  # 由它落進 .task.env。自己 nohup 起的話，只要這一對活著，之後的 --ensure 都判 running，任務從建立
  # 到第一次死亡跑的都是沒有 setsid 保護、stderr 丟 /dev/null 的舊守望（rest 波 1 審查 Important 1）。
  # close fd 3 and stdin so bats/herdr never wait on the detached watcher；stdout 關掉：本腳本只印任務目錄
  DK_TASK_DIR="$dir" "$DK_ROOT/bin/dk-watch" --ensure </dev/null >/dev/null 2>&1 3>&- || true
fi
echo "$dir"
