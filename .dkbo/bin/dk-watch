#!/usr/bin/env bash
# dk-watch [--once] [--interval SEC] [--ensure]           — blocked + reviewer-timeout watcher for the bound task
# dk-watch --events [--once] [--ensure]                   — herdr 事件訂閱器：畫面一出現審批／額度就當場處理
# dk-watch --chores [--once] [--interval SEC] [--ensure]  — blocked watcher for the running chores (no task binding)
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"; . "$DK_ROOT/lib/herdr.sh"; . "$DK_ROOT/lib/kinds.sh"
once=0; interval=""; ensure=0; chores=0; events=0
while [ $# -gt 0 ]; do case "$1" in
  --once) once=1; shift;; --interval) interval="$2"; shift 2;;
  --ensure) ensure=1; shift;; --chores) chores=1; shift;; --events) events=1; shift;;
  *) dk_die "unknown flag $1";; esac; done
[ -n "$interval" ] || { if [ "$events" = 1 ]; then interval=2; else interval=30; fi; }
cdir="$DK_ROOT/tasks/_chores"                       # chore mode: no .task.env, so pid and markers live in
cmark="$DK_ROOT/.sessions/chores.blocked"           # .sessions, which is gitignored and already holds transient state
cpid="$DK_ROOT/.sessions/chores.watch.pid"
crdir="$DK_ROOT/.sessions/chores"                   # 一件雜務一個記錄檔；存在 ⟺ 它還在跑
alive() { [[ "${1:-}" =~ ^[0-9]+$ ]] && ps -p "$1" -o args= 2>/dev/null | grep -q "${2:-dk-watch}"; }
# the full command line, not kill -0: pids get recycled and kill -0 would call a stranger alive

if [ "$chores" = 1 ] && [ "$ensure" = 1 ]; then   # idempotent start; the last chore closing lets it exit on its own
  [ -z "${DK_NO_WATCH:-}" ] || { echo "watch: disabled (DK_NO_WATCH)"; exit 0; }
  pid=$(cat "$cpid" 2>/dev/null || true)
  if alive "$pid" 'dk-watch.*--chores'; then echo "watch: chores running (pid $pid)"; exit 0; fi
  mkdir -p "$(dirname "$cpid")"
  nohup "$DK_ROOT/bin/dk-watch" --chores </dev/null >/dev/null 2>&1 3>&- &
  pid=$!; echo "$pid" > "$cpid"
  echo "watch: chores started (pid $pid)"; exit 0
fi

if [ "$chores" = 0 ]; then dir=$(dk_task_dir); DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env; fi
dk_settings
thr="${DK_BLOCK_SEC:-60}"

ensure_events() { # 訂閱器與輪詢是兩條獨立的命脈，各自 ensure：一條死掉另一條還在
  [ -z "${DK_NO_WATCH:-}" ] || { echo "events: disabled (DK_NO_WATCH)"; return 0; }
  if alive "${DK_EVENTS_PID:-}" 'dk-watch.*--events'; then echo "events: running (pid $DK_EVENTS_PID)"; return 0; fi
  DK_TASK_DIR="$dir" nohup "$DK_ROOT/bin/dk-watch" --events </dev/null >/dev/null 2>&1 3>&- &
  new=$!
  dk_env_set DK_EVENTS_PID "$new"; dk_process "events started (pid $new)"
  echo "events: started (pid $new)"
}

if [ "$events" = 1 ] && [ "$ensure" = 1 ]; then ensure_events; exit 0; fi

if [ "$ensure" = 1 ]; then   # idempotent start: the safety net must not disappear silently
  [ -z "${DK_NO_WATCH:-}" ] || { echo "watch: disabled (DK_NO_WATCH)"; exit 0; }
  if alive "${DK_WATCH_PID:-}" 'dk-watch$'; then echo "watch: running (pid $DK_WATCH_PID)"; ensure_events; exit 0; fi
  DK_TASK_DIR="$dir" nohup "$DK_ROOT/bin/dk-watch" </dev/null >/dev/null 2>&1 3>&- &
  new=$!
  dk_env_set DK_WATCH_PID "$new"; dk_process "watch restarted (pid $new)"
  echo "watch: restarted (pid $new)"; ensure_events; exit 0
fi

agent_status() { printf '%s' "$2" | jq -r --arg a "$1" '(.result.agents // [])[] | select(.name==$a) | .agent_status' 2>/dev/null | head -1 || true; }

# 送給領導的提示必須先等它閒下來：守望觸發的前提正是領導忙著，而「提示送給 working 的 agent
# 會排隊還是被丟掉」在三個 kind 上都還是 unknown。等待要有界，否則背景迴圈會被卡住；沒送到就
# 不寫 delivered，下一 tick 重試。桌面通知與熔斷不受影響，各自只做一次。
# fallback 是 pane id。leader-<short> 靠 dk-task-new 的 rename 生出來，而那一步在 panova2 回了
# rc=0 卻沒生效 —— herdr 從此回 agent_not_found，守望的 BLOCKED／TIMEOUT 三個出口一起靜默失效，
# 標記檔永遠等不到 delivered。pane id 不靠 rename，是唯一不會掉的把手。
notify_leader() { # target fallback text — bounded wait for idle, then prompt; non-zero when it did not land
  local target="${1:-}" fb="${2:-}" text="$3"
  _deliver() {
    [ -n "$1" ] || return 1
    herdr agent wait "$1" --until idle --until "done" --timeout "${DK_WATCH_WAIT_MS:-5000}" >/dev/null 2>&1 </dev/null \
      && herdr agent prompt "$1" "$text" >/dev/null 2>&1 </dev/null
  }
  _deliver "$target" && return 0
  [ -n "$fb" ] && [ "$fb" != "$target" ] && _deliver "$fb"
}

# --- 卡住的三種樣子，與它們共用的處理 ---------------------------------------------
# herdr 回報的 agent_status 只認得出一部分（claude 的審批），agy 的審批與 codex 的額度
# 在它眼裡都是 idle。所以真正的判斷跑在畫面文字上，agent_status 退成第二訊號。

agent_kind() { # agent → 它 spawn 時的 kind；process.md 是唯一記著這件事的地方
  sed -n "s/^[^ ]* spawn $1 (\([a-z0-9_-]*\) .*/\1/p" "$dir/process.md" 2>/dev/null | tail -1 || true
}
pane_text() { # agent → 畫面純文字。herdr 失敗或 pane 已關時回空字串（＝什麼都不觸發）
  local raw txt
  raw=$(herdr agent read "$1" --lines "${DK_READ_LINES:-30}" 2>/dev/null </dev/null || true)
  txt=$(printf '%s' "$raw" | jq -r '.result.read.text // .result.text // empty' 2>/dev/null || true)
  printf '%s' "${txt:-$raw}"
}
screen_hits() { # TEXT RE — 空 TEXT 一律不算命中
  [ -n "$1" ] || return 1
  printf '%s' "$1" | grep -qiE "$2"
}

handle_block() { # agent immediate — immediate=1 時不等 DK_BLOCK_SEC：畫面上有審批 UI 是
  # 確定的事實，不是狀態機的推測，沒有理由再壓 60 秒才說
  local agent="$1" m since
  m="$dir/.blocked/$agent"
  if [ ! -f "$m" ]; then
    echo "$now" > "$m"
    [ "${2:-0}" = 1 ] || return 0
  fi
  grep -q '^delivered$' "$m" && return 0
  since=$(head -1 "$m")
  [ "${2:-0}" = 1 ] || [ $((now - since)) -ge "$thr" ] || return 0
  if ! grep -q '^notified$' "$m"; then
    herdr notification show "dkbo: $agent blocked" --body "需要人按審批" --sound request >/dev/null 2>&1 </dev/null || true
    dk_process "blocked $agent"; echo notified >> "$m"
  fi
  if notify_leader "$(dk_leader_name)" "${DK_ROOT_PANE:-}" "[BLOCKED] from dk-watch: $agent 卡在審批"; then echo delivered >> "$m"; fi
}

handle_limit() { # agent — 撞額度。不必等 DK_REVIEW_TIMEOUT_MIN：那行字在撞到的當下就在畫面上了
  local agent="$1" kind m
  m="$dir/.blocked/$agent.limit"
  if [ ! -f "$m" ]; then
    kind=$(agent_kind "$agent")
    herdr notification show "dkbo: $agent limit" --body "撞額度，該 kind 已熔斷" --sound request >/dev/null 2>&1 </dev/null || true
    # 熔斷不等領導：任務狀態已經變了，領導收不收得到訊息都一樣成立（同 timeout 的理由）
    if [ -n "$kind" ] && [[ " ${DK_KIND_DOWN:-} " != *" $kind "* ]]; then
      DK_KIND_DOWN="${DK_KIND_DOWN:+$DK_KIND_DOWN }$kind"; dk_env_set DK_KIND_DOWN "$DK_KIND_DOWN"
    fi
    dk_process "limit $agent → kind ${kind:-?} down"
    echo notified > "$m"
  fi
  grep -q '^delivered$' "$m" && return 0
  if notify_leader "$(dk_leader_name)" "${DK_ROOT_PANE:-}" "[LIMIT] from dk-watch: $agent 撞額度"; then echo delivered >> "$m"; fi
}

assess() { # agent — 讀一次畫面並處理。回 0 表示畫面說了話（卡審批或撞額度）
  local txt kind
  txt=$(pane_text "$1"); [ -n "$txt" ] || return 1
  kind=$(agent_kind "$1")
  # 額度優先於審批：兩種字樣同時在畫面上時，擋住去路的是額度
  if screen_hits "$txt" "$(dk_kind_re "$kind" quota)"; then handle_limit "$1"; return 0; fi
  if screen_hits "$txt" "$(dk_kind_re "$kind" block)"; then handle_block "$1" 1; return 0; fi
  return 1
}

chore_tick() {   # chores have no reviewers and no waves: blocked detection only
  local now list rec agent leader st m since
  compgen -G "$crdir/*" >/dev/null 2>&1 || exit 0   # 最後一件雜務關掉了，守望自己退
  now=$(date +%s); list=$(dk_h_soft agent list) || return 0
  mkdir -p "$cmark"
  for rec in "$crdir"/*; do
    agent=$(basename "$rec"); leader=$(sed -n 's/^leader=//p' "$rec" | head -1)
    st=$(agent_status "$agent" "$list")
    m="$cmark/$agent"
    if [ "$st" = blocked ]; then
      if [ ! -f "$m" ]; then echo "$now" > "$m"; continue; fi
      grep -q '^delivered$' "$m" && continue
      since=$(head -1 "$m")
      if [ $((now - since)) -ge "$thr" ]; then
        if ! grep -q '^notified$' "$m"; then
          herdr notification show "dkbo: $agent blocked" --body "雜務員工卡在審批" --sound request >/dev/null 2>&1 </dev/null || true
          echo notified >> "$m"
        fi
        if notify_leader "$leader" "" "[BLOCKED] from dk-watch: $agent 卡在審批"; then
          echo "$(dk_now) dk-watch -> $leader [BLOCKED] $agent 卡在審批" >> "$cdir/messages.log"
          echo delivered >> "$m"
        fi
      fi
    else rm -f "$m"; fi
  done
}

tick() {
  [ -f "$dir/.panes" ] || exit 0
  local now list; now=$(date +%s); list=$(dk_h_soft agent list) || return 0
  mkdir -p "$dir/.blocked"
  while read -r agent _pane; do
    [ -n "$agent" ] || continue
    if assess "$agent"; then continue; fi          # 畫面上有審批／額度：當場處理，不必等門檻
    st=$(agent_status "$agent" "$list")
    if [ "$st" = blocked ]; then handle_block "$agent" 0   # herdr 說它卡了但畫面沒佐證：給一個門檻的緩衝
    else rm -f "$dir/.blocked/$agent"; fi                  # .limit 不在這裡清：額度不會自己好
  done < "$dir/.panes"
  dk_task_env   # pick up DK_KIND_DOWN changes made since the watcher started (settings.env is read once at start)
  while read -r agent _pane epoch group _; do   # reviewer timeout (spec §3.2)
    [ "${group:-}" = review ] && [[ "$agent" == *-reviewer-* || "$agent" == *-reviewer ]] && [[ "${epoch:-}" =~ ^[0-9]+$ ]] || continue
    m="$dir/.blocked/$agent.timeout"
    if [ -f "$m" ]; then
      grep -q '^delivered$' "$m" && continue   # 已送達；否則落到下面重試
    else
      sf="$dir/state/${agent#"$DK_SHORT"-}.md"; if [ -f "$sf" ] && grep -q '^status: done' "$sf"; then continue; fi
      [ $((now - epoch)) -gt $((DK_REVIEW_TIMEOUT_MIN * 60)) ] || continue
      txt=$(pane_text "$agent")
      kind=$(agent_kind "$agent")
      # 它不是掛了，是在等人按一下 —— 主迴圈的 assess 已經送過 [BLOCKED]，這裡只要不熔斷
      screen_hits "$txt" "$(dk_kind_re "$kind" block)" && continue
      tag=""; printf '%s' "$txt" | grep -qiE 'rate limit|quota|429|usage limit' && tag=" (quota?)"
      herdr notification show "dkbo: $agent timeout" --body "reviewer 逾時${tag}，該 kind 已熔斷" --sound request >/dev/null 2>&1 </dev/null || true
      # 熔斷與事件紀錄不等領導：這是任務狀態的改變，領導收不收得到訊息都一樣成立
      if [ -n "$kind" ] && [[ " ${DK_KIND_DOWN:-} " != *" $kind "* ]]; then
        DK_KIND_DOWN="${DK_KIND_DOWN:+$DK_KIND_DOWN }$kind"; dk_env_set DK_KIND_DOWN "$DK_KIND_DOWN"
      fi
      dk_process "timeout $agent$tag → kind ${kind:-?} down"
      { echo notified; echo "tag=$tag"; } > "$m"   # tag 留著，重試時訊息才一致
    fi
    tag=$(sed -n 's/^tag=//p' "$m" | head -1)
    if notify_leader "$(dk_leader_name)" "${DK_ROOT_PANE:-}" "[TIMEOUT] from dk-watch: $agent 逾時${tag}"; then echo delivered >> "$m"; fi
  done < "$dir/.panes"

  # 整波逾時：員工沒 blocked、reviewer 也沒逾時，但這一波就是卡著不動的情況
  if [ -n "${DK_WAVE:-}" ] && [[ "${DK_WAVE_TIMEOUT_MIN:-0}" =~ ^[0-9]+$ ]] && [ "${DK_WAVE_TIMEOUT_MIN:-0}" -gt 0 ] \
     && [[ "${DK_WAVE_STARTED:-}" =~ ^[0-9]+$ ]] && [ $((now - DK_WAVE_STARTED)) -gt $((DK_WAVE_TIMEOUT_MIN * 60)) ]; then
    m="$dir/.blocked/wave-$DK_WAVE.timeout"
    if ! { [ -f "$m" ] && grep -q '^delivered$' "$m"; }; then
      if [ ! -f "$m" ]; then
        herdr notification show "dkbo: wave $DK_WAVE timeout" --body "整波超過 $DK_WAVE_TIMEOUT_MIN 分鐘" --sound request >/dev/null 2>&1 </dev/null || true
        dk_process "timeout wave $DK_WAVE (${DK_WAVE_TIMEOUT_MIN}min)"
        echo notified > "$m"
      fi
      if notify_leader "$(dk_leader_name)" "${DK_ROOT_PANE:-}" "[TIMEOUT] from dk-watch: wave $DK_WAVE 超過 $DK_WAVE_TIMEOUT_MIN 分鐘未收尾"; then echo delivered >> "$m"; fi
    fi
  fi
}

events_arm() { # agent pane — 等這個 pane 的畫面冒出審批或額度。等不到就安靜回來
  local agent="$1" pane="$2" kind re
  kind=$(agent_kind "$agent")
  re="(?i)$(dk_kind_re "$kind" block)|$(dk_kind_re "$kind" quota)"
  herdr pane wait-output "$pane" --regex "$re" --source recent --lines "${DK_READ_LINES:-30}" \
    --timeout "${DK_EVENT_WAIT_MS:-30000}" >/dev/null 2>&1 </dev/null || return 0
  # 命中了才回頭讀整個畫面：matched_line 只有一行，分不出額度與審批誰擋在前面
  assess "$agent"
}

events_tick() { # 一輪訂閱：每個 pane 一個等待者，誰先命中誰先被處理
  [ -f "$dir/.panes" ] || exit 0
  local agent pane
  now=$(date +%s); mkdir -p "$dir/.blocked"
  dk_task_env   # DK_KIND_DOWN 可能被上一輪或輪詢那邊改過
  while read -r agent pane _; do
    [ -n "$agent" ] && [ -n "$pane" ] || continue
    events_arm "$agent" "$pane" &
  done < "$dir/.panes"
  wait
}

run() { if [ "$chores" = 1 ]; then chore_tick; elif [ "$events" = 1 ]; then events_tick; else tick; fi; }
if [ "$once" = 1 ]; then run; exit 0; fi
while :; do run; sleep "$interval"; done
