#!/usr/bin/env bash
# dk-review-pack [N] | dk-review-pack --task — write tasks/<t>/waves/N.diff (or task.diff) for reviewers; prints the path.
# Includes uncommitted and untracked work in the worktree via a throwaway index (the employees' real index is untouched).
# 多 repo：一份檔、每個有變更的 repo 一段「## repo <名>」（決策⑩）——reviewer 仍然只讀一個檔。
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"; . "$DK_ROOT/lib/repos.sh"
dir=$(dk_task_dir); DK_TASK_DIR="$dir"; export DK_TASK_DIR; dk_task_env; dk_settings
mode=wave; n=""
if [ "${1:-}" = --task ]; then
  [ -n "${DK_BASE:-}" ] || dk_die "no DK_BASE in .task.env (legacy task); pass a wave number instead"
  mode=task; base="$DK_BASE"; out="$dir/waves/task.diff"; label="task $DK_SHORT, whole branch since ${base:0:7}"
else
  n="${1:-${DK_WAVE:-}}"; [[ "$n" =~ ^[0-9]+$ ]] || dk_die "usage: dk-review-pack [N] | --task  (no wave is open)"
  base=$(dk_wave_base "$dir" "$n")
  [ -n "$base" ] || dk_die "no 'wave-open $n base <sha>' line in process.md"
  out="$dir/waves/$n.diff"; label="wave $n since ${base:0:7}"
fi
mkdir -p "$dir/waves"
idx=$(mktemp); body=$(mktemp); trap 'rm -f "$idx" "$body"' EXIT
# 沒有 .repos 的是 0.9.2 之前建立的任務：退回單列（名字 main、路徑 DK_WORKTREE、base 就是上面算好的那個）
rows=$(dk_repos_rows "$dir" 2>/dev/null || true)
[ -n "$rows" ] || rows="main $DK_PROJECT_ROOT $DK_WORKTREE $base"
mainrepo=$(printf '%s\n' "$rows" | awk 'NR==1{print $1}')
multi=0; dk_repos_multi && multi=1
total=0
while read -r rname _rroot rwt rbase; do
  [ -n "$rname" ] && [ -n "${rwt:-}" ] && [ -d "$rwt" ] || continue
  if [ "$mode" = task ]; then
    b="$rbase"; [ -n "$b" ] || b="$base"        # --task：每個 repo 從它被實體化的那一刻算起
  else
    b=$(dk_wave_base "$dir" "$n" "$rname")       # 逐 repo 那一行
    # 用 if 不用 `[ … ] || { … && … ; }`：AND 群組為假時整個 OR 列回非零，set -e 會當場退出
    if [ -z "$b" ] && [ "$rname" = "$mainrepo" ]; then b="$base"; fi   # 主 repo 退回 0.9.2 那一行
    [ -n "$b" ] || b="$rbase"                    # 那一波沒開過：退回 .repos 記的實體化 sha
  fi
  [ -n "$b" ] || continue
  : > "$idx"
  GIT_INDEX_FILE="$idx" git -C "$rwt" read-tree HEAD
  GIT_INDEX_FILE="$idx" git -C "$rwt" add -A
  c=$(GIT_INDEX_FILE="$idx" git -C "$rwt" diff --cached --name-only "$b" | wc -l)
  total=$((total + c))
  [ "$c" -gt 0 ] || continue
  {
    [ "$multi" = 0 ] || { echo "## repo $rname"; echo; }
    echo "## commits"; git -C "$rwt" log --oneline "$b..HEAD"; echo
    echo "## stat"; GIT_INDEX_FILE="$idx" git -C "$rwt" diff --cached --stat "$b"; echo
    echo "## diff (-U10)"; GIT_INDEX_FILE="$idx" git -C "$rwt" -c core.quotePath=false diff --cached -U10 "$b"; echo
  } >> "$body"
done <<< "$rows"
{
  echo "# $DK_DISPLAY — $label — $(dk_now)"; echo "# files changed: $total (working tree included)"; echo
  cat "$body"
} > "$out"
[ "$total" -gt 0 ] || echo "dk-review-pack: no changes since ${base:0:7}; $out holds only the header" >&2
echo "$out"
