# dkbo 設定。/dkbo-init 會改寫這裡的值；bash 可直接 source，所有值都要加引號。
# DK_TEST_CMD 在任務 worktree 執行：先補 node_modules／.env.local symlink（gitignore，worktree 沒有），
# 再直呼 node_modules/.bin（pnpm 11 認不得 symlink 的 node_modules，會想 purge；理由見 .claude/hooks/_common.sh）。
DK_TEST_CMD="M=\$(git rev-parse --git-common-dir); M=\${M%/.git}; [ -e node_modules ] || ln -s \"\$M/node_modules\" node_modules; [ -e .env.local ] || { [ -f \"\$M/.env.local\" ] && ln -s \"\$M/.env.local\" .env.local; }; node_modules/.bin/eslint . && node_modules/.bin/tsc -b --noEmit && node_modules/.bin/vitest run"
DK_REVIEW_KINDS="claude codex agy"   # 每波審查：claude 主審，codex、agy 第二三意見（agy 免費額度，沒額度就熔斷不補）
DK_REVIEW_MIN="2"               # 至少幾位 reviewer 意見回來才算審查完成（2＝不同模型的第二意見一定要進裁定）
DK_REVIEW_TIMEOUT_MIN="20"      # reviewer 逾時分鐘（dk-watch 用）
DK_TAB1_SLOTS="4"               # tab 1 右側可放的員工格數（4 = 2×2，6 = 3×2）
DK_LEADER_KIND="claude"         # 領導這一側的 AI CLI（claude / codex / agy）；dk-leader 用它的 L 檔
DK_WAVE_TIMEOUT_MIN="60"        # 整波逾時分鐘（dk-watch 用）；0 表示關閉
DK_REVIEW_TIER="L"              # reviewer 檔位（0.4.0 新增的第八鍵）：claude=opus/high、codex=gpt-5.5/high、
                                # agy=gemini-3.1-pro/high。審查最吃推理而 reviewer 唯讀單輪，加碼成本遠低於 dev pane。
                                # 要加碼改這裡，不要動 roles/reviewer.md 的 tier 定義。
