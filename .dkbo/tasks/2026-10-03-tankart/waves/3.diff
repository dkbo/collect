+import { describe, expect, it } from 'vitest'
+import {
+  CARD_HOLD_MS,
+  CARD_LEAVE_MS,
+  CARD_POP_MS,
+  EXPIRY_WARN_MS,
+  FLASH_ALPHA,
+  INVULN_DIM,
+  SHAKE_AMP,
+  SHAKE_MS,
+  SHIELD_BREAK_MS,
+  SHIELD_FADE_MS,
+  STREAK_WINDOW_MS,
