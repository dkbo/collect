+    this.chips.push({
+      key: this.chipSeq++,
+      x: c.x,
+      y: c.y,
+      z: c.z,
+      vx: c.vx,
+      vy: c.vy,
+      vz: c.vz,
+      yaw: fxRandom() * Math.PI * 2,
+      pitch: fxRandom() * Math.PI,
+      spin: (fxRandom() * 2 - 1) * 14,
+      sx: c.sx,
+      sy: c.sy,
+      sz: c.sz,
+      rgba: rgba(c.hex),
+      born: c.now,
+      life: c.life,
