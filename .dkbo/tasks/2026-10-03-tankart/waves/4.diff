+#!/usr/bin/env node
+// 波 4 幽靈反彈判定：play.mjs --mp 的 JSON（A=host、B=guest）。按局（A 端 countdown 起點牆鐘）切，
+// 每發子彈比兩端取樣到的最大反彈次數；guest > host 且 host 那一局沒送過該彈的 bounce → 幽靈反彈。
+// 用法：node scripts/qa/tankart/ghostbounce.mjs <play 輸出.json>
+import { readFileSync } from 'node:fs'
+const r = JSON.parse(readFileSync(process.argv[2], 'utf8'))
+const [A, B] = r.contexts.map((c) => c.samples)
+const starts = []; let prev = null
+for (const s of A) { const ph = s.d.__BATTLE_PHASE; if (ph === 'countdown' && prev !== 'countdown') starts.push(s.w); prev = ph }
+const roundOf = (w) => { let i = -1; for (const [j, t] of starts.entries()) if (w >= t - 1500) i = j; return i }
+const bounces = (S) => { const m = new Map(); for (const s of S) { if (!s.d.__TANK_STATE || s.d.__BATTLE_PHASE !== 'playing') continue; const rd = roundOf(s.w); for (const b of s.d.__TANK_STATE.bullets) { const k = `${rd}:${b.id}`; m.set(k, Math.max(m.get(k) ?? 0, b.bounces)) } } return m }
+const wireIds = (n, dir) => (n?.wire ?? []).filter((x) => x[2] === dir && /"type":"bounce"/.test(x[3])).map((x) => `${roundOf(x[1])}:${x[3].match(/"bulletId":"([^"]+)"/)?.[1]}`)
+const ha = bounces(A), gb = bounces(B)
+const sent = new Set(wireIds(r.net?.[0], 'S')), recv = wireIds(r.net?.[1], 'R')
+const common = [...gb.keys()].filter((k) => ha.has(k))
+const ghosts = [...gb.entries()].filter(([k, g]) => g > (ha.get(k) ?? 0) && !sent.has(k)).map(([k, g]) => ({ k, guest: g, host: ha.get(k) ?? null }))
+const errs = r.contexts.map((c) => ({ tag: c.tag, errors: c.errors.filter((e) => !/GL Driver Message/.test(e)), pageErrors: c.pageErrors }))
+console.log(JSON.stringify({ error: r.error ?? null, rounds: starts.length, guestBullets: gb.size, hostBullets: ha.size, common: common.length, guestBounced: [...gb.values()].filter(Boolean).length, bounceWireHostSent: sent.size, bounceWireGuestRecv: recv.length, ghostBounces: ghosts.length, ghosts, errors: errs }))
