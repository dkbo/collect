+// AC13 補強：B 每筆取樣對 A 前後兩筆做時間內插比 bot 位置；列出反彈次數不一致的子彈與其 wire 訊息
+import { readFileSync } from 'node:fs'
+const r = JSON.parse(readFileSync(process.argv[2], 'utf8'))
+const [A, B] = r.contexts.map((c) => c.samples.filter((s) => s.d.__TANK_STATE && s.d.__BATTLE_PHASE === 'playing'))
+const d = []
+for (const b of B) {
+  let i = A.findIndex((a) => a.w >= b.w); if (i <= 0) continue
+  const a0 = A[i - 1], a1 = A[i], span = a1.w - a0.w; if (span > 1500) continue
+  const k = (b.w - a0.w) / span
+  for (const e of b.d.__TANK_STATE.entities) {
+    if (!e.id.startsWith('bot') || !e.alive || e.x == null) continue
+    const p = a0.d.__TANK_STATE.entities.find((x) => x.id === e.id), q = a1.d.__TANK_STATE.entities.find((x) => x.id === e.id)
+    if (!p?.alive || !q?.alive) continue
+    d.push(Math.hypot(e.x - (p.x + (q.x - p.x) * k), e.z - (p.z + (q.z - p.z) * k)))
+  }
+}
+const qt = (a, p) => { const s = [...a].sort((x, y) => x - y); return s.length ? +s[Math.floor(p * (s.length - 1))].toFixed(2) : null }
+const bounces = (S) => { const m = new Map(); for (const s of S) for (const b of s.d.__TANK_STATE.bullets) m.set(b.id, Math.max(m.get(b.id) ?? 0, b.bounces)); return m }
+const ba = bounces(A), bb = bounces(B)
+const mism = [...ba.keys()].filter((k) => bb.has(k) && ba.get(k) !== bb.get(k)).map((k) => [k, ba.get(k), bb.get(k)])
+const wire = r.net.map((n) => (n?.wire ?? []).filter((x) => /"type":"bounce"/.test(x[3])).map((x) => x[3].match(/"bulletId":"([^"]+)"/)?.[1]))
+console.log(JSON.stringify({ botDistN: d.length, p50: qt(d, 0.5), p90: qt(d, 0.9), max: qt(d, 1), mismatched: mism, bounceWireHostSent: wire[0].length, bounceWireGuestRecv: wire[1].length, mismInWire: mism.map(([k]) => [k, wire[0].includes(k), wire[1].includes(k)]) }))
