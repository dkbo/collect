+  if (S.length < 5) continue
+  const o = { tag: c.tag, round: ri, samples: S.length, durS: Math.round((S.at(-1).t - S[0].t) / 1000), medianDtMs: S.slice(1).map((s, i) => s.t - S[i].t).sort((a, b) => a - b)[Math.floor(S.length / 2)] }
+  const first = S[0]?.d.__TANK_STATE
