+// 嚴格版幽靈子彈：guest 在 tg 仍有該彈，而 host 在 [tg-1000, tg-500] 有樣本且其中沒有該彈（host 已移除超過 0.5s，扣掉網路延遲）、且 host 先前看過它
+import { readFileSync } from 'node:fs'
+const r = JSON.parse(readFileSync(process.argv[2], 'utf8'))
+const [A, B] = r.contexts.map((c) => c.samples.filter((s) => s.d.__TANK_STATE && s.d.__BATTLE_PHASE === 'playing'))
+const ghosts = new Map()
+for (const g of B) for (const b of g.d.__TANK_STATE.bullets) {
+  const win = A.filter((h) => h.w >= g.w - 1000 && h.w <= g.w - 500)
+  if (!win.length || win.some((h) => h.d.__TANK_STATE.bullets.some((x) => x.id === b.id))) continue
+  const seenBefore = A.some((h) => h.w < g.w - 1000 && h.w > g.w - 2500 && h.d.__TANK_STATE.bullets.some((x) => x.id === b.id))
+  if (seenBefore) ghosts.set(`${b.id}@${Math.round(g.w / 1000)}`, true)
+}
+console.log(JSON.stringify({ guestSamples: B.length, ghosts: [...ghosts.keys()] }))
