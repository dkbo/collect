+// 兩端按局（以 A 端 countdown 起點的牆鐘切）比對每發子彈存活時間；guest 比 host 多活 >700ms 視為幽靈子彈
+import { readFileSync } from 'node:fs'
+const r = JSON.parse(readFileSync(process.argv[2], 'utf8'))
+const [A, B] = r.contexts.map((c) => c.samples)
+const starts = []; let prev = null
+for (const s of A) { const ph = s.d.__BATTLE_PHASE; if (ph === 'countdown' && prev !== 'countdown') starts.push(s.w); prev = ph }
+const roundOf = (w) => { let i = -1; for (const [j, t] of starts.entries()) if (w >= t - 1500) i = j; return i }
+const info = (S) => { const m = new Map(); for (const s of S) { if (!s.d.__TANK_STATE) continue; const rd = roundOf(s.w); for (const b of s.d.__TANK_STATE.bullets) { const k = `${rd}:${b.id}`; const x = m.get(k) ?? { first: s.w, last: s.w, n: 0, bounced: false, crates0: s.d.__TANK_STATE.crates }; x.last = s.w; x.n++; if (b.bounces) x.bounced = true; m.set(k, x) } } return m }
+const a = info(A), b = info(B)
+const ghosts = []
+for (const [k, y] of b) { const x = a.get(k); const hl = x ? x.last - x.first : 0; const gl = y.last - y.first; if (gl - hl > 700) ghosts.push({ k, hostLife: hl, guestLife: gl, hostSeen: !!x, guestBounced: y.bounced }) }
+const lives = [...b.values()].map((y) => y.last - y.first)
+console.log(JSON.stringify({ rounds: starts.length, guestBullets: b.size, hostBullets: a.size, ghosts, maxGuestLife: Math.max(...lives) }))
