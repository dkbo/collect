+ out.contexts.push({ tag: c.tag, pageErrors: c.pageErrors, errors: c.errors.filter((e) => !/GL Driver Message/.test(e)), info: c.info.length })
+ const rounds = []
+ let cur = null
+ for (const x of c.samples) {
+  const ph = x.d.__BATTLE_PHASE
