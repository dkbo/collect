+const [A, B] = r.contexts.map((c) => c.samples.filter((s) => s.d.__TANK_STATE && s.d.__BATTLE_PHASE === 'playing'))
+const near = (arr, w) => { let best = null; for (const s of arr) if (!best || Math.abs(s.w - w) < Math.abs(best.w - w)) best = s; return best }
+const o = { error: r.error ?? null, code: r.code, overlays: r.overlays, samples: [A.length, B.length], colorMismatch: 0, botDist: [], selfDist: [], shieldMismatch: 0, tripleMismatch: 0, aliveMismatch: 0, closedDiff: [], hpMismatch: 0 }
+for (const b of B) {
+  const a = near(A, b.w); if (!a || Math.abs(a.w - b.w) > 120) continue
+  const ea = a.d.__TANK_STATE.entities, eb = b.d.__TANK_STATE.entities
