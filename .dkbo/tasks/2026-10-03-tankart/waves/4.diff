+    const inv = []; let start = null
+    const hpDropInInv = []; const shieldBreaks = []; const knock = []; const illegal = []; const tripleShots = []
+    let tripleSeen = 0, shieldSeen = 0
+    for (let i = 0; i < E.length; i++) {
+      const { t, e } = E[i], p = E[i - 1]?.e
+      if (e.invuln && start === null) start = t
+      if (!e.invuln && start !== null) { inv.push(t - start); start = null }
+      if (p && e.hp < p.hp && p.invuln && E[i - 1].t - (start ?? t) > 300) hpDropInInv.push(t)
+      if (p && p.shield && !e.shield) shieldBreaks.push({ t, hpBefore: p.hp, hpAfter: e.hp, invulnAfter: e.invuln })
