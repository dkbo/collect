+/** 砲塔往目標角轉，最多 maxStep（取最短方向） */
+const rotateToward = (cur: number, target: number, maxStep: number): number => {
+  let d = (target - cur) % (Math.PI * 2)
+  if (d > Math.PI) d -= Math.PI * 2
+  if (d < -Math.PI) d += Math.PI * 2
+  return Math.abs(d) <= maxStep ? cur + d : cur + Math.sign(d) * maxStep
