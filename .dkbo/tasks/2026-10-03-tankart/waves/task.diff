+
+/** 無敵閃爍是否在亮相（spec §6：10Hz，暗相 visibility 0.35，見 fxModel.invulnVisibility）；到期後恆亮 */
+export const invulnBlinkOn = (now: number, until: number): boolean => invulnVisibility(now, until) === 1
