+}
+.tank-feed-icon {
+  @apply size-[15px] shrink-0 stroke-[2.5];
+}
+.tank-feed-kill {
+  @apply text-[#ff3b4e];
+}
+.tank-feed-wall {
+  @apply text-[#c23a33];
+}
+.tank-feed-chevron {
+  @apply size-[13px] shrink-0 stroke-[3] text-[#8a7a66];
+}
+
+/* 矮畫面用的頂部頭像膠囊（預設隱藏） */
+.tank-pills {
+  @apply absolute left-1/2 top-[max(6px,env(safe-area-inset-top))] hidden -translate-x-1/2 gap-1.5;
+}
+.tank-pill {
+  @apply relative flex h-[30px] items-center gap-1.5 rounded-full border-2 border-(--tank-ink) bg-(--tank-paper) pr-2 text-(--tank-ink) shadow-[0_3px_0_rgba(0,0,0,.4),inset_0_0_0_2px_var(--tc-base)];
+}
+.tank-pill-avatar {
+  @apply -my-1 size-[34px] shrink-0;
+}
+.tank-pill-stat {
+  @apply flex items-center gap-px font-['Fredoka',_var(--font-sans)] font-bold text-[12px] leading-none;
+}
+.tank-pill-icon {
+  @apply size-[11px] stroke-[2.5];
+}
+.tank-pill-hp {
+  @apply fill-[#ff5c8a] text-[#ff3b6a];
+}
+.tank-pill-kills {
+  @apply text-[#ff3b4e];
+}
+.tank-pill-buff {
+  @apply flex size-[13px] shrink-0 items-center justify-center rounded-full border border-(--tank-ink);
+}
+.tank-pill-buff-icon {
+  @apply size-[8px] stroke-[3];
+}
+.tank-pill-skull {
+  @apply absolute -right-1 -top-1 text-[13px] leading-none;
+}
+/* 護盾：青色外圈＋左上小盾 */
+.tank-pill-shield {
+  @apply outline-2 outline-offset-1 outline-[#39d5ff];
+}
+.tank-pill-shield-icon {
+  @apply absolute -left-1 -top-1 z-10 size-[14px] rounded-full bg-[#39d5ff] p-0.5 stroke-[2.5] text-white;
+}
+
+@keyframes tank-pulse {
+  0%, 100% { transform: scale(1); }
+  50% { transform: scale(1.08); }
+}
+@keyframes tank-feed-in {
+  from { opacity: 0; transform: translateX(16px); }
+  to { opacity: 1; transform: translateX(0); }
+}
+
+/* 矮畫面（手機橫向）：玩家卡改成頂部頭像膠囊，計時膠囊移到下方中央，擊殺通知移到全螢幕鈕下方 */
+@media (max-height: 500px) {
+  .tank-col {
+    @apply hidden;
+  }
+  .tank-pills {
+    @apply flex;
+  }
+  .tank-timer {
+    @apply top-auto bottom-[max(8px,env(safe-area-inset-bottom))] h-[34px] min-w-0 origin-bottom gap-2 px-3 [scale:1];
+  }
+  .tank-timer-text {
+    @apply text-[20px];
+  }
+  .tank-timer-sudden-text {
+    @apply text-[14px];
+  }
+  .tank-timer-icon {
+    @apply size-4;
+  }
+  .tank-timer-sep {
+    @apply h-4;
+  }
+  .tank-timer-alive {
+    @apply text-[12px];
+  }
+  .tank-feed {
+    @apply top-[calc(max(0.5rem,env(safe-area-inset-top))_+_2.25rem_+_6px)] right-[max(0.5rem,env(safe-area-inset-right))] [scale:0.85];
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tank-timer-urgent,
+  .tank-feed-item {
+    @apply animate-none;
+  }
+}
