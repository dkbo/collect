+    @apply text-[20px];
+  }
+  .bomber-timer-sudden-text {
+    @apply text-[14px];
+  }
+  .bomber-timer-icon {
+    @apply size-4;
+  }
+  .bomber-timer-sep {
+    @apply h-4;
+  }
+  .bomber-timer-alive {
+    @apply text-[12px];
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .bomber-timer-urgent {
+    animation: none;
+  }
+}
