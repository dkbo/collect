+#!/usr/bin/env node
+// kitchenart qa：比較兩份 vite 產物的 vendor-babylon-*.js 與 Battle-*.js（含其他遊戲相關 chunk）gzip 大小。
+// 用法：node scripts/qa/kitchenart/bundle.mjs <base dist> [<new dist>]；stdout JSON（位元組，gzip level 9 與 vite 報表同級）。
+import { readdirSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { gzipSync } from 'node:zlib'
+
+const measure = (dir) => {
+  const out = {}
+  for (const f of readdirSync(join(dir, 'assets')).filter((f) => f.endsWith('.js'))) {
+    const buf = readFileSync(join(dir, 'assets', f))
+    out[f] = { raw: buf.length, gzip: gzipSync(buf, { level: 9 }).length }
+  }
+  return out
+}
+const sum = (m, re) => Object.entries(m).filter(([f]) => re.test(f)).reduce((a, [, v]) => a + v.gzip, 0)
+const [baseDir, newDir] = process.argv.slice(2)
+const base = measure(baseDir)
+const res = { base: { vendorBabylon: sum(base, /^vendor-babylon-/), battle: sum(base, /^Battle-/) } }
+if (newDir) {
+  const next = measure(newDir)
+  const strip = (f) => f.replace(/-[\w-]{8}\.js$/, '')
+  const baseNames = new Set(Object.keys(base).map(strip))
+  res.newChunks = Object.keys(next).filter((f) => !baseNames.has(strip(f))).map((f) => ({ f, gzip: next[f].gzip }))
+  res.next = { vendorBabylon: sum(next, /^vendor-babylon-/), battle: sum(next, /^Battle-/) }
+  res.delta = { vendorBabylon: res.next.vendorBabylon - res.base.vendorBabylon, battle: res.next.battle - res.base.battle, newChunks: res.newChunks.reduce((a, c) => a + c.gzip, 0) }
+  res.pass = { vendorBabylon: res.delta.vendorBabylon <= 10240, battle: res.delta.battle + res.delta.newChunks <= 25600 }
+}
+console.log(JSON.stringify(res, null, 2))
