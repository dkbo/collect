+      data-kitchen-hud=""
+    >
+      <div className="kitchen-orders">
+        {hud.orders.map((o) => (
+          <OrderCard key={o.id} order={o} />
+        ))}
+        {leaving.map((l) => (
+          <LeavingCard key={`leave-${l.key}`} l={l} />
+        ))}
+      </div>
