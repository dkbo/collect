+
+function OrderCard({ order, leave }: { order: KitchenHudOrder; leave?: LeavingOrder['reason'] }) {
+  const level = orderLevel(order.remainMs)
+  const dish = KITCHEN_DISHES.find((d) => d.ing === order.ing)
