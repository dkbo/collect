+
+/** 廚房 HUD 的純呈現（無副作用，可在 node 靜態渲染自查） */
+export function KitchenHudView({ hud, leaving, scale = 1, recipeOpen = true, onToggleRecipe, rootRef }: KitchenHudViewProps) {
+  const clock = clockView(hud.remainSec)
+  return (
+    <div
