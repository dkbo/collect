+  }
+  .kitchen-clock {
+    @apply top-[max(6px,env(safe-area-inset-top))] h-[34px] w-[140px] gap-1.5 px-2.5 [scale:1];
+  }
+  .kitchen-clock-icon {
+    @apply size-4;
+  }
+  .kitchen-clock-text {
+    @apply text-[19px];
+  }
+  .kitchen-clock-sep {
+    @apply h-5;
+  }
+  .kitchen-clock-coins {
+    @apply size-[14px];
+  }
+  .kitchen-clock-points {
+    @apply text-[15px];
+  }
+  .kitchen-clock-served {
+    @apply text-[8px];
+  }
+  .kitchen-players {
+    @apply hidden;
+  }
+  .kitchen-recipe {
+    @apply top-[calc(max(6px,env(safe-area-inset-top))_+_42px)] right-[max(8px,env(safe-area-inset-right))] w-[44px] rounded-full [scale:1];
