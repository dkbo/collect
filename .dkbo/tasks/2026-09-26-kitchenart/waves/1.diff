+#!/usr/bin/env node
+// kitchenart qa：/battle 單人驅動。模式：
+//   bomber  — bomber 單人固定時點截圖（開局倒數、playing +1.5s、+6s），記 [data-bomber-hud]／[data-kitchen-hud] 節點
+//   ac2     — overcooked 單人：取菜→切→下鍋→煮好後 ~0.8s 取湯（快焦窗口內）→出餐，score>0 即 AC2 通過
+// 用法：node scripts/qa/kitchenart/kitchen.mjs <mode> <base 例 http://localhost:5174/collect/> <out 前綴> [--qs 'a=1&b=2'] [--w 1920 --h 1080]
+// stdout：JSON summary（截圖、consoleErrors、pageErrors、事件證據）。截圖只寫 out 前綴（放 scratchpad）。
+import { existsSync, readdirSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+const [MODE, BASE, OUT] = process.argv.slice(2)
+const opt = (k, d) => { const i = process.argv.indexOf(`--${k}`); return i > 0 ? process.argv[i + 1] : d }
+const QS = opt('qs', '')
+const W = Number(opt('w', 1920)), H = Number(opt('h', 1080))
+const HOME = homedir()
+const wait = (ms) => new Promise((r) => setTimeout(r, ms))
+
+async function loadPlaywright() {
+  const cands = []
+  const npx = join(HOME, '.npm/_npx')
+  if (existsSync(npx)) for (const d of readdirSync(npx)) cands.push(join(npx, d, 'node_modules/playwright'), join(npx, d, 'node_modules/playwright-core'))
+  for (const c of cands) if (existsSync(join(c, 'index.mjs'))) return import(pathToFileURL(join(c, 'index.mjs')).href)
+  throw new Error('no playwright')
+}
+function findChromium(chromium) {
+  try { const p = chromium.executablePath(); if (p && existsSync(p)) return p } catch {}
+  const dir = join(HOME, '.cache/ms-playwright')
+  const vs = readdirSync(dir).filter((d) => /^chromium-\d+$/.test(d)).sort((a, b) => Number(b.split('-')[1]) - Number(a.split('-')[1]))
+  for (const v of vs) for (const rel of ['chrome-linux64/chrome', 'chrome-linux/chrome']) { const p = join(dir, v, rel); if (existsSync(p)) return p }
+}
+
+const { chromium } = await loadPlaywright()
+const browser = await chromium.launch({ executablePath: findChromium(chromium), headless: true, args: ['--enable-unsafe-swiftshader'] })
+const ctx = await browser.newContext({ viewport: { width: W, height: H } })
+const page = await ctx.newPage()
+const r = { mode: MODE, base: BASE, qs: QS, viewport: [W, H], shots: [], consoleErrors: [], pageErrors: [], info: [], ev: {} }
+page.on('console', (m) => {
+  const t = m.text()
+  if (m.type() === 'error' || m.type() === 'warning') r.consoleErrors.push(`[${m.type()}] ${t}`)
+  else if (/^\[(kitchen|bomber)\]/.test(t)) r.info.push(t)
+})
+page.on('pageerror', (e) => r.pageErrors.push(String(e)))
+
+const pos = () => page.evaluate(() => window.__BATTLE_POS ?? null)
+const phase = () => page.evaluate(() => window.__BATTLE_PHASE ?? null)
+const huds = () => page.evaluate(() => ({
+  bomber: Boolean(document.querySelector('[data-bomber-hud]')),
+  kitchen: Boolean(document.querySelector('[data-kitchen-hud]')),
+  kitchenText: document.querySelector('[data-kitchen-hud]')?.innerText ?? null,
+}))
+async function shot(label) { const f = `${OUT}-${label}.png`; await page.screenshot({ path: f }); r.shots.push(f); return f }
+async function waitPhase(want, timeout) {
+  const t0 = Date.now()
+  while (Date.now() - t0 < timeout) { if (want.includes(await phase())) return true; await wait(200) }
+  return false
+}
+const tap = async (k, ms = 60) => { await page.keyboard.down(k); await wait(ms); await page.keyboard.up(k) }
+async function goAxis(axis, target, { tol = 0.3, timeout = 30000 } = {}) {
+  const t0 = Date.now()
+  let held = null
+  const release = async () => { if (held) { await page.keyboard.up(held); held = null } }
+  let ok = false
+  while (Date.now() - t0 < timeout) {
+    const q = await pos()
+    if (!q) { await wait(50); continue }
+    const d = target - q[axis]
+    if (Math.abs(d) <= tol) { ok = true; break }
+    const k = axis === 'x' ? (d > 0 ? 'd' : 'a') : (d > 0 ? 'w' : 's')
+    if (Math.abs(d) < 1) { await release(); await tap(k, 35); await wait(90); continue }
+    if (held !== k) { await release(); await page.keyboard.down(k); held = k }
+    await wait(30)
+  }
+  await release()
+  return ok
+}
+const goTo = async (x, z) => (await goAxis('x', x)) && (await goAxis('z', z))
+const cw = (c, n) => (c - (n - 1) / 2) * 2
+
+async function startSolo(game) {
+  const url = `${BASE}${QS ? `?${QS}` : ''}#/battle`
+  await page.goto(url, { waitUntil: 'load' })
+  await page.click(`[data-testid="battle-game-card-${game}"]`)
+  await page.click('[data-testid="battle-solo-btn"]')
+  await page.waitForSelector('[data-testid="battle-canvas"]', { timeout: 30000 })
+  r.ev.countdown = await waitPhase(['countdown', 'playing'], 30000)
+}
+
+try {
+  if (MODE === 'bomber') {
+    await startSolo('bomber')
+    await wait(800); await shot('1-countdown')
+    r.ev.playing = await waitPhase(['playing'], 40000)
+    await wait(1500); r.ev.hudPlaying = await huds(); await shot('2-playing')
+    await wait(4500); r.ev.hudMid = await huds(); await shot('3-mid')
+  } else if (MODE === 'ac2') {
+    await startSolo('overcooked')
+    r.ev.playing = await waitPhase(['playing'], 40000)
+    await wait(1000); r.ev.hud0 = await huds(); await shot('1-playing')
+    const cook = async (tag, crateCx, boardCy, potCy) => {
+      const log = { tag, t: [] }
+      const t0 = Date.now()
+      const mark = (s) => log.t.push([s, Math.round((Date.now() - t0) / 100) / 10])
+      await goTo(cw(crateCx, 11), cw(1, 7)); await tap('e'); mark('crate')
+      await goTo(cw(1, 11), cw(boardCy, 7)); await tap('e'); mark('board-put')
+      await wait(1800); await tap('e'); mark('board-take')
+      await goTo(cw(9, 11), cw(potCy, 7)); await tap('e'); mark('pot-put')
+      await wait(3000 + 800) // COOK_MS 後 0.8s：soup 且快焦窗口（busyUntil 未到）
+      await tap('e'); mark('pot-take-soup')
+      log.hudAfterTake = await huds()
+      await shot(`2-${tag}-after-take`)
+      log.posAfterTake = await pos()
+      await goTo(cw(8, 11), cw(1, 7)); mark('at-serve')
+      for (let i = 0; i < 30; i++) {
+        await tap('e'); await wait(1000)
+        const q = await pos()
+        if (q?.score > 0) { log.score = q.score; mark('served'); break }
+      }
+      log.hudEnd = await huds()
+      await shot(`3-${tag}-end`)
+      return log
+    }
+    r.ev.veg = await cook('veg', 2, 2, 2)
+    if (!(r.ev.veg.score > 0)) r.ev.meat = await cook('meat', 4, 4, 4)
+    r.ev.pass = (r.ev.veg.score ?? r.ev.meat?.score ?? 0) > 0
+  } else throw new Error(`unknown mode ${MODE}`)
+} catch (e) {
+  r.error = String(e)
+  await shot('error').catch(() => {})
+}
+await browser.close()
+console.log(JSON.stringify(r, null, 2))
