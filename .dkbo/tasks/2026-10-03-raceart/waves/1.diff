+  })
+
+  it('撿到後未滿 itemDelayMs 不用；沒道具永遠 false', () => {
+    expect(use({ item: 'mushroom', mind: calm({ itemDelayMs: 1000, heldMs: 500 }) }, 10)).toBe(false)
+    expect(use({ item: null }, 10)).toBe(false)
