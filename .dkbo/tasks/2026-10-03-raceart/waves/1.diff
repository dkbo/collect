+import { describe, it, expect } from 'vitest'
+import {
+  BOOST_SPEED,
+  DRIFT_TIERS,
+  MAX_REVERSE,
+  MAX_SPEED,
+  MINI_TURBO_MS,
+  OFFTRACK_FACTOR,
+  OFFTRACK_RESPAWN_MS,
+  RESPAWN_GHOST_MS,
+  SLIP_BOOST_MS,
+  SLIP_CHARGE_MS,
+  SLIP_SPEED_MULT,
+  STUCK_MS,
+  JUMP_G,
+  JUMP_H,
+  JUMP_MIN_SPEED,
+  RAMP_HALF_W,
+  jumpY,
+  launchVy,
+  rampY,
