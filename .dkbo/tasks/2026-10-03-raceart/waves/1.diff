+  it('打滑中按甩尾不蓄力', () => {
+    let r: RacerState = { ...at(makeRacer(course, 0), 2, 12), spinMs: 800 }
+    for (let i = 0; i < 20; i++) r = tick(r, { throttle: 1, steer: 1, drifting: true }).state
