+    expect(DRIFT_COLORS).toEqual(['#FFFFFF', '#39C2FF', '#FF9A1F', '#C05CFF'])
+  })
+
+  it('4 種道具都有主色／暗階／點綴，道具箱 4 種面色', () => {
+    for (const k of ITEM_KINDS) {
