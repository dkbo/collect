   g.clearRect(0, 0, S, S)
   const gr = g.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2)
   gr.addColorStop(0, 'rgba(43,36,64,0.42)')
   gr.addColorStop(0.6, 'rgba(43,36,64,0.28)')
   gr.addColorStop(1, 'rgba(43,36,64,0)')
