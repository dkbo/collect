+      expect(k.indexOf(Math.max(...k))).toBe(b.indexOf(Math.max(...b)))
+    }
+    expect(sparkHot('#FFFFFF')).toBe('#FFFFFF')
+  })
+
+  it('火花基準尺寸放大到 0.45 以上（fx_spark 只有約 11% 面積不透明，ADD 混色在深色路面上才看得到）', () => {
+    expect(SPARK_SIZE).toBeGreaterThanOrEqual(0.45)
+  })
+})
