+
+  it('加速中開到路面外：上限仍乘 OFFTRACK_FACTOR（不能靠加速全速切內野）', () => {
+    expect(drive({ ...mods, boosting: true, onTrack: false }, 2).speed).toBeCloseTo(BOOST_SPEED * OFFTRACK_FACTOR, 6)
