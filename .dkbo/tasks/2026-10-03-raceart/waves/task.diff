+  it('長彎內按住甩尾，彎前、出口前 6 以後、skipDrift 都不甩', () => {
+    const t1 = LONG_CORNERS[0]
+    expect(decideRaceBot(input(t1.s0, {}, 0, 15)).drift).toBe(true)
