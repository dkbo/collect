+    @apply h-[32px];
+  }
+  .race-results-badge {
+    @apply size-6 text-[14px];
+  }
+}
+
+/* 觸控大螢幕（平板橫向，高度 > 500）：底部讓給搖桿與四顆觸控鈕，小地圖移到左上群下方、名次移到右上全螢幕鈕左邊 */
