+  }
+  .race-rank {
+    @apply bottom-auto right-[calc(max(12px,env(safe-area-inset-right))_+_2.25rem_+_8px)] top-[max(8px,env(safe-area-inset-top))] origin-top-right;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .race-wrongway,
+  .race-rank-num,
+  .race-item-rolling,
+  .race-item-icon,
+  .race-finallap-ribbon,
+  .race-finallap-text {
+    @apply animate-none;
+  }
+}
