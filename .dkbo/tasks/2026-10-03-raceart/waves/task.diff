+
+describe('stepCar — 基準運動學', () => {
+  const car: CarPhys = { x: 0, z: 0, ry: 0, speed: 0 }
+  const mods = { onTrack: true, boosting: false, slipping: false, spinning: false }
+  const drive = (m = mods, secs = 5, throttle = 1) => {
