+
+export const RACE = {
+  sky: '#9ED8F5',
+  /** 實際填進 clearColor／fogColor 的天色：ACES＋對比會把 #9ED8F5 壓成灰藍 (188,202,208)，這個值渲染後約 (149,192,206) */
+  skyClear: '#4FB4EE',
