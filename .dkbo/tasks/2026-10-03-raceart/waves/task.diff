+
+describe('stepBotMind — 失誤與道具計時（全由 seed 決定）', () => {
+  it('同 seed 同輸入 → 同結果', () => {
+    let a = makeBotMind(7)
+    let b = makeBotMind(7)
+    for (let i = 0; i < 300; i++) {
