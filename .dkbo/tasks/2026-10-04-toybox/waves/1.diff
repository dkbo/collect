+}
+
+@layer components {
+  /* ── 版面容器：左右邊距與內容寬只透過它 ── */
+  .tb-container {
+    @apply mx-auto w-full max-w-site px-6 max-sm:px-4;
+  }
+
+  /* ── 共用互動狀態（01-foundations §6）：每個可點物件只掛其中一組 ── */
+  .tb-focus {
+    @apply focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-focus;
+  }
+  .tb-lift {
+    @apply cursor-pointer transition-[translate,box-shadow] duration-120 ease-out
+      hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-hard-l
+      active:translate-x-[5px] active:translate-y-[5px] active:shadow-none
+      focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-focus
+      disabled:translate-none disabled:cursor-not-allowed disabled:border-ink-muted disabled:bg-surface-sunken disabled:text-ink-muted disabled:shadow-none
+      aria-disabled:translate-none aria-disabled:cursor-not-allowed aria-disabled:border-ink-muted aria-disabled:bg-surface-sunken aria-disabled:text-ink-muted aria-disabled:shadow-none
+      motion-reduce:transition-none;
+  }
+  .tb-lift-s {
+    @apply cursor-pointer transition-[translate,box-shadow] duration-120 ease-out
+      hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-hard-m
+      active:translate-x-[3px] active:translate-y-[3px] active:shadow-none
+      focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-focus
+      disabled:translate-none disabled:cursor-not-allowed disabled:border-ink-muted disabled:bg-surface-sunken disabled:text-ink-muted disabled:shadow-none
+      aria-disabled:translate-none aria-disabled:cursor-not-allowed aria-disabled:border-ink-muted aria-disabled:bg-surface-sunken aria-disabled:text-ink-muted aria-disabled:shadow-none
+      motion-reduce:transition-none;
+  }
+
+  /* ── 傾斜（tilt-1／2／3／band） ── */
+  .tb-tilt-1 { @apply -rotate-3; }
+  .tb-tilt-2 { @apply rotate-3; }
+  .tb-tilt-3 { @apply -rotate-7; }
+  .tb-tilt-band { @apply -rotate-1; }
+
+  /* ── Button ── */
+  .tb-btn {
+    @apply inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-toy-md border-3 border-line
+      bg-surface-raised font-display text-button text-ink no-underline shadow-hard-m select-none
+      [&_svg]:size-5 [&_svg]:shrink-0;
+  }
+  .tb-btn--l { @apply h-13 px-6; }
+  .tb-btn--s { @apply h-11 px-4 text-button-s shadow-hard-s; }
+  .tb-btn--secondary { @apply bg-surface-raised text-ink; }
+  .tb-btn--primary { @apply bg-action text-on-fill; }
+  .tb-btn--pop { @apply bg-pop text-on-fill; }
+  .tb-btn--ink { @apply bg-inverse text-pop; }
+  /* 反白區內的按鈕：框與底同色、陰影改 on-inverse */
+  .tb-on-inverse .tb-btn { @apply border-inverse shadow-on-inverse; }
+
+  /* ── IconButton ── */
+  .tb-iconbtn {
+    @apply inline-flex size-11 shrink-0 items-center justify-center rounded-toy-md border-3 border-line
+      bg-surface-raised p-0 text-ink shadow-hard-s [&_svg]:size-5 [&_svg]:shrink-0;
+  }
+
+  /* ── NavLink ── */
+  .tb-nav {
+    @apply inline-flex h-11 items-center gap-1 whitespace-nowrap rounded-toy-pill border-3 border-transparent px-4
+      font-body text-label text-ink no-underline transition-colors duration-120 ease-out
+      not-aria-[current=page]:hover:bg-surface-sunken
