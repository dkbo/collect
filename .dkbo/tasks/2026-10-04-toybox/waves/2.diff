+@reference "../../index.css";
+
+/* ═══════════════════════════════════════════════════════
+   SEARCH PAGE（pages-spec §9）
+   ═══════════════════════════════════════════════════════ */
+@layer components {
+  .search-page {
+    @apply flex flex-col gap-8 pt-12 pb-18 text-left max-sm:pt-8 max-sm:pb-12;
+  }
+  .search-lead {
+    @apply m-0 max-w-2xl font-body text-body text-ink-muted;
+  }
+
+  /* 搜尋框 */
+  .search-box {
+    @apply w-full max-w-2xl;
+  }
+  .search-field {
+    @apply relative;
+  }
+  .search-field__icon {
+    @apply pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-ink;
+  }
+  .search-field .search-input {
+    @apply h-13 pr-15 pl-12 text-body-l;
+  }
+  /* 垂直置中用 inset-y-0＋my-auto：tb-lift-s 的 hover 會改 translate，不能拿 translate 置中 */
