new file mode 100644
index 0000000..1400ef8
--- /dev/null
+++ b/src/pages/MiniGame/MiniGame.css
@@ -0,0 +1,34 @@
+@reference "../../index.css";
+
+/* ═══════════════════════════════════════════════════════
+   MINI GAME（pages-spec §12）— 前綴 mini-
+   ═══════════════════════════════════════════════════════ */
+/* 包在 components layer：className 上的 utility 一律蓋得過頁面 class；要蓋 toybox 元件 class 的規則用複合選擇器提高權重 */
+@layer components {
+  /* 頁面骨架（§0）：上下留白；遊戲欄寬 896 置中 */
+  .mini-page {
+    @apply text-left pt-12 pb-18 max-sm:pt-8 max-sm:pb-12;
+  }
+
+  .mini-col {
+    @apply mx-auto flex w-full max-w-4xl flex-col gap-6;
+  }
+
+  /* 計分列：三個 StatTile 橫排，數字手機縮成 pixel-l */
+  .mini-stats {
+    @apply grid grid-cols-3 gap-3 select-none;
+  }
+
+  .mini-stats .tb-stat__num {
+    @apply max-sm:text-pixel-l;
+  }
+
+  /* 畫面區：16:9，全螢幕時自己 fixed 撐滿 */
+  .mini-screen__view {
+    @apply flex aspect-video w-full items-center justify-center;
+  }
+
+  .mini-screen__view--full.tb-screen__view {
+    @apply fixed inset-0 z-50 flex h-screen w-screen items-center justify-center rounded-none select-none;
+  }
+}
