+@reference "../../index.css";
+
+/* ═══════════════════════════════════════════════════════
+   RPG ROOM（pages-spec §14）— 前綴 rpg-
+   ═══════════════════════════════════════════════════════ */
+/* 包在 components layer：className 上的 utility 一律蓋得過頁面 class；要蓋 toybox 元件 class 的規則用複合選擇器提高權重 */
+@layer components {
+  /* 頁面骨架（§0）：上下留白；遊戲欄寬 896 置中 */
+  .rpg-page {
+    @apply text-left pt-12 pb-18 max-sm:pt-8 max-sm:pb-12;
+  }
+
+  .rpg-col {
+    @apply mx-auto flex w-full max-w-4xl flex-col gap-6;
+  }
+
+  /* 畫面區：高度沿用舊 rpg-screen 的 450／550 */
+  .rpg-screen-view {
+    @apply h-[450px] w-full select-none md:h-[550px];
+  }
+
+  /* 全螢幕：畫面區自己 fixed 撐滿 */
+  .rpg-screen-view--full.tb-screen__view {
+    @apply fixed inset-0 z-50 flex h-screen w-screen items-center justify-center rounded-none select-none;
+  }
+
+  /* 三層 canvas 堆疊（定位數值同舊 rpg-canvas） */
+  .rpg-layer {
+    @apply absolute inset-0 block h-full w-full;
+    image-rendering: pixelated;
+    image-rendering: crisp-edges;
+  }
+
+  /* 行動裝置拖曳虛擬搖桿（§3.6；顯示於觸碰點，pointer-events-none 不攔截觸控） */
+  .rpg-joy {
+    @apply pointer-events-none absolute z-30 -mt-14 -ml-14 size-28 rounded-full border-3 border-on-inverse bg-inverse/40 select-none;
+  }
+
+  .rpg-knob {
+    @apply pointer-events-none absolute z-30 -mt-6 -ml-6 size-12 rounded-full border-3 border-on-fill bg-pop select-none;
+  }
+
