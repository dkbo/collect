@@ -0,0 +1,153 @@
+@reference "../../index.css";
+
+/* ═══════════════════════════════════════════════════════
+   RESUME PAGE（pages-spec §7）
+   ═══════════════════════════════════════════════════════ */
+@layer components {
+  .resume-page {
+    @apply flex flex-col gap-8 pt-12 pb-18 text-left max-sm:pt-8 max-sm:pb-12;
+  }
+  .resume-lead {
+    @apply m-0 max-w-2xl font-body text-body text-ink-muted;
+  }
+  .resume-columns {
+    @apply columns-1 gap-6 md:columns-2;
+  }
+  .resume-cell {
+    @apply mb-6 w-full break-inside-avoid;
+  }
+
+  /* ── 五張卡共用 ── */
+  .resume-panel {
+    @apply flex flex-col overflow-hidden rounded-toy-lg border-3 border-line bg-surface-raised shadow-hard-m;
+  }
+  .resume-panel__head {
+    @apply flex items-center justify-between gap-3 border-b-3 border-line bg-surface-sunken px-5 py-2 text-ink;
+  }
+  .resume-panel__head--pop {
+    @apply bg-pop text-on-fill;
+  }
+  .resume-panel__title {
+    @apply m-0 font-display text-heading-m text-ink;
+  }
+  .resume-panel__code {
+    @apply font-pixel text-pixel-m text-ink-muted;
+  }
+  .resume-panel__head--pop .resume-panel__title,
+  .resume-panel__head--pop .resume-panel__code {
+    @apply text-on-fill;
+  }
+  .resume-panel__body {
+    @apply flex flex-col gap-6 p-6 max-sm:p-5;
+  }
+
+  /* ── About ── */
+  .resume-profile {
+    @apply flex flex-col items-center gap-6 @xl:flex-row @xl:items-start;
+  }
+  .resume-avatar {
+    @apply size-28 shrink-0 -rotate-3 overflow-hidden rounded-toy-lg border-4 border-line bg-surface-sunken shadow-hard-m md:size-32;
+  }
+  .resume-name {
+    @apply m-0 flex items-center gap-2 font-display text-heading-l whitespace-nowrap text-ink;
+  }
+  .resume-role {
+    @apply m-0 font-pixel text-pixel-m text-ink-muted;
+  }
