+    @apply absolute inset-y-0 right-1.5 my-auto [&_svg]:size-4;
+  }
+
+  /* 推薦 */
+  .search-suggest {
+    @apply mt-3 flex flex-wrap items-center gap-2;
+  }
+  .search-suggest__lead {
+    @apply font-body text-caption text-ink-muted;
+  }
+  /* 單一 class：讓 tb-lift-s 的 hover／active 陰影蓋得過 */
