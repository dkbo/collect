+}
+
+.candy-card-light {
+  @apply flex items-center justify-between gap-3 rounded-xl bg-white px-3 py-2.5 text-left shadow-[0_2px_0_#f3b6d4];
+}
+.candy-kbd {
+  @apply rounded-lg bg-[#e01f78] px-2 py-1 text-right text-xs font-bold text-white;
+}
+
+/* 頁首／工具列／載入畫面（A 亮面經典配色） */
+.candy-title {
+  @apply text-3xl md:text-5xl font-black leading-tight bg-gradient-to-b from-[#ff7cc0] via-[#ff4fa3] to-[#e01f78] bg-clip-text text-transparent drop-shadow-[0_3px_0_#8c0f4a55];
+}
+.candy-subtitle {
+  @apply mt-3 text-sm md:text-base text-[#7a1d52] dark:text-[#d9ccff] max-w-2xl mx-auto leading-relaxed;
+}
+.candy-tool-btn {
+  @apply inline-flex h-8 items-center gap-1 rounded-full border-2 border-[#f3b6d4] bg-white px-3 text-xs font-bold text-[#c2185b] cursor-pointer shadow-[0_3px_0_#e8a7c8] transition-transform hover:bg-[#fff0f7] active:translate-y-[2px] active:shadow-[0_1px_0_#e8a7c8];
+}
+.candy-loading {
+  @apply absolute inset-0 z-50 flex flex-col items-center justify-center gap-4 bg-[radial-gradient(at_50%_40%,#3a1f8c,#12083a_70%)] select-none;
