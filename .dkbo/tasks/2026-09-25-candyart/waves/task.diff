+}
+
+.candy-round-btn {
+  @apply size-[38px] rounded-full border-2 border-white/35 bg-white/15 text-white flex items-center justify-center cursor-pointer transition-colors hover:bg-white/25 [&_svg]:size-[18px];
+}
+
+.candy-btn {
+  @apply inline-flex items-center justify-center gap-1.5 rounded-[22px] border-[3px] border-white px-3 sm:px-[22px] py-2.5 sm:py-3 text-sm sm:text-base font-black text-white cursor-pointer bg-gradient-to-b from-[#7cf08a] to-[#23a83a] shadow-[0_5px_0_#136b25] active:translate-y-[3px] active:shadow-[0_2px_0_#136b25];
+}
+.candy-btn-secondary {
+  @apply inline-flex items-center justify-center gap-1.5 rounded-[22px] border-[3px] border-[#f3b6d4] bg-white px-3 sm:px-[22px] py-2.5 sm:py-3 text-sm sm:text-base font-black text-[#c2185b] cursor-pointer shadow-[0_5px_0_#e8a7c8] active:translate-y-[3px] active:shadow-[0_2px_0_#e8a7c8];
+}
+
+/* 上內距 56px 讓出橫條模式的圓鈕；兩側模式圓鈕在右緣不會壓到卡片，只留 16px */
+.candy-mask {
+  @apply absolute inset-0 z-30 flex flex-col items-center justify-center-safe overflow-y-auto bg-[#12083a]/80 backdrop-blur-[6px] px-4 pb-4 pt-14 [[data-hud=side]_&]:pt-4;
+}
+
+.candy-mask-top {
+  @apply z-40;
+}
+
+.candy-dialog-fit {
+  @apply mt-8 shrink-0 w-full max-w-[420px];
+}
+.candy-dialog {
+  @apply relative w-full origin-top rounded-[30px] border-4 border-white bg-gradient-to-b from-[#fff8fc] to-[#ffe0ef] px-5 sm:px-8 pt-[50px] sm:pt-[62px] pb-5 sm:pb-7 flex flex-col items-center gap-3.5 text-center shadow-[0_16px_40px_#0008];
+}
+.candy-dialog-lose {
+  @apply from-[#f4f0ff] to-[#e4dcff];
+}
+
+.candy-ribbon {
+  @apply absolute -top-7 sm:-top-8 left-1/2 -translate-x-1/2 w-[calc(100%+16px)] sm:w-[calc(100%+40px)] h-[52px] sm:h-[62px] flex items-center justify-center rounded-[20px] border-[3px] border-white bg-gradient-to-b from-[#ff7cc0] to-[#e01f78] shadow-[0_5px_0_#8c0f4a] text-[22px] sm:text-[28px] font-black text-white whitespace-nowrap;
+}
+.candy-ribbon-lose {
+  @apply from-[#8a7cc8] to-[#43357a] shadow-[0_5px_0_#2a2058];
