+}
+.candy-loading-text {
+  @apply text-base font-bold tracking-widest text-[#ffe4f2] animate-pulse;
+}
+
+/* 窄畫面（寬高比 < 4:3）退回上方橫條 */
+.candy-topbar {
+  @apply relative z-20 shrink-0 flex flex-col gap-2 px-3 py-2 bg-gradient-to-b from-[#3a1f8c] to-[#241062] border-b-2 border-white/15 select-none;
+}
+.candy-topbar-btns {
+  @apply h-[38px] items-center gap-1.5;
+}
+.candy-topbar-btns-sm {
+  @apply gap-1 [&_.candy-round-btn]:size-8 [&_svg]:size-4;
+}
+.candy-level-sm {
