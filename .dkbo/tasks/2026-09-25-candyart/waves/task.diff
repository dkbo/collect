+/* ═══════════════════════════════════════════════════════
+   CANDY CRUSH（方向稿 A · Glossy Classic）
+   ═══════════════════════════════════════════════════════ */
+@font-face {
+  font-family: 'Fredoka';
+  src: url('/fonts/Fredoka-Bold.woff2') format('woff2');
+  font-weight: 700;
+  font-style: normal;
+  font-display: swap;
+}
+
+@keyframes candy-star-pop {
+  0% { transform: scale(0); }
+  70% { transform: scale(1.2); }
+  100% { transform: scale(1); }
+}
+
+@keyframes candy-pulse {
+  0%, 100% { transform: scale(1); }
+  50% { transform: scale(1.06); }
+}
+
+/* 拉丁字與數字用 Fredoka，中文落回站內字型 */
+.candy-num {
+  @apply font-['Fredoka',_var(--font-sans)] font-bold;
+}
+
+/* 兩側 HUD 欄：以 960×540 設計尺寸排版，再由 JS 依畫面等比縮放 */
+.candy-hud-col {
+  @apply absolute top-0 z-20 flex w-[196px] flex-col gap-3 pointer-events-auto select-none;
+}
+
+.candy-level {
+  @apply flex flex-col items-center py-2.5 px-4 rounded-[22px] border-[3px] border-white bg-gradient-to-b from-[#ff7cc0] to-[#e01f78] shadow-[0_5px_0_#8c0f4a,inset_0_4px_4px_#ffffff66];
+}
+.candy-level-label {
+  @apply font-['Fredoka',_var(--font-sans)] font-bold text-[14px] tracking-[3px] text-[#ffe4f2];
+}
+.candy-level-num {
+  @apply font-['Fredoka',_var(--font-sans)] font-bold text-[44px] leading-none text-white [text-shadow:0_3px_0_#a3125e];
+}
+
+.candy-card {
+  @apply rounded-[18px] border-2 border-white/20 bg-white/10 px-3.5 py-3;
+}
+.candy-card-label {
+  @apply text-[13px] font-bold text-[#d9ccff];
+}
+.candy-card-value {
+  @apply font-['Fredoka',_var(--font-sans)] font-bold text-[28px] leading-tight text-white;
+}
+
+.candy-moves {
+  @apply size-[132px] rounded-full border-4 border-white flex flex-col items-center justify-center self-center text-white bg-[radial-gradient(at_38%_30%,#a8ecff,#2aa8ff_45%,#0a3a9e)] shadow-[0_6px_0_#0a2a78,inset_0_-6px_10px_#06246eaa];
+}
+.candy-moves-low {
+  @apply bg-[radial-gradient(at_38%_30%,#ffb3b8,#ff2d46_45%,#9e0019)] shadow-[0_6px_0_#6e0012,inset_0_-6px_10px_#5e0010aa] animate-[candy-pulse_1s_ease-in-out_infinite];
+}
+.candy-moves-num {
