# dkbo 設定。/dkbo-init 會改寫這裡的值；bash 可直接 source，所有值都要加引號。
DK_TEST_CMD=""                  # dk-wave-close 在 worktree 執行的測試指令；空字串表示不跑
DK_REVIEW_KINDS="claude"        # 預設 reviewer kind，依偏好排序，1 至 3 個，空白分隔
DK_REVIEW_MIN="1"               # 至少幾位 reviewer 意見回來才算審查完成
DK_REVIEW_TIMEOUT_MIN="20"      # reviewer 逾時分鐘（dk-watch 用）
DK_TAB1_SLOTS="4"               # tab 1 右側可放的員工格數（4 = 2×2，6 = 3×2）
DK_LEADER_KIND="claude"         # 領導這一側的 AI CLI（claude / codex / agy）；dk-leader 用它的 L 檔
DK_WAVE_TIMEOUT_MIN="60"      # 整波逾時分鐘（dk-watch 用）；0 表示關閉
DK_REVIEW_TIER="L"              # reviewer 的檔位（M 或 L）。審查是全隊最吃推理的位置，而 reviewer 是
                                # --isolated 唯讀、只讀一個 diff pack、單輪，升到 L 的邊際成本遠低於
                                # 一個 dev pane。波審查漏掉的問題要到整枝評議才抓到，就得多開一整個修復波。
                                # 要改就改這裡，不要去動 roles/reviewer.md 的 tier 定義。
DK_REPOS=""                     # 這個專案由哪幾個獨立 git repo 組成：`<名>=<路徑>` 空白分隔，
                                # 路徑相對本專案根，第一個必須是主 repo（`.`，放 .dkbo/ 的那個）。
                                # 名字 [a-z][a-z0-9_]{0,15}。空字串＝單 repo，行為與 0.9.2 相同。
                                # 例：DK_REPOS="app=. api=../sport-backend shared=../sport-shared"
DK_SETUP_CMD=""                 # 主 repo 的 worktree 切好之後跑一次的依賴鉤子（乾淨環境，失敗只警告）。
                                # pnpm 專案建議 "pnpm install --frozen-lockfile --prefer-offline"。
# 每個非主 repo 各自一條（名字接在鍵的後面）：
#   DK_TEST_CMD_<名>="…"        # dk-wave-close gate c 在該 repo 的 worktree 跑的測試指令
#   DK_SETUP_CMD_<名>="…"       # 該 repo 的依賴鉤子
