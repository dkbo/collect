	"messages": [
		{
			"name": "哆拉鈴",
			"text": [
				"歡迎來到 3F！這層是我們的起居樓層～",
				"左邊是書房和客廳，右邊是儲物間和餐廳。",
				"中庭那棵大樹是這棟房子的[[mark:鎮宅之寶]]喔！"
			]
		},
		{
			"name": "哆拉帽",
			"text": [
				"這組沙發是全棟最舒服的位置～",
				"坐在這裡看著中庭的大樹發呆，一個下午就過去了。"
			]
		},
		{
			"name": "哆拉黃",
			"text": [
				"喵～我在等人陪我下棋。",
				"你要先去和[[mark:哆拉鈴]]打個招呼嗎？她就在上面的小房間。"
			]
		},
		{
			"name": "哆拉飯",
			"text": [
				"今天的晚餐是大樹果實燉肉！",
				"食材都收在右上的儲物間，要拿什麼自己來～",
				"吃飽才有力氣冒險，要不要來一碗？"
			]
		},
		{
			"name": "哆拉茶",
			"text": [
				"飯後一杯熱茶，是 3F 的傳統。",
				"聽說走廊的燈一到晚上會自己亮起來……",
				"是[[mark:哆拉巡]]每天準時點的啦！"
			]
		},
		{
			"name": "哆拉巡",
			"text": [
				"我負責巡這條走廊，順便擦樓梯。",
				"下樓請走右邊的樓梯，小心台階！"
			]
		},
		{
			"name": "書架",
			"text": [
				"（整排都是冒險故事和食譜，書頁被翻得又軟又舊。）"
			]
		},
		{
			"name": "盔甲",
			"text": [
				"（一套擦得發亮的騎士盔甲。）",
				"（……剛剛好像動了一下，應該是錯覺吧。）"
			]
		}
	]
}