# Firebase Web App 設定（多人對戰頁 /battle 的控制平面）
# 複製本檔為 .env.local（已被 .gitignore 忽略）並填入你的 Firebase 專案值。
# 取得位置：Firebase Console → 專案設定 → 一般 → 你的應用程式 → SDK 設定與配置。
#
# 注意：這些值會打包進前端，屬「公開」資訊（非機密）；
# 真正的存取控管靠 firestore.rules（須先於 Console 部署 Rules 並啟用 Anonymous 登入）。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 選填：具名 Firestore 資料庫 ID。留空 = 連預設 (default) 資料庫。
# ⚠️ 免費 Spark 方案只涵蓋 (default) 資料庫；具名資料庫需啟用帳單(Blaze)。
# 想免費請保持留空，並在 Console 建立 (default) 資料庫。
VITE_FIREBASE_FIRESTORE_DB=

# 選填：設 1 強制 Firestore 用 long-polling（串流不通的網路/測試環境用；一般留空）。
VITE_FIREBASE_FORCE_LONG_POLLING=
